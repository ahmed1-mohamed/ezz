"use client";

import { ExternalLink, MapPinOff } from "lucide-react";
import { cn } from "@/lib/utils";
import { useLanguage } from "@/contexts/LanguageContext";
import { InteractiveMapPicker } from "@/components/shared/InteractiveMapPicker";
import { buildGoogleMapsUrl, toLatLng } from "@/lib/maps/parse-map-url";

interface LocationMapPreviewProps {
  latitude: unknown;
  longitude: unknown;
  mapLink?: string | null;
  label?: string;
  height?: string;
  className?: string;
}

/** Read-only map for detail pages: pin, coordinates (copyable), full screen and "Open in Google Maps". */
export function LocationMapPreview({
  latitude,
  longitude,
  mapLink,
  label,
  height = "h-56 sm:h-64",
  className,
}: LocationMapPreviewProps) {
  const { t } = useLanguage();
  const point = toLatLng(latitude, longitude);
  const href = mapLink?.trim() || (point ? buildGoogleMapsUrl(point.lat, point.lng) : "");

  return (
    <div className={cn("space-y-3", className)}>
      {point ? (
        <InteractiveMapPicker
          latitude={point.lat}
          longitude={point.lng}
          readOnly
          markerLabel={label}
          height={height}
        />
      ) : (
        <div
          className={cn(
            "flex flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-gray-200 bg-gray-50 text-center dark:border-neutral-800 dark:bg-neutral-900/50",
            href ? "py-6" : height
          )}
        >
          <MapPinOff className="h-6 w-6 text-gray-300 dark:text-neutral-600" />
          <p className="text-xs text-gray-400 dark:text-gray-500">{t("locations.mapPicker.noLocation")}</p>
        </div>
      )}
      {href && (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          className="flex w-full items-center justify-center gap-2 rounded-xl border border-teal-200 py-2.5 text-sm font-medium text-teal-700 transition-colors hover:bg-teal-50 dark:border-teal-900 dark:text-teal-400 dark:hover:bg-teal-950/40"
        >
          <ExternalLink className="h-4 w-4" />
          {t("locations.mapPicker.openInGoogleMaps")}
        </a>
      )}
    </div>
  );
}
