"use client";

import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { Sparkles } from "lucide-react";
import { useLanguage } from "@/contexts/LanguageContext";

interface AdTitleSectionProps {
  register: any;
}

export function AdTitleSection({ register }: AdTitleSectionProps) {
  const { t, language } = useLanguage();
  const isAr = language === "ar";

  return (
    <div className="bg-neutral-50/60 dark:bg-neutral-900/40 rounded-xl p-4 sm:p-5 border border-neutral-200/80 dark:border-neutral-800 space-y-3">
      <div className="flex items-center gap-2 pb-2 border-b border-neutral-200/60 dark:border-neutral-800">
        <Sparkles className="h-4 w-4 text-teal-600 dark:text-teal-400" />
        <h3 className="text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200">
          {t("ads.createStepOne.campaignOverview") || (isAr ? "نظرة عامة على الحملة" : "Campaign Overview")}
        </h3>
      </div>
      <div>
        <Label className="flex items-center justify-between text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">
          <span>
            {t("ads.createStepOne.adTitle") || (isAr ? "عنوان الإعلان" : "Ad Title")}{" "}
            <span className="text-red-500">*</span>
          </span>
          <span className="text-[11px] text-neutral-400 font-normal">
            {t("ads.createStepOne.adTitleHint") || (isAr ? "المعرف الداخلي والعام" : "Internal & public identifier")}
          </span>
        </Label>
        <Input
          placeholder={t("ads.createStepOne.adTitlePlaceholder") || (isAr ? "مثال: فلل فاخرة على شاطئ البحر" : "e.g., Luxury Beachfront Villas")}
          {...register("title", {
            required: t("ads.createStepOne.adTitleRequired") || (isAr ? "عنوان الإعلان مطلوب" : "Ad Title is required"),
            minLength: {
              value: 2,
              message: t("ads.createStepOne.adTitleMinLength") || (isAr ? "يجب ألا يقل العنوان عن حرفين" : "Title must be at least 2 characters"),
            },
          })}
          className="bg-white dark:bg-neutral-900 border-neutral-200 dark:border-neutral-700 h-9 text-xs sm:text-sm focus:border-teal-500/80 focus:ring-1 focus:ring-teal-500/30"
        />
      </div>
    </div>
  );
}
