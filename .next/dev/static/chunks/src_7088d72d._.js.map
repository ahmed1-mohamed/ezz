"use client";

import { useState, useMemo } from "react";
import Link from "next/link";
import { Plus, Search, ChevronDown, FileDown, Loader2, CheckCircle2, XCircle } from "lucide-react";
import { useLanguage } from "@/contexts/LanguageContext";
import { useReadyUnitsList, useReadyUnitReview } from "@/features/ready-market/hooks";
import { READY_UNIT_STATE, type ReadyUnitRow } from "@/features/ready-market/types";
import { ReadyUnitsTable } from "@/features/ready-market/components/ReadyUnitsTable";
import { SellerFilter, type SellerValue } from "@/features/ready-market/components/SellerFilter";
import { FilterSelect } from "@/features/ready-market/components/FilterSelect";
import { Pagination } from "@/components/shared/Pagination";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";
import { useCountriesSelect } from "@/hooks/use-countries-select";
import { useDebounce } from "@/hooks/useDebounce";
import { cn } from "@/lib/utils";

export default function ReadyMarketClientPage() {
  const { t, language } = useLanguage();

  // Pagination & filter states
  const [page, setPage] = useState(1);
  const [perPage, setPerPage] = useState("10");
  const [search, setSearch] = useState("");
  const debouncedSearch = useDebounce(search, 350);

  const [countryId, setCountryId] = useState<string>("");
  const [seller, setSeller] = useState<SellerValue | null>(null);
  const [statusFilter, setStatusFilter] = useState<string>("");
  const [roleFilter, setRoleFilter] = useState<string>("");
  const [listingTypeFilter, setListingTypeFilter] = useState<string>("");
  const [propertyTypeId, setPropertyTypeId] = useState<string>("");
  const [city, setCity] = useState<string>("");
  const [area, setArea] = useState<string>("");

  // Countries
  const { countries, isLoading: isLoadingCountries } = useCountriesSelect();
  const countryOptions = useMemo(
    () =>
      countries.map((c: any) => ({
        value: String(c.country_id),
        label: c.country_name,
      })),
    [countries],
  );

  // Selected rows
  const [selectedIds, setSelectedIds] = useState<number[]>([]);

  // Query params
  const queryParams = useMemo(
    () => ({
      page,
      perPage: Number(perPage) || 10,
      search: debouncedSearch || undefined,
      countryId: countryId || undefined,
      sellerId: seller?.id,
      isActive: statusFilter !== "" ? statusFilter : undefined,
      role: roleFilter || undefined,
      listingType: listingTypeFilter !== "" ? listingTypeFilter : undefined,
      propertyTypeId: propertyTypeId || undefined,
      city: city.trim() || undefined,
      area: area.trim() || undefined,
    }),
    [page, perPage, debouncedSearch, countryId, seller, statusFilter, roleFilter, listingTypeFilter, propertyTypeId, city, area],
  );

  const { data, isLoading, isFetching } = useReadyUnitsList(queryParams);
  const { acceptUnit, rejectUnit, deleteUnit, pendingId } = useReadyUnitReview();

  const rows = data?.rows ?? [];
  const total = data?.total ?? 0;
  const totalPages = Math.ceil(total / (Number(perPage) || 10)) || 1;

  // Handlers
  const handleSelectAll = (checked: boolean) => {
    setSelectedIds(checked ? rows.map((r) => r.id) : []);
  };

  const handleSelectOne = (id: number, checked: boolean) => {
    setSelectedIds((prev) => (checked ? [...prev, id] : prev.filter((i) => i !== id)));
  };

  const handleDelete = (row: ReadyUnitRow) => {
    if (typeof window !== "undefined" && window.confirm(t("readyMarket.messages.deleteConfirm"))) {
      deleteUnit(row.id);
      setSelectedIds((prev) => prev.filter((id) => id !== row.id));
    }
  };

  const handleBulkAccept = async () => {
    for (const id of selectedIds) {
      acceptUnit(id);
    }
    setSelectedIds([]);
  };

  const handleBulkReject = async () => {
    for (const id of selectedIds) {
      rejectUnit(id);
    }
    setSelectedIds([]);
  };

  const handleExportCsv = () => {
    if (rows.length === 0) return;
    const headers = [
      t("readyMarket.columns.unitNumber"),
      t("readyMarket.columns.owner"),
      t("readyMarket.columns.type"),
      t("readyMarket.columns.area"),
      t("readyMarket.columns.floor"),
      t("readyMarket.columns.price"),
      t("readyMarket.columns.views"),
      t("readyMarket.columns.status"),
    ];
    const csvLines = [
      headers.join(","),
      ...rows.map((r) =>
        [
          `"${r.unitNumber}"`,
          `"${r.owner}"`,
          `"${r.type}"`,
          `"${r.size}"`,
          `"${r.floor}"`,
          `"${r.price ?? ""}"`,
          `"${r.views ?? ""}"`,
          `"${r.state === READY_UNIT_STATE.ACCEPTED ? t("readyMarket.status.confirmed") : r.state === READY_UNIT_STATE.REJECTED ? t("readyMarket.status.rejected") : t("readyMarket.status.pending")}"`,
        ].join(","),
      ),
    ];
    const blob = new Blob([csvLines.join("\n")], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.setAttribute("download", `ready-market-${Date.now()}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const statusOptions = [
    { value: String(READY_UNIT_STATE.PENDING), label: t("readyMarket.status.pending") },
    { value: String(READY_UNIT_STATE.ACCEPTED), label: t("readyMarket.status.confirmed") },
    { value: String(READY_UNIT_STATE.REJECTED), label: t("readyMarket.status.rejected") },
  ];

  const roleOptions = [
    { value: "developer", label: language === "ar" ? "مطور" : "Developer" },
    { value: "expert", label: language === "ar" ? "خبير" : "Expert" },
    { value: "user", label: language === "ar" ? "مستخدم" : "User" },
    { value: "owner", label: language === "ar" ? "مالك" : "Owner" },
  ];

  const listingTypeOptions = [
    { value: "rent", label: t("readyMarket.rent") },
    { value: "sale", label: t("readyMarket.sale") },
  ];

  const hasExtraFilters = !!(propertyTypeId || city || area);

  return (
    <div className="p-4 sm:p-6 lg:p-8 space-y-5 max-w-full">
      {/* Header */}
      <div className="flex items-center justify-between gap-4">
        <h1 className="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
          {t("readyMarket.title")}
        </h1>

        <Link
          href="/admin/properties/create?market_type=ready"
          className="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#007b78] hover:bg-[#006967] text-white text-sm font-medium transition-colors shadow-sm"
        >
          <Plus className="h-4 w-4" />
          <span>{t("readyMarket.createNewProperty")}</span>
        </Link>
      </div>

      {/* Main Card with Toolbar & Table */}
      <div className="rounded-xl border border-gray-200/90 dark:border-neutral-800 bg-white dark:bg-neutral-900 shadow-sm overflow-hidden">
        {/* Filter Toolbar */}
        <div className="p-3.5 sm:p-4 border-b border-gray-100 dark:border-neutral-800 flex flex-wrap items-center justify-between gap-3">
          <div className="flex flex-wrap items-center gap-2.5 flex-1 min-w-0">
            {/* Search Input */}
            <div className="relative w-64 max-w-full">
              <Search className="absolute start-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400 pointer-events-none" />
              <Input
                value={search}
                onChange={(e) => {
                  setSearch(e.target.value);
                  setPage(1);
                }}
                placeholder={t("readyMarket.searchPlaceholder")}
                className="ps-9 h-9 text-xs rounded-lg border-gray-200 bg-white text-gray-700 placeholder:text-gray-400 focus-visible:ring-1 focus-visible:ring-[#007b78] dark:bg-neutral-800/50 dark:border-neutral-700 dark:text-gray-200"
              />
            </div>

            {/* Country Filter */}
            <FilterSelect
              label={t("readyMarket.filters.country")}
              allLabel={t("readyMarket.allCountries")}
              value={countryId}
              options={countryOptions}
              onChange={(val) => {
                setCountryId(val);
                setPage(1);
              }}
              isLoading={isLoadingCountries}
            />

            {/* Seller Filter */}
            <SellerFilter
              value={seller}
              onChange={(val) => {
                setSeller(val);
                setPage(1);
              }}
            />

            {/* Status Filter */}
            <FilterSelect
              label={t("readyMarket.filters.status")}
              allLabel={t("readyMarket.allStatuses")}
              value={statusFilter}
              options={statusOptions}
              onChange={(val) => {
                setStatusFilter(val);
                setPage(1);
              }}
            />

            {/* Role Filter */}
            <FilterSelect
              label={t("readyMarket.filters.role")}
              allLabel={t("readyMarket.allRoles")}
              value={roleFilter}
              options={roleOptions}
              onChange={(val) => {
                setRoleFilter(val);
                setPage(1);
              }}
            />

            {/* Rent / Listing Type Filter */}
            <FilterSelect
              label={t("readyMarket.filters.rent")}
              allLabel={t("readyMarket.allListingTypes")}
              value={listingTypeFilter}
              options={listingTypeOptions}
              onChange={(val) => {
                setListingTypeFilter(val);
                setPage(1);
              }}
            />

            {/* All Filters Dropdown */}
            <DropdownMenu>
              <DropdownMenuTrigger asChild>
                <button
                  type="button"
                  className={cn(
                    "inline-flex h-9 items-center gap-1.5 rounded-lg border px-3 text-xs font-normal transition-colors",
                    hasExtraFilters
                      ? "border-[#007b78] bg-teal-50/50 text-[#007b78] dark:border-teal-700 dark:bg-teal-950/40"
                      : "border-gray-200 bg-white text-gray-700 hover:bg-gray-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-gray-200",
                  )}
                >
                  <span>{t("readyMarket.filters.allFilters")}</span>
                  <ChevronDown className="h-3.5 w-3.5 opacity-60" />
                </button>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="start" className="w-64 p-3 space-y-3">
                <div className="space-y-1">
                  <label className="text-[11px] font-medium text-gray-600 dark:text-gray-300">
                    {language === "ar" ? "المدينة" : "City"}
                  </label>
                  <Input
                    value={city}
                    onChange={(e) => {
                      setCity(e.target.value);
                      setPage(1);
                    }}
                    placeholder={language === "ar" ? "أدخل اسم المدينة" : "Filter by city"}
                    className="h-8 text-xs"
                  />
                </div>
                <div className="space-y-1">
                  <label className="text-[11px] font-medium text-gray-600 dark:text-gray-300">
                    {language === "ar" ? "المنطقة" : "Area"}
                  </label>
                  <Input
                    value={area}
                    onChange={(e) => {
                      setArea(e.target.value);
                      setPage(1);
                    }}
                    placeholder={language === "ar" ? "أدخل اسم المنطقة" : "Filter by area"}
                    className="h-8 text-xs"
                  />
                </div>
                {hasExtraFilters && (
                  <Button
                    variant="ghost"
                    size="sm"
                    onClick={() => {
                      setPropertyTypeId("");
                      setCity("");
                      setArea("");
                      setPage(1);
                    }}
                    className="w-full text-xs text-rose-600 hover:text-rose-700 h-7"
                  >
                    {language === "ar" ? "إعادة تعيين الفلاتر" : "Reset Filters"}
                  </Button>
                )}
              </DropdownMenuContent>
            </DropdownMenu>
          </div>

          {/* Export Button */}
          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={handleExportCsv}
              className="inline-flex h-9 items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3.5 text-xs font-normal text-gray-700 transition-colors hover:bg-gray-50 dark:border-neutral-700 dark:bg-neutral-900 dark:text-gray-200"
            >
              <FileDown className="h-4 w-4 text-gray-500" />
              <span>{t("readyMarket.export")}</span>
            </button>
          </div>
        </div>

        {/* Selected rows action banner */}
        {selectedIds.length > 0 && (
          <div className="px-4 py-2 bg-teal-50/60 dark:bg-teal-950/30 border-b border-teal-100 dark:border-teal-900/40 flex items-center justify-between text-xs">
            <span className="text-[#007b78] dark:text-teal-300 font-medium">
              {language === "ar"
                ? `تم تحديد ${selectedIds.length} عنصر`
                : `${selectedIds.length} item(s) selected`}
            </span>
            <div className="flex items-center gap-2">
              <Button
                variant="outline"
                size="sm"
                onClick={handleBulkAccept}
                className="gap-1.5 h-7 text-xs text-emerald-700 border-emerald-200 hover:bg-emerald-50 dark:border-emerald-800"
              >
                <CheckCircle2 className="h-3.5 w-3.5" />
                {t("readyMarket.actions.bulkAccept") || "Accept Selected"}
              </Button>
              <Button
                variant="outline"
                size="sm"
                onClick={handleBulkReject}
                className="gap-1.5 h-7 text-xs text-rose-700 border-rose-200 hover:bg-rose-50 dark:border-rose-800"
              >
                <XCircle className="h-3.5 w-3.5" />
                {t("readyMarket.actions.bulkReject") || "Reject Selected"}
              </Button>
            </div>
          </div>
        )}

        {/* Table Content */}
        {isLoading ? (
          <div className="p-16 flex flex-col items-center justify-center gap-3">
            <Loader2 className="h-8 w-8 animate-spin text-[#007b78]" />
            <p className="text-xs text-gray-500">
              {language === "ar" ? "جاري تحميل الوحدات..." : "Loading ready units..."}
            </p>
          </div>
        ) : (
          <ReadyUnitsTable
            rows={rows}
            selectedIds={selectedIds}
            onSelectAll={handleSelectAll}
            onSelect={handleSelectOne}
            onAccept={acceptUnit}
            onReject={rejectUnit}
            onDelete={handleDelete}
            pendingId={pendingId ?? undefined}
          />
        )}

        {/* Pagination inside card footer */}
        {!isLoading && total > 0 && (
          <div className="p-3.5 border-t border-gray-100 dark:border-neutral-800">
            <Pagination
              page={page}
              totalPages={totalPages}
              perPage={Number(perPage) || 10}
              totalItems={total}
              onPageChange={setPage}
              onPerPageChange={(val) => {
                setPerPage(val);
                setPage(1);
              }}
              isLoading={isFetching}
              currentItemsCount={rows.length}
            />
          </div>
        )}
      </div>
    </div>
  );
}
