"use client";

import { useEffect } from "react";
import { useForm, Controller } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { useMutation, useQueryClient } from "@tanstack/react-query";
import { useEditBuildingData } from "@/hooks/use-edit-building";
import { useSession } from "next-auth/react";
import { Modal } from "@/components/ui/modal";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Loader2, Check } from "lucide-react";
import { buildingSchema, BuildingInputType } from "@/validators/buildingSchema";
import { editBuilding } from "@/data/api-client";
import { toast } from "sonner";
import { AxiosError } from "axios";
import { useRouter } from "next/navigation";
import { useLanguage } from "@/contexts/LanguageContext";

interface EditBuildingModalProps {
  buildingId: number;
  projectId: number;
  isOpen: boolean;
  onClose: () => void;
}

export function EditBuildingModal({
  buildingId,
  projectId,
  isOpen,
  onClose,
}: EditBuildingModalProps) {
  const { t } = useLanguage();
  const queryClient = useQueryClient();
  const { data: session } = useSession();
  const token = session?.user?.accessToken;
  const router = useRouter();

  const constructionStatusOptions = [
    { label: t("buildings.statusOptions.ready") || "Ready", value: "ready" },
    { label: t("buildings.statusOptions.underConstruction") || "Under Construction", value: "under-construction" },
    { label: t("buildings.statusOptions.offPlan") || "Off Plan", value: "off-plan" },
  ];

  const builtTypeOptions = [
    { label: t("buildings.builtTypeOptions.building") || "Building", value: "building" },
    { label: t("buildings.builtTypeOptions.compound") || "Compound", value: "compound" },
  ];

  const buildingTypeOptions = [
    { label: t("buildings.typeOptions.residential") || "Residential", value: "residential" },
    { label: t("buildings.typeOptions.commercial") || "Commercial", value: "commercial" },
    { label: t("buildings.typeOptions.mixedUse") || "Mixed Use", value: "mixed-use" },
  ];

  const {
    register,
    reset,
    handleSubmit,
    setValue,
    watch,
    control,
    formState: { errors },
    setError,
  } = useForm<BuildingInputType>({
    resolver: zodResolver(buildingSchema),
    defaultValues: {
      project_id: projectId,
      building_name: "",
      total_floors: 1,
      total_units: 0,
      construction_status: "",
      completion_date: "",
      description: "",
      building_type: "",
      built_type: "",
      parking_spaces: 0,
    },
  });

  const { buildingData, projects, cities, areas, loading } = useEditBuildingData(buildingId, isOpen);

  useEffect(() => {
    if (buildingData) {
      const actualData = buildingData?.building || buildingData?.data?.building || buildingData?.data || buildingData;
      reset({
        building_name: actualData?.building_name || "",
        construction_status: actualData?.construction_status || "",
        built_type: actualData?.built_type || "",
        building_type: actualData?.building_type || "",
        total_floors: actualData?.total_floors || 1,
        total_units: actualData?.total_units || 0,
        completion_date: actualData?.completion_date || "",
        description: actualData?.description || "",
        parking_spaces: actualData?.parking_spaces || 0,
      });
    }
  }, [buildingData, reset]);

  const mutation = useMutation({
    mutationFn: (updatedData: BuildingInputType) =>
      editBuilding(buildingId, updatedData, token!),
    onSuccess: () => {
      toast.success(t("buildings.updateSuccess") || "Building updated successfully!");
      queryClient.invalidateQueries({ queryKey: ["building", buildingId] });
      queryClient.invalidateQueries({ queryKey: ["projectDetails", String(projectId)] });
      router.refresh();
      handleClose();
    },
    onError: (error) => {
      const axiosError = error as AxiosError<{
        status?: string;
        errors?: Record<string, string[]>;
        message?: string;
      }>;
      const errorList = axiosError?.response?.data?.errors;

      const flatMessages = errorList
        ? Object.values(errorList)
          .map((errObj) => Object.values(errObj))
          .flat()
          .join(", ")
        : "";

      const fallbackMessage =
        axiosError.response?.data?.message ||
        axiosError.message ||
        (t("buildings.updateFailed") || "Failed to update building.");

      setError("root", { message: flatMessages || fallbackMessage });
    },
  });

  const handleFormSubmit = (formData: BuildingInputType) => {
    const submitData = {
      ...formData,
      project_id: projectId,
    };
    mutation.mutate(submitData);
  };

  const handleClose = () => {
    reset({
      project_id: projectId,
      building_name: "",
      total_floors: 1,
      total_units: 0,
      construction_status: "",
      completion_date: "",
      description: "",
      building_type: "",
      built_type: "",
      parking_spaces: 0,
    });
    onClose();
  };

  if (!isOpen) return null;

  if (loading) {
    return (
      <Modal
        isOpen={isOpen}
        onClose={handleClose}
        title={t("buildings.editTitle") || "Edit Building"}
        size="xl"
        showCloseButton={false}
      >
        <div className="flex justify-center py-8">
          <Loader2 className="h-6 w-6 animate-spin text-[#008081]" />
        </div>
      </Modal>
    );
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={handleClose}
      title={t("buildings.editTitle") || "Edit Building"}
      size="xl"
      showCloseButton={false}
      footer={
        <div className="flex gap-3 justify-end w-full">
          <Button
            variant="outline"
            onClick={handleClose}
            disabled={mutation.isPending}
          >
            {t("common.close") || "Close"}
          </Button>
          <Button
            className="bg-[#008081] hover:bg-[#006666] text-white"
            onClick={handleSubmit(handleFormSubmit)}
            disabled={mutation.isPending}
          >
            {mutation.isPending ? (
              <>
                <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                {t("common.saving") || "Saving..."}
              </>
            ) : (
              <>
                <Check className="w-4 h-4 mr-2" />
                {t("common.saveChanges") || "Save Changes"}
              </>
            )}
          </Button>
        </div>
      }
    >
      <form
        onSubmit={handleSubmit(handleFormSubmit)}
        className="space-y-4 overflow-y-auto max-h-[calc(90vh-180px)] pr-2"
      >
        {errors.root && (
          <div className="bg-red-50 border border-red-200 text-red-600 px-4 py-2 rounded-md text-sm">
            {errors.root.message}
          </div>
        )}

        <div>
          <Label>
            {t("buildings.buildingName") || "Building Name"} <span className="text-red-500">*</span>
          </Label>
          <Input
            placeholder={t("buildings.buildingNamePlaceholder") || "e.g. Building A"}
            {...register("building_name")}
            className="mt-1"
          />
          {errors.building_name && (
            <p className="text-red-500 text-sm mt-1">
              {errors.building_name.message}
            </p>
          )}
        </div>

        <div>
          <Label>
            {t("buildings.constructionStatus") || "Construction Status"} <span className="text-red-500">*</span>
          </Label>
          <Controller
            name="construction_status"
            control={control}
            render={({ field }) => (
              <Select
                key={field.value || "empty"}
                value={field.value}
                onValueChange={field.onChange}
              >
                <SelectTrigger>
                  <SelectValue placeholder={t("common.selectStatus") || "Select Status"} />
                </SelectTrigger>
                <SelectContent>
                  {constructionStatusOptions.map((status) => (
                    <SelectItem key={status.value} value={status.value}>
                      {status.label}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            )}
          />
          {errors.construction_status && (
            <p className="text-red-500 text-sm mt-1">
              {errors.construction_status.message}
            </p>
          )}
        </div>

        <div className="grid grid-cols-2 gap-4">
          <div>
            <Label>
              {t("buildings.buildingType") || "Building Type"} <span className="text-red-500">*</span>
            </Label>
            <Controller
              name="building_type"
              control={control}
              render={({ field }) => (
                <Select
                  key={field.value || "empty"}
                  value={field.value}
                  onValueChange={field.onChange}
                >
                  <SelectTrigger>
                    <SelectValue placeholder={t("common.selectType") || "Select Type"} />
                  </SelectTrigger>
                  <SelectContent>
                    {buildingTypeOptions.map((type) => (
                      <SelectItem key={type.value} value={type.value}>
                        {type.label}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              )}
            />
            {errors.building_type && (
              <p className="text-red-500 text-sm mt-1">
                {errors.building_type.message}
              </p>
            )}
          </div>

          <div>
            <Label>
              {t("buildings.builtType") || "Built Type"} <span className="text-red-500">*</span>
            </Label>
            <Controller
              name="built_type"
              control={control}
              render={({ field }) => (
                <Select
                  key={field.value || "empty"}
                  value={field.value}
                  onValueChange={field.onChange}
                >
                  <SelectTrigger>
                    <SelectValue placeholder={t("buildings.selectBuiltType") || "Select Built Type"} />
                  </SelectTrigger>
                  <SelectContent>
                    {builtTypeOptions.map((type) => (
                      <SelectItem key={type.value} value={type.value}>
                        {type.label}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              )}
            />
            {errors.built_type && (
              <p className="text-red-500 text-sm mt-1">
                {errors.built_type.message}
              </p>
            )}
          </div>
        </div>

        <div className="grid grid-cols-2 gap-4">
          <div>
            <Label>
              {t("buildings.totalFloors") || "Total Floors"} <span className="text-red-500">*</span>
            </Label>
            <Input
              type="number"
              {...register("total_floors", { valueAsNumber: true })}
              className="mt-1"
            />
            {errors.total_floors && (
              <p className="text-red-500 text-sm mt-1">
                {errors.total_floors.message}
              </p>
            )}
          </div>

          <div>
            <Label>
              {t("buildings.totalUnits") || "Total Units"} <span className="text-red-500">*</span>
            </Label>
            <Input
              type="number"
              {...register("total_units", { valueAsNumber: true })}
              className="mt-1"
            />
            {errors.total_units && (
              <p className="text-red-500 text-sm mt-1">
                {errors.total_units.message}
              </p>
            )}
          </div>
        </div>

        <div className="grid grid-cols-2 gap-4">
          <div>
            <Label>{t("buildings.parkingSpaces") || "Parking Spaces"}</Label>
            <Input
              type="number"
              {...register("parking_spaces", { valueAsNumber: true })}
              className="mt-1"
            />
          </div>

          <div>
            <Label>
              {t("buildings.completionDate") || "Completion Date"} <span className="text-red-500">*</span>
            </Label>
            <Input
              type="date"
              {...register("completion_date")}
              className="mt-1"
            />
            {errors.completion_date && (
              <p className="text-red-500 text-sm mt-1">
                {errors.completion_date.message}
              </p>
            )}
          </div>
        </div>

        <div>
          <Label>{t("common.shortDescription") || "Description"}</Label>
          <Textarea
            placeholder={t("common.writeDescriptionHere") || "Write description here"}
            {...register("description")}
            className="mt-1 min-h-[80px]"
          />
        </div>
      </form>
    </Modal>
  );
}