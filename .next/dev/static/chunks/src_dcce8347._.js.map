"use client";

import React, { useState } from "react";
import { useRouter, usePathname } from "next/navigation";
import { useForm, Controller } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Switch } from "@/components/ui/switch";
import { RichTextEditor } from "@/components/ui";
import { developerSchema, type FormValues } from "@/validators/developerSchema";
import { useDeveloperActions, DeveloperFormData } from "@/hooks/use-developer-actions";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { useLanguage } from "@/contexts/LanguageContext";
import { ChevronRight, Loader2, Upload } from "lucide-react";
import { toast } from "sonner";

const COUNTRY_OPTIONS = [
  { id: "1", label: "Egypt", labelAr: "مصر", key: "egypt" },
  { id: "3", label: "Oman", labelAr: "سلطنة عمان", key: "oman" },
  { id: "2", label: "UAE", labelAr: "الإمارات العربية المتحدة", key: "uae" },
];

export default function CreateDeveloperPage() {
  const router = useRouter();
  const pathname = usePathname();
  const routePrefix = pathname.startsWith("/developer") ? "/developer" : "/admin";
  const { t, language } = useLanguage();
  const isAr = language === "ar";
  const { createDeveloper, isCreating } = useDeveloperActions();

  const [logoPreview, setLogoPreview] = useState<string>("");
  const [logoFile, setLogoFile] = useState<File | null>(null);

  const {
    register,
    handleSubmit,
    setValue,
    watch,
    control,
    formState: { errors },
  } = useForm<FormValues>({
    resolver: zodResolver(developerSchema),
    defaultValues: {
      name: "",
      email: "",
      phone_number: "",
      website: "",
      description: "",
      status: "active",
      is_top: false,
      country_id: "2",
      slug: "",
      meta_title: "",
      meta_description: "",
    },
  });

  const handleLogoChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      setLogoFile(file);
      const reader = new FileReader();
      reader.onloadend = () => {
        setLogoPreview(reader.result as string);
      };
      reader.readAsDataURL(file);
    }
  };

  const generateSlug = () => {
    const name = watch("name");
    if (!name) {
      toast.error(t("common.enterNameFirst") || "Please enter a developer name first");
      return;
    }
    const slugified = name
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, "")
      .replace(/[\s_-]+/g, "-")
      .replace(/^-+|-+$/g, "");
    setValue("slug", slugified, { shouldValidate: true, shouldDirty: true });
    toast.success(t("common.slugGenerated") || "Slug generated successfully");
  };

  const onSubmit = async (formDataValues: FormValues) => {
    const payload: DeveloperFormData = {
      ...formDataValues,
      logo: logoFile || undefined,
    };

    try {
      await createDeveloper(payload);
      router.push(`${routePrefix}/developers`);
    } catch (err) {
      console.error("Failed to create developer:", err);
    }
  };

  return (
    <div className="min-h-screen bg-[#f8fafc] dark:bg-neutral-950 pb-16">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
        
        {/* Top Header */}
        <div className="space-y-3">
          <button
            onClick={() => router.push(`${routePrefix}/developers`)}
            className="text-sm font-normal text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 flex items-center gap-1 transition-colors"
          >
            <ChevronRight className="h-4 w-4 rotate-180" />
            {t("developers.backToDevelopers") || "Back to Developers"}
          </button>
          
          <h1 className="text-[22px] font-bold text-gray-900 dark:text-gray-100">
            {t("developers.addDeveloper") || "Add New Developer"}
          </h1>
        </div>

        {/* Main Form */}
        <form onSubmit={handleSubmit(onSubmit)} className="space-y-6">
          
          {/* Logo Upload Card */}
          <div className="bg-white dark:bg-neutral-900 rounded-xl border border-gray-200 dark:border-neutral-800 p-6 sm:p-8 shadow-xs">
            <h2 className="text-[16px] font-bold text-gray-900 dark:text-gray-100 mb-4">
              {t("developers.uploadLogo") || "Developer Logo"}
            </h2>
            <div className="flex flex-col sm:flex-row items-start sm:items-center gap-5">
              <div className="w-24 h-24 rounded-xl bg-gray-50 dark:bg-neutral-800 border-2 border-dashed border-gray-300 dark:border-neutral-700 flex items-center justify-center overflow-hidden flex-shrink-0 p-1.5 shadow-2xs">
                {logoPreview ? (
                  <img
                    src={logoPreview}
                    alt="Logo preview"
                    className="w-full h-full object-contain"
                  />
                ) : (
                  <Upload className="h-8 w-8 text-gray-400" />
                )}
              </div>

              <div className="flex-1 space-y-2">
                <div className="flex items-center gap-3">
                  <input
                    type="file"
                    id="create-logo-upload"
                    accept="image/*,image/png,image/jpeg,image/jpg,image/webp,image/avif,image/svg+xml,image/gif"
                    onChange={handleLogoChange}
                    className="sr-only"
                  />
                  <label
                    htmlFor="create-logo-upload"
                    className="inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-neutral-800 border border-gray-300 dark:border-neutral-700 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-neutral-700 cursor-pointer shadow-2xs transition-colors"
                  >
                    <Upload className="h-4 w-4" />
                    {t("common.chooseFiles") || "Choose files"}
                  </label>
                  <span className="text-xs sm:text-sm text-gray-500 dark:text-gray-400 truncate max-w-xs">
                    {logoFile
                      ? logoFile.name
                      : t("common.noFileChosen") || "No file chosen"}
                  </span>
                </div>
                <p className="text-xs text-gray-500 dark:text-gray-400">
                  {t("developers.logoFormatHint") || "SVG, PNG, JPG, WEBP, AVIF or GIF (MAX. 800x400px)."}
                </p>
              </div>
            </div>
          </div>

          {/* Developer Information Card */}
          <div className="bg-white dark:bg-neutral-900 rounded-xl border border-gray-200 dark:border-neutral-800 p-6 sm:p-8 shadow-xs">
            <h2 className="text-[16px] font-bold text-gray-900 dark:text-gray-100 mb-6">
              Developer Information
            </h2>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-5">
              <div>
                <Label htmlFor="dev-name" className="text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-medium mb-1.5 block">
                  Developer Name (Arabic) <span className="text-gray-500">*</span>
                </Label>
                <Input
                  id="dev-name"
                  placeholder="e.g. إعمار العقارية"
                  {...register("name")}
                  className="bg-white dark:bg-neutral-800 border-gray-200 dark:border-neutral-700 text-sm h-10"
                  error={!!errors.name}
                />
                {errors.name && (
                  <p className="text-xs text-red-500 mt-1">{errors.name.message}</p>
                )}
              </div>
              
              <div>
                <Label htmlFor="dev-name-en" className="text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-medium mb-1.5 block">
                  Developer Name (English)
                </Label>
                <Input
                  id="dev-name-en"
                  name="name_en"
                  placeholder="e.g. Emaar Properties"
                  className="bg-white dark:bg-neutral-800 border-gray-200 dark:border-neutral-700 text-sm h-10"
                />
              </div>

              <div>
                <Label htmlFor="dev-country" className="text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-medium mb-1.5 block">
                  {t("developers.country") || (isAr ? "الدولة *" : "Country *")}
                </Label>
                <Controller
                  name="country_id"
                  control={control}
                  render={({ field }) => (
                    <Select
                      value={field.value || "2"}
                      onValueChange={field.onChange}
                    >
                      <SelectTrigger id="dev-country" className="bg-white dark:bg-neutral-800 border-gray-200 dark:border-neutral-700 text-sm h-10">
                        <SelectValue placeholder={t("developers.country") || (isAr ? "اختر الدولة" : "Select Country")} />
                      </SelectTrigger>
                      <SelectContent className="bg-white dark:bg-neutral-900 border-gray-200 dark:border-neutral-800">
                        {COUNTRY_OPTIONS.map((c) => (
                          <SelectItem key={c.id} value={c.id} className="text-xs sm:text-sm cursor-pointer">
                            {t(`common.countries.${c.key}`) || (isAr ? c.labelAr : c.label)}
                          </SelectItem>
                        ))}
                      </SelectContent>
                    </Select>
                  )}
                />
              </div>

              <div>
                <Label htmlFor="dev-email" className="text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-medium mb-1.5 block">
                  Email
                </Label>
                <Input
                  id="dev-email"
                  type="email"
                  placeholder="info@p-adviser.com"
                  {...register("email")}
                  className="bg-white dark:bg-neutral-800 border-gray-200 dark:border-neutral-700 text-sm h-10"
                  error={!!errors.email}
                />
                {errors.email && (
                  <p className="text-xs text-red-500 mt-1">{errors.email.message}</p>
                )}
              </div>

              <div>
                <Label htmlFor="dev-phone" className="text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-medium mb-1.5 block">
                  Phone
                </Label>
                <Input
                  id="dev-phone"
                  type="tel"
                  placeholder="+20 115 4285 418"
                  {...register("phone_number")}
                  className="bg-white dark:bg-neutral-800 border-gray-200 dark:border-neutral-700 text-sm h-10"
                  error={!!errors.phone_number}
                />
                {errors.phone_number && (
                  <p className="text-xs text-red-500 mt-1">{errors.phone_number.message}</p>
                )}
              </div>

              <div>
                <Label htmlFor="dev-website" className="text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-medium mb-1.5 block">
                  Website
                </Label>
                <Input
                  id="dev-website"
                  type="url"
                  placeholder="www.p-adviser.com"
                  {...register("website")}
                  className="bg-white dark:bg-neutral-800 border-gray-200 dark:border-neutral-700 text-sm h-10"
                  error={!!errors.website}
                />
                {errors.website && (
                  <p className="text-xs text-red-500 mt-1">{errors.website.message}</p>
                )}
              </div>
            </div>

            <div className="flex items-center gap-3 mt-6 mb-5">
              <Controller
                name="is_top"
                control={control}
                render={({ field: { value, onChange } }) => (
                  <Switch
                    id="dev-is-top"
                    checked={value || false}
                    onCheckedChange={onChange}
                    className="data-[state=checked]:bg-teal-500"
                  />
                )}
              />
              <Label htmlFor="dev-is-top" className="cursor-pointer font-medium text-sm text-gray-700 dark:text-gray-200">
                Top Developer
              </Label>
            </div>

            <div className="pt-2">
              <Label className="text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-medium mb-1.5 block">
                Short Description
              </Label>
              <RichTextEditor
                content={watch("description") || ""}
                onChange={(value: string) => setValue("description", value, { shouldValidate: true, shouldDirty: true })}
                placeholder="About the developer"
              />
              {errors.description && (
                <p className="text-xs text-red-500 mt-1">{errors.description.message}</p>
              )}
            </div>
          </div>

          {/* Search Engine Optimization (SEO) Card */}
          <div className="bg-[#f8fafc] dark:bg-neutral-900/60 rounded-xl border border-gray-200 dark:border-neutral-800 p-6 sm:p-8 shadow-xs">
            <h2 className="text-[16px] font-bold text-gray-900 dark:text-gray-100 mb-6">
              Search Engine Optimization (SEO)
            </h2>
            
            <div className="space-y-5">
              <div>
                <Label className="text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-medium mb-1.5 block">
                  Slug
                </Label>
                <div className="flex items-center gap-3">
                  <div className="relative flex-1 flex items-center">
                    <span className="absolute left-4 text-gray-400 text-sm">/</span>
                    <Input
                      {...register("slug")}
                      placeholder="my-property"
                      className="pl-8 bg-white dark:bg-neutral-800 border-gray-200 dark:border-neutral-700 text-sm h-10"
                    />
                  </div>
                  <Button
                    type="button"
                    variant="outline"
                    onClick={generateSlug}
                    className="border-teal-600 text-teal-700 hover:bg-teal-50 bg-teal-50/40 font-medium px-5 h-10 rounded-lg shadow-2xs"
                  >
                    Generate
                  </Button>
                </div>
                <p className="text-xs text-gray-400 mt-1.5">Auto-generated from the name; you can edit it.</p>
              </div>

              <div>
                <Label className="text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-medium mb-1.5 block">
                  Meta Title
                </Label>
                <Input
                  {...register("meta_title")}
                  placeholder="Page title for search engines"
                  className="bg-white dark:bg-neutral-800 border-gray-200 dark:border-neutral-700 text-sm h-10"
                />
              </div>

              <div>
                <Label className="text-gray-600 dark:text-gray-300 text-xs sm:text-sm font-medium mb-1.5 block">
                  Meta Description
                </Label>
                <textarea
                  {...register("meta_description")}
                  rows={4}
                  className="w-full rounded-lg border border-gray-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition-all"
                />
                <p className="text-xs text-gray-400 mt-1 text-right">Short description shown in search results</p>
              </div>
            </div>
          </div>

          {/* Bottom Action Buttons (Left-aligned) */}
          <div className="flex items-center justify-start gap-3 pt-2">
            <Button
              type="submit"
              disabled={isCreating}
              className="bg-[#006262] hover:bg-[#004d4d] text-white text-sm font-medium px-6 py-2.5 h-10 rounded-lg shadow-2xs"
            >
              {isCreating ? (
                <>
                  <Loader2 className="h-4 w-4 animate-spin mr-2" />
                  Saving...
                </>
              ) : (
                "Save Developer"
              )}
            </Button>

            <Button
              type="button"
              variant="outline"
              onClick={() => router.push(`${routePrefix}/developers`)}
              disabled={isCreating}
              className="bg-white dark:bg-neutral-800 border-gray-200 dark:border-neutral-700 hover:bg-gray-50 text-gray-700 dark:text-gray-200 text-sm font-medium px-6 py-2.5 h-10 rounded-lg shadow-2xs"
            >
              {t("common.cancel") || "Cancel"}
            </Button>
          </div>
        </form>
      </div>
    </div>
  );
}
