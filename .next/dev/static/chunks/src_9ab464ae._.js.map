"use client";

import { useEffect, useRef } from "react";
import Pusher from "pusher-js";
import { QueryClient } from "@tanstack/react-query";
import {
  SupportMessage,
  markSupportConversationAsRead,
} from "@/data/api/services/chat.service";
import { recordConversationAsRead } from "../utils/chatReadPersistence";
import axios from "axios";
import { getCountryId, BASE_URL, API_BASE_URL } from "@/data/config";

interface UseChatRealtimeParams {
  token?: string;
  currentUserId?: string | number;
  isAdmin: boolean;
  selectedConversationId: string | number | null;
  queryClient: QueryClient;
  onNewMessage?: (msg: SupportMessage) => void;
}

let globalPusher: Pusher | null = null;
let globalToken: string | null = null;

let cachedAuthEndpoint: string | null = null;
let isBroadcastingAuthUnavailable = false;
let lastAuthFailTime = 0;
const AUTH_FAIL_COOLDOWN_MS = 5 * 60 * 1000;

const CHAT_EVENTS = [
  "support.message.sent",
  ".support.message.sent",
  "SupportMessageSent",
  ".SupportMessageSent",
  "App\\Events\\SupportMessageSent",
  "message.sent",
  ".message.sent",
  "MessageSent",
  ".MessageSent",
  "support.conversation.read",
  ".support.conversation.read",
  "SupportConversationRead",
  ".SupportConversationRead",
  "conversation.read",
  ".conversation.read",
  "support.message.read",
  ".support.message.read",
];

// The open conversation is subscribed on both the global chat channel and its own
// conversation channel, so the same message event can arrive twice. Remember recently
// handled message ids so a re-delivery doesn't repeat the toast, sound and mark-as-read request.
const MAX_HANDLED_MESSAGE_KEYS = 500;
const handledMessageKeys = new Set<string>();

function isDuplicateMessageEvent(msg: SupportMessage): boolean {
  const msgId = msg.id ?? msg.message_id;
  if (msgId === undefined || msgId === null) return false;
  const key = `${msg.conversation_id}:${msgId}`;
  if (handledMessageKeys.has(key)) return true;
  handledMessageKeys.add(key);
  if (handledMessageKeys.size > MAX_HANDLED_MESSAGE_KEYS) {
    const oldest = handledMessageKeys.values().next().value;
    if (oldest !== undefined) handledMessageKeys.delete(oldest);
  }
  return false;
}

async function authorizePusherChannel(
  params: { socketId: string; channelName: string },
  callback: (error: Error | null, authData: any) => void,
  token: string
) {
  if (isBroadcastingAuthUnavailable) {
    if (Date.now() - lastAuthFailTime < AUTH_FAIL_COOLDOWN_MS) {
      callback(new Error("Broadcasting auth route is not configured on backend"), null);
      return;
    }
    isBroadcastingAuthUnavailable = false;
  }

  const countryId = getCountryId();
  const baseHeaders = {
    Authorization: `Bearer ${token}`,
    Accept: "application/json",
    "Content-Type": "application/json",
    "country-id": countryId,
    "country_id": countryId,
  };

  const payload = {
    socket_id: params.socketId,
    channel_name: params.channelName,
  };

  if (cachedAuthEndpoint) {
    try {
      const response = await axios.post(cachedAuthEndpoint, payload, { headers: baseHeaders });
      const authData = response.data?.data || response.data;
      if (authData && typeof authData === "object" && (authData.auth || authData.signature)) {
        callback(null, authData);
        return;
      }
    } catch {
      cachedAuthEndpoint = null;
    }
  }

  const candidateEndpoints = [
    `${API_BASE_URL}/broadcasting/auth`,
    `${BASE_URL}/broadcasting/auth`,
  ];

  let lastError: any = null;
  for (const endpoint of candidateEndpoints) {
    try {
      const response = await axios.post(endpoint, payload, { headers: baseHeaders });
      const authData = response.data?.data || response.data;
      if (authData && typeof authData === "object" && (authData.auth || authData.signature)) {
        cachedAuthEndpoint = endpoint;
        isBroadcastingAuthUnavailable = false;
        callback(null, authData);
        return;
      }
    } catch (err: any) {
      lastError = err;
      if (err?.response?.status === 404) {
        continue;
      }
      break;
    }
  }

  if (lastError?.response?.status === 404) {
    isBroadcastingAuthUnavailable = true;
    lastAuthFailTime = Date.now();
  }

  callback(new Error(`Failed to authorize channel ${params.channelName}`), null);
}

function getOrCreatePusherInstance(token: string): Pusher | null {
  const pusherKey =
    process.env.NEXT_PUBLIC_PUSHER_KEY ||
    process.env.NEXT_PUBLIC_PUSHER_APP_KEY ||
    process.env.PUSHER_APP_KEY ||
    "1b2cea2ec32b54fa6026";
  if (!pusherKey) return null;

  const cluster =
    process.env.NEXT_PUBLIC_PUSHER_CLUSTER ||
    process.env.NEXT_PUBLIC_PUSHER_APP_CLUSTER ||
    process.env.PUSHER_APP_CLUSTER ||
    "mt1";

  if (
    globalPusher &&
    globalToken === token &&
    globalPusher.connection.state !== "disconnected" &&
    globalPusher.connection.state !== "failed"
  ) {
    return globalPusher;
  }

  if (globalPusher) {
    try { globalPusher.disconnect(); } catch { }
    globalPusher = null;
  }

  try {
    const pusher = new Pusher(pusherKey, {
      cluster,
      channelAuthorization: {
        customHandler: (params, callback) => {
          authorizePusherChannel(params, callback, token);
        },
      },
    });
    globalPusher = pusher;
    globalToken = token;
    return pusher;
  } catch (err) {
    console.error("[Pusher] Failed to initialize:", err);
    return null;
  }
}

export function useChatRealtime({
  token,
  currentUserId,
  isAdmin,
  selectedConversationId,
  queryClient,
  onNewMessage,
}: UseChatRealtimeParams) {
  const pusherRef = useRef<Pusher | null>(null);
  const selectedConversationIdRef = useRef(selectedConversationId);
  const currentUserIdRef = useRef(currentUserId);
  const isAdminRef = useRef(isAdmin);
  const tokenRef = useRef(token);
  const onNewMessageRef = useRef(onNewMessage);
  const queryClientRef = useRef(queryClient);

  useEffect(() => { selectedConversationIdRef.current = selectedConversationId; }, [selectedConversationId]);
  useEffect(() => { currentUserIdRef.current = currentUserId; }, [currentUserId]);
  useEffect(() => { isAdminRef.current = isAdmin; }, [isAdmin]);
  useEffect(() => { tokenRef.current = token; }, [token]);
  useEffect(() => { onNewMessageRef.current = onNewMessage; }, [onNewMessage]);
  useEffect(() => { queryClientRef.current = queryClient; }, [queryClient]);

  const stableHandlerRef = useRef((rawData: any) => {
    const _isAdmin = isAdminRef.current;
    const _token = tokenRef.current;
    const _currentUserId = currentUserIdRef.current;
    const _queryClient = queryClientRef.current;
    const currentSelected = selectedConversationIdRef.current;

    if (!_token) return;

    const msg: SupportMessage | undefined =
      rawData?.message ||
      (rawData?.body !== undefined || rawData?.message_text !== undefined ? rawData : undefined);

    const isReadEvent =
      rawData?.event_type === "read" ||
      rawData?.read === true ||
      rawData?.is_read === true ||
      rawData?.conversation_read === true;

    const readConvId = rawData?.conversation_id ?? rawData?.id ?? (isReadEvent ? currentSelected : null);

    if (isReadEvent && readConvId) {
      recordConversationAsRead(readConvId);
      const readConvIdStr = String(readConvId);
      const now = new Date().toISOString();

      _queryClient.setQueriesData(
        {
          predicate: (query) => {
            const key = query.queryKey;
            return (
              Array.isArray(key) &&
              key[0] === "supportMessages" &&
              String(key[1]) === readConvIdStr
            );
          },
        },
        (old: any) => {
          if (!old) return old;
          const updateMsg = (m: any) => ({
            ...m,
            is_read: true,
            read_at: m.read_at || now,
            is_seen: true,
            read: true,
          });

          if (old.pages && Array.isArray(old.pages)) {
            return {
              ...old,
              pages: old.pages.map((page: any) => ({
                ...page,
                data: Array.isArray(page.data) ? page.data.map(updateMsg) : page.data,
              })),
            };
          }
          return old;
        }
      );

      _queryClient.setQueriesData(
        { queryKey: ["supportConversations"] },
        (old: any) => {
          if (!old) return old;
          const updateConv = (c: any) => {
            const cId = c.id ?? c.conversation_id;
            if (String(cId) === readConvIdStr) {
              return {
                ...c,
                unread_for_user: 0,
                unread_for_admin: 0,
                unread_count: 0,
                unread: 0,
              };
            }
            return c;
          };

          if (old.pages && Array.isArray(old.pages)) {
            return {
              ...old,
              pages: old.pages.map((page: any) => ({
                ...page,
                data: Array.isArray(page.data) ? page.data.map(updateConv) : page.data,
              })),
            };
          }
          return old;
        }
      );
      return;
    }

    if (msg) {
      if (isDuplicateMessageEvent(msg)) return;
      const msgId = msg.id ?? msg.message_id;
      const msgConvId = msg.conversation_id;
      const isCurrentOpen = currentSelected && String(msgConvId) === String(currentSelected);

      if (isCurrentOpen) {
        const formattedMsg = {
          ...msg,
          is_read: true,
          read_at: msg.read_at || new Date().toISOString(),
        };

        recordConversationAsRead(currentSelected, formattedMsg, formattedMsg.created_at);

        _queryClient.setQueriesData(
          {
            predicate: (query) => {
              const key = query.queryKey;
              return (
                Array.isArray(key) &&
                key[0] === "supportMessages" &&
                String(key[1]) === String(currentSelected)
              );
            },
          },
          (old: any) => {
            if (!old?.pages?.length) return old;

            const exists = old.pages.some((page: any) =>
              page.data.some((m: any) => (m.id ?? m.message_id) === msgId)
            );
            if (exists) return old;

            const lastPageIndex = old.pages.length - 1;
            const newPages = [...old.pages];
            newPages[lastPageIndex] = {
              ...newPages[lastPageIndex],
              data: [...newPages[lastPageIndex].data, formattedMsg],
            };
            return { ...old, pages: newPages };
          }
        );

        const isOwn =
          _currentUserId &&
          (Number(msg.sender_id) === Number(_currentUserId) ||
            Number(msg.user_id) === Number(_currentUserId));

        if (!isOwn) {
          markSupportConversationAsRead(currentSelected, _token, _isAdmin).catch(() => { });
        }
      }

      const isOwnMsg =
        _currentUserId &&
        (Number(msg.sender_id) === Number(_currentUserId) ||
          Number(msg.user_id) === Number(_currentUserId));

      if (!isOwnMsg) {
        onNewMessageRef.current?.(msg);
      }

      _queryClient.setQueriesData(
        { queryKey: ["supportConversations"] },
        (old: any) => {
          if (!old) return old;

          const updateConv = (c: any) => {
            const cId = c.id ?? c.conversation_id;
            if (String(cId) !== String(msgConvId)) return c;
            return {
              ...c,
              last_message_at: msg.created_at || new Date().toISOString(),
              last_message: isCurrentOpen
                ? { ...msg, is_read: true, read_at: msg.read_at || new Date().toISOString() }
                : msg,
              unread_for_admin: isCurrentOpen ? 0 : Number(c.unread_for_admin || 0) + (_isAdmin ? 1 : 0),
              unread_for_user: isCurrentOpen ? 0 : Number(c.unread_for_user || 0) + (!_isAdmin ? 1 : 0),
              unread_count: isCurrentOpen ? 0 : Number(c.unread_count || 0) + 1,
            };
          };

          if (old.pages && Array.isArray(old.pages)) {
            let found = false;
            const newPages = old.pages.map((page: any) => ({
              ...page,
              data: page.data.map((c: any) => {
                const updated = updateConv(c);
                if (updated !== c) found = true;
                return updated;
              }),
            }));
            if (!found && rawData?.conversation) {
              newPages[0] = {
                ...newPages[0],
                data: [rawData.conversation, ...(newPages[0]?.data || [])],
              };
            }
            return { ...old, pages: newPages };
          }

          if (old.data && Array.isArray(old.data)) {
            return { ...old, data: old.data.map(updateConv) };
          }

          return old;
        }
      );
    } else if (rawData?.conversation) {
      _queryClient.setQueriesData(
        { queryKey: ["supportConversations"] },
        (old: any) => {
          if (!old?.pages?.length) return old;
          return {
            ...old,
            pages: [
              { ...old.pages[0], data: [rawData.conversation, ...old.pages[0].data] },
              ...old.pages.slice(1),
            ],
          };
        }
      );
    }
  });

  useEffect(() => {
    if (!token) return;

    const pusher = getOrCreatePusherInstance(token);
    if (!pusher) return;
    pusherRef.current = pusher;

    const channelName = isAdmin ? "private-admin.chat" : "private-chat";
    let ch: ReturnType<Pusher["subscribe"]>;
    try {
      ch = pusher.subscribe(channelName);
    } catch (e) {
      console.warn(`[Pusher] Could not subscribe to ${channelName}:`, e);
      return;
    }

    ch.bind("pusher:subscription_error", (err: any) => {
      console.warn(`[Pusher] Subscription error for ${channelName}:`, err);
    });

    const handler = (data: any) => stableHandlerRef.current(data);
    CHAT_EVENTS.forEach((evt) => ch.bind(evt, handler));

    return () => {
      try {
        CHAT_EVENTS.forEach((evt) => ch.unbind(evt, handler));
        pusher.unsubscribe(channelName);
      } catch { }
    };
  }, [token, isAdmin]);

  useEffect(() => {
    if (!selectedConversationId || !token) return;

    const pusher = pusherRef.current ?? getOrCreatePusherInstance(token);
    if (!pusher) return;
    pusherRef.current = pusher;

    const channelNames = [
      `private-chat.conversation.${selectedConversationId}`,
    ];

    const handler = (data: any) => stableHandlerRef.current(data);
    const channels: ReturnType<Pusher["subscribe"]>[] = [];

    channelNames.forEach((chName) => {
      try {
        const ch = pusher.subscribe(chName);
        ch.bind("pusher:subscription_error", (err: any) => {
          console.warn(`[Pusher] Auth failed for ${chName}:`, err);
        });
        CHAT_EVENTS.forEach((evt) => ch.bind(evt, handler));
        channels.push(ch);
      } catch (e) {
        console.warn(`[Pusher] Could not subscribe to ${chName}:`, e);
      }
    });

    return () => {
      channels.forEach((ch) => {
        try {
          CHAT_EVENTS.forEach((evt) => ch.unbind(evt, handler));
          pusher.unsubscribe(ch.name);
        } catch { }
      });
    };
  }, [selectedConversationId, token]);

  // Declared last so it cleans up after the channel effects above: close the realtime
  // connection when the chat page unmounts (it is reopened on the next visit).
  useEffect(() => {
    return () => {
      if (globalPusher) {
        try { globalPusher.disconnect(); } catch { }
        globalPusher = null;
        globalToken = null;
      }
      pusherRef.current = null;
    };
  }, []);
}