"use client";

import { useState, useMemo } from "react";
import { Store, Search, RotateCw, CheckCircle2, XCircle, Loader2 } from "lucide-react";
import { useLanguage } from "@/contexts/LanguageContext";
import { useReadyUnitsList, useReadyUnitReview } from "@/features/ready-market/hooks";
import { READY_UNIT_STATE, type ReadyUnitRow } from "@/features/ready-market/types";
import { ReadyUnitsTable } from "@/features/ready-market/components/ReadyUnitsTable";
import { SellerFilter, type SellerValue } from "@/features/ready-market/components/SellerFilter";
import { FilterSelect } from "@/features/ready-market/components/FilterSelect";
import { Pagination } from "@/components/shared/Pagination";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { useDebounce } from "@/hooks/useDebounce";

export default function ReadyMarketClientPage() {
  const { t, language } = useLanguage();

  // Filter & pagination states
  const [page, setPage] = useState(1);
  const [perPage, setPerPage] = useState("10");
  const [search, setSearch] = useState("");
  const debouncedSearch = useDebounce(search, 400);

  const [statusFilter, setStatusFilter] = useState<string>("");
  const [listingTypeFilter, setListingTypeFilter] = useState<string>("");
  const [seller, setSeller] = useState<SellerValue | null>(null);

  // Row selection
  const [selectedIds, setSelectedIds] = useState<number[]>([]);

  // List query
  const queryParams = useMemo(
    () => ({
      page,
      perPage: Number(perPage) || 10,
      search: debouncedSearch || undefined,
      isActive: statusFilter !== "" ? statusFilter : undefined,
      listingType: listingTypeFilter !== "" ? listingTypeFilter : undefined,
      sellerId: seller?.id,
    }),
    [page, perPage, debouncedSearch, statusFilter, listingTypeFilter, seller],
  );

  const { data, isLoading, isFetching, refetch } = useReadyUnitsList(queryParams);
  const { acceptUnit, rejectUnit, deleteUnit, pendingId } = useReadyUnitReview();

  const rows = data?.rows ?? [];
  const total = data?.total ?? 0;
  const totalPages = Math.ceil(total / (Number(perPage) || 10)) || 1;

  // Handlers
  const handleSelectAll = (checked: boolean) => {
    setSelectedIds(checked ? rows.map((r) => r.id) : []);
  };

  const handleSelectOne = (id: number, checked: boolean) => {
    setSelectedIds((prev) => (checked ? [...prev, id] : prev.filter((i) => i !== id)));
  };

  const handleDelete = (row: ReadyUnitRow) => {
    if (typeof window !== "undefined" && window.confirm(t("readyMarket.messages.deleteConfirm"))) {
      deleteUnit(row.id);
      setSelectedIds((prev) => prev.filter((id) => id !== row.id));
    }
  };

  const handleBulkAccept = async () => {
    for (const id of selectedIds) {
      acceptUnit(id);
    }
    setSelectedIds([]);
  };

  const handleBulkReject = async () => {
    for (const id of selectedIds) {
      rejectUnit(id);
    }
    setSelectedIds([]);
  };

  const statusOptions = [
    { value: String(READY_UNIT_STATE.PENDING), label: t("readyMarket.status.pending") },
    { value: String(READY_UNIT_STATE.ACCEPTED), label: t("readyMarket.status.confirmed") },
    { value: String(READY_UNIT_STATE.REJECTED), label: t("readyMarket.status.rejected") },
  ];

  const listingTypeOptions = [
    { value: "sale", label: t("readyMarket.sale") },
    { value: "rent", label: t("readyMarket.rent") },
  ];

  return (
    <div className="p-4 sm:p-6 lg:p-8 space-y-6 max-w-full">
      {/* Header */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div className="space-y-1">
          <div className="flex items-center gap-2.5">
            <div className="h-10 w-10 rounded-xl bg-teal-50 dark:bg-teal-950/60 border border-teal-200 dark:border-teal-800/60 flex items-center justify-center text-teal-600 dark:text-teal-400">
              <Store className="h-5 w-5" />
            </div>
            <div>
              <h1 className="text-xl sm:text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                {t("readyMarket.title")}
              </h1>
              <p className="text-xs sm:text-sm text-gray-500 dark:text-gray-400">
                {t("readyMarket.subtitle")}
              </p>
            </div>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <Button
            variant="outline"
            size="sm"
            onClick={() => refetch()}
            disabled={isFetching}
            className="gap-2 h-9 text-xs"
          >
            <RotateCw className={`h-3.5 w-3.5 ${isFetching ? "animate-spin" : ""}`} />
            {language === "ar" ? "تحديث" : "Refresh"}
          </Button>
        </div>
      </div>

      {/* Filter Toolbar */}
      <div className="rounded-xl border border-gray-200/80 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 p-3.5 sm:p-4 space-y-3 shadow-sm">
        <div className="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
          {/* Search */}
          <div className="relative flex-1 max-w-md">
            <Search className="absolute start-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
            <Input
              value={search}
              onChange={(e) => {
                setSearch(e.target.value);
                setPage(1);
              }}
              placeholder={t("readyMarket.searchPlaceholder")}
              className="ps-9 h-9 text-xs bg-gray-50/50 dark:bg-neutral-800/50"
            />
          </div>

          {/* Filter Pills */}
          <div className="flex flex-wrap items-center gap-2">
            <SellerFilter
              value={seller}
              onChange={(val) => {
                setSeller(val);
                setPage(1);
              }}
            />

            <FilterSelect
              label={t("readyMarket.filters.status")}
              allLabel={t("readyMarket.allStatuses")}
              value={statusFilter}
              options={statusOptions}
              onChange={(val) => {
                setStatusFilter(val);
                setPage(1);
              }}
            />

            <FilterSelect
              label={t("readyMarket.filters.listingType")}
              allLabel={t("readyMarket.allListingTypes")}
              value={listingTypeFilter}
              options={listingTypeOptions}
              onChange={(val) => {
                setListingTypeFilter(val);
                setPage(1);
              }}
            />
          </div>
        </div>

        {/* Selected actions row */}
        {selectedIds.length > 0 && (
          <div className="flex items-center justify-between pt-2 border-t border-gray-100 dark:border-neutral-800 text-xs">
            <span className="text-gray-600 dark:text-gray-300 font-medium">
              {language === "ar"
                ? `تم تحديد ${selectedIds.length} عنصر`
                : `${selectedIds.length} item(s) selected`}
            </span>
            <div className="flex items-center gap-2">
              <Button
                variant="outline"
                size="sm"
                onClick={handleBulkAccept}
                className="gap-1.5 h-8 text-xs text-emerald-600 border-emerald-200 hover:bg-emerald-50 dark:border-emerald-800 dark:hover:bg-emerald-950/40"
              >
                <CheckCircle2 className="h-3.5 w-3.5" />
                {t("readyMarket.actions.bulkAccept") || "Accept Selected"}
              </Button>
              <Button
                variant="outline"
                size="sm"
                onClick={handleBulkReject}
                className="gap-1.5 h-8 text-xs text-rose-600 border-rose-200 hover:bg-rose-50 dark:border-rose-800 dark:hover:bg-rose-950/40"
              >
                <XCircle className="h-3.5 w-3.5" />
                {t("readyMarket.actions.bulkReject") || "Reject Selected"}
              </Button>
            </div>
          </div>
        )}
      </div>

      {/* Table section */}
      <div className="relative space-y-4">
        {isLoading ? (
          <div className="rounded-xl border border-gray-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-12 flex flex-col items-center justify-center gap-3">
            <Loader2 className="h-8 w-8 animate-spin text-teal-600" />
            <p className="text-xs text-gray-500">
              {language === "ar" ? "جاري تحميل الوحدات..." : "Loading ready units..."}
            </p>
          </div>
        ) : (
          <ReadyUnitsTable
            rows={rows}
            selectedIds={selectedIds}
            onSelectAll={handleSelectAll}
            onSelect={handleSelectOne}
            onAccept={acceptUnit}
            onReject={rejectUnit}
            onDelete={handleDelete}
            pendingId={pendingId ?? undefined}
          />
        )}

        {/* Pagination */}
        {!isLoading && total > 0 && (
          <div className="mt-4">
            <Pagination
              page={page}
              totalPages={totalPages}
              perPage={Number(perPage) || 10}
              totalItems={total}
              onPageChange={setPage}
              onPerPageChange={(val) => {
                setPerPage(val);
                setPage(1);
              }}
              isLoading={isFetching}
              currentItemsCount={rows.length}
            />
          </div>
        )}
      </div>
    </div>
  );
}
