"use client";

import { useRef, useState, useEffect } from "react";
import { Control, Controller, FieldErrors, UseFormRegister, UseFormSetValue, UseFormWatch } from "react-hook-form";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Search, ChevronDown, Check, Building2 } from "lucide-react";
import {
  Popover,
  PopoverContent,
  PopoverTrigger,
} from "@/components/ui/popover";
import {
  Command,
  CommandEmpty,
  CommandGroup,
  CommandInput,
  CommandItem,
  CommandList,
} from "@/components/ui/command";
import { cn } from "@/lib/utils";
import { PropertiesInput } from "@/validators/propertiesSchema";
import {
  constructionStatusOptions,
  availabilityStatusOptions,
  statusOptions,
} from "../constants";
import { useLanguage } from "@/contexts/LanguageContext";
import SeoSection from "../SeoSection";

interface Option {
  id: string | number;
  name: string;
}

interface ProjectOption {
  project_id: string | number;
  project_name: string;
}

interface BasicInfoTabProps {
  register: UseFormRegister<PropertiesInput>;
  control: Control<PropertiesInput>;
  errors: FieldErrors<PropertiesInput>;
  propertiesType: Option[];
  propertiesSubtype: Option[];
  projects: ProjectOption[];
  setValue?: UseFormSetValue<PropertiesInput>;
  watch?: UseFormWatch<PropertiesInput>;
}

export default function BasicInfoTab({
  register,
  control,
  errors,
  propertiesType,
  propertiesSubtype,
  projects,
  setValue,
  watch,
}: BasicInfoTabProps) {
  const { t, language } = useLanguage();
  const isAr = language === "ar";
  const [projectSearch, setProjectSearch] = useState("");
  const [projectPerPage, setProjectPerPage] = useState(10);
  const [isProjectOpen, setIsProjectOpen] = useState(false);
  const projectListRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handleScroll = () => {
      if (!isProjectOpen || !projectListRef.current) return;
      const { scrollTop, scrollHeight, clientHeight } = projectListRef.current;
      if (scrollTop + clientHeight >= scrollHeight - 10) {
        setProjectPerPage((prev) => prev + 10);
      }
    };
    const listElement = projectListRef.current;
    if (listElement) {
      listElement.addEventListener("scroll", handleScroll);
      return () => listElement.removeEventListener("scroll", handleScroll);
    }
  }, [isProjectOpen]);

  const handleProjectSearch = (value: string) => {
    setProjectSearch(value);
    setProjectPerPage(10);
  };

  const filteredProjects = projects.filter((p) => {
    const pName = p?.project_name || "";
    const search = projectSearch || "";
    return pName.toString().toLowerCase().includes(search.toLowerCase());
  });

  return (
    <div className="space-y-4">
      <div className="bg-white dark:bg-neutral-900 rounded-xl border border-gray-200 dark:border-neutral-800 p-5 sm:p-6 space-y-4 shadow-2xs">
        <div>
          <h2 className="text-sm sm:text-base font-semibold text-gray-900 dark:text-gray-100">
            {isAr ? "المعلومات الأساسية" : (t("properties.create.basicInfo.title") || "Basic Information")}
          </h2>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
          <div>
            <Label htmlFor="property_name" className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "اسم العقار (عربي)" : (t("properties.create.basicInfo.propertyName") || "Property Name (Arabic)")} <span className="text-red-500">*</span>
            </Label>
            <Input
              id="property_name"
              {...register("property_name")}
              placeholder={isAr ? "اسم العقار" : "Property name"}
              className="mt-1.5"
              error={!!errors.property_name}
            />
            {errors.property_name && (
              <p className="text-red-500 text-xs mt-1">
                {t(errors.property_name.message as string)}
              </p>
            )}
          </div>

          <div>
            <Label htmlFor="property_name_en" className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "اسم العقار (إنجليزي)" : "Property Name (English)"}
            </Label>
            <Input
              id="property_name_en"
              {...register("property_name_en")}
              placeholder="Property name"
              className="mt-1.5"
            />
          </div>

          <div>
            <Label htmlFor="property_no" className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "رقم العقار" : (t("properties.create.basicInfo.propertyNo") || "Property No")}
            </Label>
            <Input
              id="property_no"
              {...register("property_no")}
              placeholder="e.g. B4307"
              className="mt-1.5"
            />
          </div>

          <div>
            <Label className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "المشروع" : (t("properties.create.basicInfo.project") || "Project")} <span className="text-red-500">*</span>
            </Label>
            <Controller
              name="project_id"
              control={control}
              render={({ field }) => (
                <Popover open={isProjectOpen} onOpenChange={setIsProjectOpen}>
                  <PopoverTrigger asChild>
                    <button
                      type="button"
                      role="combobox"
                      aria-expanded={isProjectOpen}
                      className={cn(
                        "flex h-9 w-full items-center justify-between rounded-md border border-input dark:border-neutral-700 bg-white dark:bg-neutral-950 px-3 py-2 text-sm shadow-xs transition-colors mt-1.5 text-gray-900 dark:text-gray-100",
                        "hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring",
                        "disabled:cursor-not-allowed disabled:opacity-50",
                        errors.project_id && "border-red-500 focus-visible:ring-red-500",
                        !field.value && "text-muted-foreground"
                      )}
                    >
                      <span className="truncate">
                        {field.value
                          ? projects.find((p) => String(p.project_id ?? (p as any).id) === String(field.value))?.project_name || field.value
                          : (isAr ? "ابحث واختر المشروع" : (t("properties.create.basicInfo.selectProject") || "Search and select project"))}
                      </span>
                      <ChevronDown className="h-4 w-4 opacity-50 shrink-0" />
                    </button>
                  </PopoverTrigger>
                  <PopoverContent className="w-[--radix-popover-trigger-width] p-0 bg-white dark:bg-neutral-900 border border-gray-200 dark:border-neutral-800" align="start">
                    <Command className="dark:bg-neutral-900">
                      <CommandInput
                        placeholder={isAr ? "ابحث عن مشروع..." : (t("properties.create.basicInfo.searchProject") || "Search project...")}
                        value={projectSearch}
                        onValueChange={handleProjectSearch}
                        className="dark:text-gray-100"
                      />
                      <CommandList ref={projectListRef} className="dark:bg-neutral-900">
                        <CommandEmpty className="dark:text-gray-400">{t("properties.create.basicInfo.noProjectFound")}</CommandEmpty>
                        <CommandGroup>
                          {filteredProjects.slice(0, projectPerPage).map((project) => (
                            <CommandItem
                              key={project.project_id ?? (project as any).id}
                              value={project.project_name}
                              onSelect={() => {
                                field.onChange(String(project.project_id ?? (project as any).id));
                                setIsProjectOpen(false);
                              }}
                              className="dark:text-gray-200 dark:hover:bg-neutral-800 cursor-pointer"
                            >
                              <Check
                                className={cn(
                                  "mr-2 h-4 w-4 text-teal-600 dark:text-teal-400",
                                  String(field.value) === String(project.project_id ?? (project as any).id) ? "opacity-100" : "opacity-0"
                                )}
                              />
                              {project.project_name}
                            </CommandItem>
                          ))}
                        </CommandGroup>
                      </CommandList>
                    </Command>
                  </PopoverContent>
                </Popover>
              )}
            />
            {errors.project_id && (
              <p className="text-red-500 text-xs mt-1">
                {t(errors.project_id.message as string)}
              </p>
            )}
          </div>

          <div>
            <Label className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "نوع العقار" : (t("properties.create.basicInfo.propertyType") || "Property Type")} <span className="text-red-500">*</span>
            </Label>
            <Controller
              name="property_type_id"
              control={control}
              render={({ field }) => (
                <Select key={field.value || ''} onValueChange={field.onChange} value={field.value ? String(field.value) : ""}>
                  <SelectTrigger className="mt-1.5" error={!!errors.property_type_id}>
                    <SelectValue placeholder={isAr ? "اختر نوع العقار" : (t("properties.create.basicInfo.selectPropertyType") || "Select type")}>
                      {field.value && propertiesType.find((t) => String(t.id) === String(field.value))?.name}
                    </SelectValue>
                  </SelectTrigger>
                  <SelectContent>
                    {propertiesType.map((type) => (
                      <SelectItem key={type.id} value={String(type.id)}>
                        {type.name}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              )}
            />
            {errors.property_type_id && (
              <p className="text-red-500 text-xs mt-1">
                {t(errors.property_type_id.message as string)}
              </p>
            )}
          </div>

          <div>
            <Label className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "التصنيف" : (t("properties.create.basicInfo.status") || "Status")} <span className="text-red-500">*</span>
            </Label>
            <Controller
              name="status"
              control={control}
              render={({ field }) => (
                <Select key={field.value || ''} onValueChange={field.onChange} value={field.value ? String(field.value) : ""}>
                  <SelectTrigger className="mt-1.5" error={!!errors.status}>
                    <SelectValue placeholder={isAr ? "اختر التصنيف" : (t("properties.create.basicInfo.selectStatus") || "Select status")}>
                      {field.value && (t(`properties.create.options.status.${field.value}`) || statusOptions.find(o => o.value === field.value)?.label)}
                    </SelectValue>
                  </SelectTrigger>
                  <SelectContent>
                    {statusOptions.map((option) => (
                      <SelectItem key={option.value} value={option.value}>
                        {t(`properties.create.options.status.${option.value}`) || option.label}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              )}
            />
            {errors.status && (
              <p className="text-red-500 text-xs mt-1">
                {t(errors.status.message as string)}
              </p>
            )}
          </div>

          <div>
            <Label className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "النوع الفرعي" : (t("properties.create.basicInfo.unitSubType") || "Subtype")} <span className="text-red-500">*</span>
            </Label>
            <Controller
              name="property_subtype_id"
              control={control}
              render={({ field }) => (
                <Select key={field.value || ''} onValueChange={field.onChange} value={field.value ? String(field.value) : ""}>
                  <SelectTrigger className="mt-1.5" error={!!errors.property_subtype_id}>
                    <SelectValue placeholder={isAr ? "اختر النوع الفرعي" : (t("properties.create.basicInfo.selectSubType") || "Select subtype")}>
                      {field.value && propertiesSubtype.find((t) => String(t.id) === String(field.value))?.name}
                    </SelectValue>
                  </SelectTrigger>
                  <SelectContent>
                    {propertiesSubtype.map((subtype) => (
                      <SelectItem key={subtype.id} value={String(subtype.id)}>
                        {subtype.name}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              )}
            />
            {errors.property_subtype_id && (
              <p className="text-red-500 text-xs mt-1">
                {t(errors.property_subtype_id.message as string)}
              </p>
            )}
          </div>

          <div>
            <Label htmlFor="building_name" className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "اسم المبنى" : (t("properties.create.basicInfo.buildingName") || "Building Name")}
            </Label>
            <Input
              id="building_name"
              {...register("building_name")}
              placeholder={isAr ? "اسم المبنى" : "Building name"}
              className="mt-1.5"
            />
          </div>

          <div>
            <Label className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "حالة الإنشاء" : (t("properties.create.basicInfo.constructionStatus") || "Construction Status")} <span className="text-red-500">*</span>
            </Label>
            <Controller
              name="construction_status"
              control={control}
              render={({ field }) => (
                <Select key={field.value || ''} onValueChange={field.onChange} value={field.value ? String(field.value) : ""}>
                  <SelectTrigger className="mt-1.5" error={!!errors.construction_status}>
                    <SelectValue placeholder={isAr ? "جاهز" : (t("properties.create.basicInfo.selectConstructionStatus") || "Select status")}>
                      {field.value && (t(`properties.create.options.constructionStatus.${field.value}`) || constructionStatusOptions.find(o => o.value === field.value)?.label)}
                    </SelectValue>
                  </SelectTrigger>
                  <SelectContent>
                    {constructionStatusOptions.map((option) => (
                      <SelectItem key={option.value} value={option.value}>
                        {t(`properties.create.options.constructionStatus.${option.value}`) || option.label}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              )}
            />
            {errors.construction_status && (
              <p className="text-red-500 text-xs mt-1">
                {t(errors.construction_status.message as string)}
              </p>
            )}
          </div>

          <div>
            <Label className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "حالة التوفر" : (t("properties.create.basicInfo.availabilityStatus") || "Availability Status")} <span className="text-red-500">*</span>
            </Label>
            <Controller
              name="availability_status"
              control={control}
              render={({ field }) => (
                <Select key={field.value || ''} onValueChange={field.onChange} value={field.value ? String(field.value) : ""}>
                  <SelectTrigger className="mt-1.5" error={!!errors.availability_status}>
                    <SelectValue placeholder={isAr ? "متاحة" : (t("properties.create.basicInfo.selectAvailabilityStatus") || "Select status")}>
                      {field.value && (t(`properties.create.options.availabilityStatus.${field.value}`) || availabilityStatusOptions.find(o => o.value === field.value)?.label)}
                    </SelectValue>
                  </SelectTrigger>
                  <SelectContent>
                    {availabilityStatusOptions.map((option) => (
                      <SelectItem key={option.value} value={option.value}>
                        {t(`properties.create.options.availabilityStatus.${option.value}`) || option.label}
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              )}
            />
            {errors.availability_status && (
              <p className="text-red-500 text-xs mt-1">
                {t(errors.availability_status.message as string)}
              </p>
            )}
          </div>

          <div className="md:col-span-2">
            <Label htmlFor="description" className="text-xs font-semibold text-gray-700 dark:text-gray-300">
              {isAr ? "الوصف" : (t("properties.create.basicInfo.description") || "Description")}
            </Label>
            <Textarea
              id="description"
              {...register("description")}
              placeholder={isAr ? "اكتب الوصف هنا" : (t("properties.create.basicInfo.descriptionPlaceholder") || "Write description here...")}
              className="mt-1.5 min-h-[110px] bg-white dark:bg-neutral-950 border-input dark:border-neutral-700 dark:text-gray-100"
            />
          </div>
        </div>
      </div>

      <SeoSection register={register} setValue={setValue} watch={watch} />
    </div>
  );
}