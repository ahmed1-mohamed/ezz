"use client";

import { useEffect, useRef, useState } from "react";
import { Link2, Loader2, Trash2 } from "lucide-react";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { useLanguage } from "@/contexts/LanguageContext";
import { InteractiveMapPicker, type LocationSelectedData } from "@/components/shared/InteractiveMapPicker";
import {
  buildGoogleMapsUrl,
  isCoordinateText,
  isValidLatLng,
  parseCoordinateInput,
  resolveGoogleMapsUrl,
  roundCoordinate,
} from "@/lib/maps/parse-map-url";
import { isAbortError, lookupAddress, type LocationDetails, type LocationSource } from "@/lib/maps/geocoding";

export interface LocationValue {
  latitude: number | null;
  longitude: number | null;
  mapLink: string;
}

export interface LocationChange extends LocationValue {
  source: LocationSource | "clear";
  /** Present once the address lookup for this point finished (fields may be empty strings). */
  details?: LocationDetails;
}

interface LocationPickerFieldProps {
  value: LocationValue;
  onChange: (change: LocationChange) => void;
  defaultCenter?: { lat: number; lng: number };
  mapHeight?: string;
  showLinkInput?: boolean;
  showCoordinateInputs?: boolean;
  required?: boolean;
  errors?: { mapLink?: string; latitude?: string; longitude?: string };
  className?: string;
  idPrefix?: string;
}

const TYPING_DEBOUNCE_MS = 600;

function formatCoordinate(value: number | null): string {
  return value === null || !Number.isFinite(value) ? "" : String(roundCoordinate(value));
}

/**
 * Link + map + coordinates, kept in sync: paste a Google Maps link, search or click the map,
 * or type coordinates — every path produces the same rounded coordinates and a matching map link.
 */
export function LocationPickerField({
  value,
  onChange,
  defaultCenter,
  mapHeight,
  showLinkInput = true,
  showCoordinateInputs = true,
  required = false,
  errors,
  className,
  idPrefix = "location",
}: LocationPickerFieldProps) {
  const { t, language } = useLanguage();
  const onChangeRef = useRef(onChange);
  onChangeRef.current = onChange;

  const [linkInput, setLinkInput] = useState(value.mapLink);
  const [linkError, setLinkError] = useState<string | null>(null);
  const [isResolving, setIsResolving] = useState(false);
  const [latInput, setLatInput] = useState(formatCoordinate(value.latitude));
  const [lngInput, setLngInput] = useState(formatCoordinate(value.longitude));
  const [coordError, setCoordError] = useState<string | null>(null);
  const editingRef = useRef<"link" | "coords" | null>(null);
  const requestRef = useRef<AbortController | null>(null);
  const typingTimerRef = useRef<number | null>(null);

  useEffect(() => {
    if (editingRef.current !== "link") setLinkInput(value.mapLink);
  }, [value.mapLink]);

  useEffect(() => {
    if (editingRef.current === "coords") return;
    setLatInput(formatCoordinate(value.latitude));
    setLngInput(formatCoordinate(value.longitude));
    setCoordError(null);
  }, [value.latitude, value.longitude]);

  useEffect(
    () => () => {
      requestRef.current?.abort();
      if (typingTimerRef.current) window.clearTimeout(typingTimerRef.current);
    },
    []
  );

  const startRequest = () => {
    requestRef.current?.abort();
    const controller = new AbortController();
    requestRef.current = controller;
    return controller;
  };

  const resolveLink = async (raw: string) => {
    const input = raw.trim();
    if (!input) return;
    const controller = startRequest();
    setIsResolving(true);
    setLinkError(null);
    try {
      const raw = await resolveGoogleMapsUrl(input, controller.signal);
      if (!raw) {
        setLinkError(t("locations.mapPicker.linkInvalid"));
        return;
      }
      const point = { latitude: roundCoordinate(raw.lat), longitude: roundCoordinate(raw.lng) };
      const mapLink = isCoordinateText(input) ? buildGoogleMapsUrl(point.latitude, point.longitude) : input;
      editingRef.current = null;
      setLinkInput(mapLink);
      onChangeRef.current({ ...point, mapLink, source: "link" });
      const details = await lookupAddress(point.latitude, point.longitude, {
        language,
        signal: controller.signal,
        preferGoogle: true,
      });
      onChangeRef.current({ ...point, mapLink, source: "link", details });
    } catch (error) {
      if (!isAbortError(error)) setLinkError(t("locations.mapPicker.linkFailed"));
    } finally {
      if (requestRef.current === controller) {
        requestRef.current = null;
        setIsResolving(false);
      }
    }
  };

  const handleMapSelect = (data: LocationSelectedData) => {
    requestRef.current?.abort();
    editingRef.current = null;
    setLinkError(null);
    onChangeRef.current({
      latitude: data.lat,
      longitude: data.lng,
      mapLink: data.googleMapLink,
      source: data.source,
      details: data.detailsLoaded
        ? {
            address: data.landmark || "",
            city: data.city || "",
            area: data.area || "",
            country: data.country || "",
            countryCode: data.countryCode || "",
          }
        : undefined,
    });
  };

  const applyTypedCoordinates = (latText: string, lngText: string) => {
    if (typingTimerRef.current) window.clearTimeout(typingTimerRef.current);
    if (!latText.trim() && !lngText.trim()) {
      setCoordError(null);
      requestRef.current?.abort();
      onChangeRef.current({ latitude: null, longitude: null, mapLink: "", source: "clear" });
      return;
    }
    const lat = parseCoordinateInput(latText);
    const lng = parseCoordinateInput(lngText);
    if (lat === null || lng === null || !isValidLatLng(lat, lng)) {
      const incomplete = !latText.trim() || !lngText.trim();
      setCoordError(incomplete ? null : t("locations.mapPicker.invalidCoordinates"));
      return;
    }
    setCoordError(null);
    typingTimerRef.current = window.setTimeout(async () => {
      const point = { latitude: roundCoordinate(lat), longitude: roundCoordinate(lng) };
      const mapLink = buildGoogleMapsUrl(point.latitude, point.longitude);
      onChangeRef.current({ ...point, mapLink, source: "coordinates" });
      const controller = startRequest();
      try {
        const details = await lookupAddress(point.latitude, point.longitude, { language, signal: controller.signal });
        onChangeRef.current({ ...point, mapLink, source: "coordinates", details });
      } catch {
      }
    }, TYPING_DEBOUNCE_MS);
  };

  const clearLocation = () => {
    requestRef.current?.abort();
    editingRef.current = null;
    setLinkInput("");
    setLinkError(null);
    setCoordError(null);
    onChangeRef.current({ latitude: null, longitude: null, mapLink: "", source: "clear" });
  };

  const hasPoint = value.latitude !== null && value.longitude !== null;
  const linkErrorText = linkError || errors?.mapLink;

  return (
    <div className={cn("space-y-3", className)}>
      {showLinkInput && (
        <div className="space-y-1.5">
          <Label htmlFor={`${idPrefix}-map-link`} className="text-xs font-medium text-gray-700 dark:text-gray-300">
            {t("locations.mapPicker.linkLabel")}
            {required && <span className="text-red-500"> *</span>}
          </Label>
          <div className="flex gap-2">
            <div className="relative min-w-0 flex-1">
              <Link2 className="pointer-events-none absolute start-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-gray-400" />
              <Input
                id={`${idPrefix}-map-link`}
                value={linkInput}
                onFocus={() => (editingRef.current = "link")}
                onBlur={() => (editingRef.current = null)}
                onChange={(e) => {
                  setLinkInput(e.target.value);
                  setLinkError(null);
                }}
                onPaste={(e) => {
                  const pasted = e.clipboardData.getData("text");
                  if (pasted.trim()) {
                    e.preventDefault();
                    setLinkInput(pasted.trim());
                    resolveLink(pasted);
                  }
                }}
                onKeyDown={(e) => {
                  if (e.key === "Enter") {
                    e.preventDefault();
                    resolveLink(linkInput);
                  }
                }}
                placeholder={t("locations.mapPicker.linkPlaceholder")}
                aria-invalid={!!linkErrorText}
                className={cn(
                  "h-9 bg-white ps-8 text-xs dark:bg-neutral-950",
                  linkErrorText && "border-red-400 focus-visible:ring-red-200"
                )}
                dir="ltr"
              />
            </div>
            <Button
              type="button"
              variant="outline"
              onClick={() => resolveLink(linkInput)}
              disabled={isResolving || !linkInput.trim()}
              className="h-9 shrink-0 border-teal-600 px-4 text-xs font-medium text-teal-700 hover:bg-teal-50 dark:border-teal-500 dark:text-teal-400 dark:hover:bg-teal-950/40"
            >
              {isResolving ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : t("locations.mapPicker.findOnMap")}
            </Button>
          </div>
          {linkErrorText ? (
            <p className="text-xs text-red-500">{linkErrorText}</p>
          ) : (
            <p className="text-[11px] text-gray-400 dark:text-gray-500">{t("locations.mapPicker.linkHint")}</p>
          )}
        </div>
      )}

      <InteractiveMapPicker
        latitude={value.latitude}
        longitude={value.longitude}
        defaultCenter={defaultCenter}
        onLocationSelect={handleMapSelect}
        height={mapHeight}
      />

      {showCoordinateInputs && (
        <div className="space-y-1.5">
          <div className="grid grid-cols-1 gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
            {(["latitude", "longitude"] as const).map((field) => {
              const isLat = field === "latitude";
              const fieldError = errors?.[field];
              return (
                <div key={field}>
                  <Label htmlFor={`${idPrefix}-${field}`} className="mb-1 block text-xs font-medium text-gray-700 dark:text-gray-300">
                    {t(`locations.mapPicker.${field}`)}
                    {required && <span className="text-red-500"> *</span>}
                  </Label>
                  <Input
                    id={`${idPrefix}-${field}`}
                    inputMode="decimal"
                    dir="ltr"
                    value={isLat ? latInput : lngInput}
                    onFocus={() => (editingRef.current = "coords")}
                    onBlur={() => (editingRef.current = null)}
                    onChange={(e) => {
                      const next = e.target.value;
                      if (isLat) setLatInput(next);
                      else setLngInput(next);
                      applyTypedCoordinates(isLat ? next : latInput, isLat ? lngInput : next);
                    }}
                    placeholder={isLat ? "25.204800" : "55.270800"}
                    aria-invalid={!!(fieldError || coordError)}
                    className={cn(
                      "h-9 bg-white font-mono text-xs dark:bg-neutral-950",
                      (fieldError || coordError) && "border-red-400 focus-visible:ring-red-200"
                    )}
                  />
                  {fieldError && <p className="mt-1 text-xs text-red-500">{fieldError}</p>}
                </div>
              );
            })}
            <Button
              type="button"
              variant="ghost"
              onClick={clearLocation}
              disabled={!hasPoint && !linkInput}
              className="h-9 gap-1.5 text-xs text-gray-500 hover:text-red-600"
            >
              <Trash2 className="h-3.5 w-3.5" />
              {t("locations.mapPicker.clearLocation")}
            </Button>
          </div>
          {coordError && <p className="text-xs text-red-500">{coordError}</p>}
        </div>
      )}
    </div>
  );
}
