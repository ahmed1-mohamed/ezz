import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Landmark, FileText } from "lucide-react";
import { useLanguage } from "@/contexts/LanguageContext";
import { useFormContext } from "react-hook-form";

export function LocationAdditionalDetails() {
  const { t } = useLanguage();
  const { register, formState: { errors } } = useFormContext();

  return (
    <>
      <div>
        <Label htmlFor="landmark" className="flex items-center gap-2">
          <Landmark className="h-4 w-4" />
          {t("locations.form.landmark")}
        </Label>
        <Input
          id="landmark"
          placeholder={t("locations.form.landmarkPlaceholder")}
          {...register("landmark")}
          className={`mt-1 ${errors.landmark ? "border-red-500 focus-visible:ring-red-500" : ""}`}
        />
        {errors.landmark && (
          <p className="text-xs text-red-500 mt-1">{errors.landmark.message as string}</p>
        )}
      </div>

      <div>
        <Label htmlFor="description" className="flex items-center gap-2">
          <FileText className="h-4 w-4" />
          {t("locations.form.description")}
        </Label>
        <Textarea
          id="description"
          placeholder={t("locations.form.descriptionPlaceholder")}
          {...register("description")}
          className={`mt-1 ${errors.description ? "border-red-500 focus-visible:ring-red-500" : ""}`}
          rows={3}
        />
        {errors.description && (
          <p className="text-xs text-red-500 mt-1">{errors.description.message as string}</p>
        )}
      </div>
    </>
  );
}