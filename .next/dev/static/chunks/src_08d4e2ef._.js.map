"use client";

// TEMPORARY visual check — delete after review.
import { useState } from "react";
import { CascadingLocationSelect, type CascadingLocationValue } from "@/components/shared/location/CascadingLocationSelect";

export default function Preview() {
  const [value, setValue] = useState<CascadingLocationValue>({ country: { id: 2, name: "UAE" }, city: null, area: null });
  return (
    <div className="min-h-screen bg-white p-8">
      <div className="mx-auto max-w-4xl">
        <CascadingLocationSelect value={value} onChange={setValue} required={{ country: true, city: true, area: true }} />
        <pre id="value" className="mt-6 text-xs">{JSON.stringify(value)}</pre>
      </div>
    </div>
  );
}
