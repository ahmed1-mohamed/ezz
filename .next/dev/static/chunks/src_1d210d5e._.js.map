"use client";

import { useFormContext, Controller } from "react-hook-form";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { User, Mail, Phone } from "lucide-react";
import { useLanguage } from "@/contexts/LanguageContext";
import type { CreateNewUserInput } from "@/validators/create-new-user.schema";
import { useState, useEffect, useRef, useMemo } from "react";

interface BasicInfoFieldsProps {
  roles: any[];
  rolesLoading: boolean;
  onRoleChange: (roleId: number) => void;
  onUserTypeChange?: (userType: string) => void;
}

export function BasicInfoFields({ roles, rolesLoading, onRoleChange, onUserTypeChange }: BasicInfoFieldsProps) {
  const { register, control, formState: { errors }, setValue, watch } = useFormContext<CreateNewUserInput>();
  const { t } = useLanguage();
  const [preview, setPreview] = useState<string | null>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);

  const profilePicture = watch("profile_picture");

  useEffect(() => {
    if (!profilePicture) {
      setPreview(null);
      return;
    }

    if (typeof profilePicture === "string" && profilePicture.trim() !== "") {
      setPreview(profilePicture);
      return;
    }

    let file: Blob | null = null;
    const p = profilePicture;
    if (p) {
      if (p instanceof File || p instanceof Blob) {
        file = p;
      } else if (typeof p === "object" && "size" in p && "type" in p) {
        file = p as unknown as Blob;
      } else if (p instanceof FileList && p.length > 0) {
        file = p[0];
      } else if (Array.isArray(p) && p.length > 0 && typeof p[0] === "object" && "size" in p[0]) {
        file = p[0] as unknown as Blob;
      }
    }

    if (file) {
      const objectUrl = URL.createObjectURL(file);
      setPreview(objectUrl);

      return () => {
        URL.revokeObjectURL(objectUrl);
      };
    } else {
      setPreview(null);
    }
  }, [profilePicture]);

  return (
    <>
      <div className="flex flex-col gap-2 items-center justify-center p-4 border border-dashed rounded-xl bg-gray-55/50 border-gray-200 dark:border-neutral-800 dark:bg-neutral-900/50 mb-4">
        <Label className="text-sm font-bold text-gray-700 dark:text-gray-300 mb-1 self-start">
          {t("experts.settings.imagePicker.label") || "Upload profile picture"}
        </Label>
        <div className="flex items-center gap-4 w-full">
          <div className="w-16 h-16 rounded-xl border border-gray-100 dark:border-neutral-800 overflow-hidden bg-gray-100 dark:bg-neutral-800 flex items-center justify-center flex-shrink-0">
            {preview ? (
              <img
                src={preview}
                alt="Profile photo preview"
                className="w-full h-full object-cover"
              />
            ) : (
              <span className="text-teal-600 dark:text-teal-400 font-bold text-xl">U</span>
            )}
          </div>
          <div className="flex flex-col gap-1 flex-1 w-full">
            <Controller
              name="profile_picture"
              control={control}
              render={({ field }) => (
                <input
                  ref={fileInputRef}
                  type="file"
                  accept="image/*"
                  className="hidden"
                  onChange={(e) => {
                    const files = e.target.files;
                    if (files && files.length > 0) {
                      field.onChange(files[0]);
                    }
                  }}
                />
              )}
            />
            <div className="flex gap-2">
              <button
                type="button"
                onClick={() => fileInputRef.current?.click()}
                className="px-4 py-1.5 text-xs font-semibold text-teal-700 bg-teal-50 hover:bg-teal-100 rounded-lg dark:bg-teal-950/30 dark:text-teal-400 dark:hover:bg-teal-950/50 border border-teal-200/50 dark:border-teal-900/50 transition-colors"
              >
                {t("experts.settings.imagePicker.choose") || "Choose image"}
              </button>
              {preview && (
                <button
                  type="button"
                  onClick={() => setValue("profile_picture", "")}
                  className="px-4 py-1.5 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded-lg dark:bg-red-950/30 dark:text-red-400 dark:hover:bg-red-950/50 border border-red-200/50 dark:border-red-900/50 transition-colors"
                >
                  {t("common.delete") || "Remove"}
                </button>
              )}
            </div>
            <p className="text-[10px] text-gray-400">
              {t("experts.settings.imagePicker.formats") || "SVG, PNG, JPG or GIF (MAX. 800x400px)"}
            </p>
          </div>
        </div>
      </div>
      <div className="grid grid-cols-2 gap-4">
        <div>
          <Label htmlFor="first-name">
            {t("users.addModal.firstName") || "First name"} <span className="text-red-500">*</span>
          </Label>
          <div className="relative mt-1">
            <User className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
            <Input
              id="first-name"
              placeholder={t("users.addModal.firstNamePlaceholder") || "e.g. Bonnie"}
              {...register("first_name")}
              className="pl-10"
              error={!!errors.first_name}
            />
          </div>
          {errors.first_name && (
            <p className="text-xs text-red-500 mt-1">
              {t(errors.first_name.message || "")}
            </p>
          )}
        </div>
        <div>
          <Label htmlFor="last-name">
            {t("users.addModal.lastName") || "Last name"} <span className="text-red-500">*</span>
          </Label>
          <div className="relative mt-1">
            <User className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
            <Input
              id="last-name"
              placeholder={t("users.addModal.lastNamePlaceholder") || "e.g. Green"}
              {...register("last_name")}
              className="pl-10"
              error={!!errors.last_name}
            />
          </div>
          {errors.last_name && (
            <p className="text-xs text-red-500 mt-1">
              {t(errors.last_name.message || "")}
            </p>
          )}
        </div>
      </div>
      <div>
        <Label htmlFor="email">
          {t("users.addModal.email") || "Email address"} <span className="text-red-500">*</span>
        </Label>
        <div className="relative mt-1">
          <Mail className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
          <Input
            id="email"
            type="email"
            placeholder={t("users.addModal.emailPlaceholder") || "e.g. name@company.com"}
            {...register("email")}
            className="pl-10"
            error={!!errors.email}
          />
        </div>
        {errors.email && (
          <p className="text-xs text-red-500 mt-1">{t(errors.email.message || "")}</p>
        )}
      </div>
      <div className="grid grid-cols-2 gap-4">
        <div>
          <Label htmlFor="phone-number">{t("users.addModal.phoneNumber") || "Phone number"}</Label>
          <div className="relative mt-1">
            <Phone className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
            <Input
              id="phone-number"
              type="tel"
              placeholder={t("users.addModal.phoneNumberPlaceholder") || "+1 234 567 890"}
              {...register("phone_number", {
                onChange: (e) => {
                  let val = e.target.value;
                  if (!val.startsWith("+")) {
                    val = "+" + val.replace(/\+/g, "");
                  } else {
                    val = "+" + val.slice(1).replace(/\+/g, "");
                  }
                  setValue("phone_number", val);
                }
              })}
              className="pl-10"
              error={!!errors.phone_number}
            />
          </div>
          {errors.phone_number && (
            <p className="text-xs text-red-500 mt-1">
              {t(errors.phone_number.message || "")}
            </p>
          )}
        </div>
        <div>
          <Label htmlFor="user-type">
            {t("users.addModal.userType") || "User Type"}
          </Label>
          <Controller
            name="user_type"
            control={control}
            render={({ field }) => (
              <Select
                value={field.value || ""}
                onValueChange={(val) => {
                  field.onChange(val);
                  if (onUserTypeChange) onUserTypeChange(val);
                }}
              >
                <SelectTrigger className="mt-1" error={!!errors.user_type}>
                  <SelectValue placeholder={t("users.addModal.selectUserType") || "Select User Type"} />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="admin">Admin</SelectItem>
                  <SelectItem value="developer">Developer</SelectItem>
                  <SelectItem value="expert">Expert</SelectItem>
                </SelectContent>
              </Select>
            )}
          />
          {errors.user_type && (
            <p className="text-xs text-red-500 mt-1">
              {t(errors.user_type.message || "")}
            </p>
          )}
        </div>
      </div>
      <div>
        <Label htmlFor="role">
          {t("users.addModal.role") || "Role"} <span className="text-red-500">*</span>
        </Label>
        <Controller
          name="role_id"
          control={control}
          render={({ field }) => (
            <Select
              value={field.value?.toString() || ""}
              onValueChange={(value) => onRoleChange(Number(value))}
            >
              <SelectTrigger className="mt-1" error={!!errors.role_id}>
                <SelectValue
                  placeholder={
                    rolesLoading ? t("users.addModal.loadingRoles") || "Loading roles..." : t("users.addModal.selectRole") || "Select Role"
                  }
                />
              </SelectTrigger>
              <SelectContent>
                {(roles as any[])
                  .filter((role: any) => {
                    const name = String(role.role_name ?? role.name ?? "").toLowerCase();
                    const type = String(role.role_type ?? role.type ?? "").toLowerCase();
                    return (
                      name.includes("admin") ||
                      name.includes("developer") ||
                      name.includes("expert") ||
                      type.includes("admin") ||
                      type.includes("developer") ||
                      type.includes("expert")
                    );
                  })
                  .map((role: any) => {
                    const rId = role.role_id ?? role.id;
                    const rName = role.role_name ?? role.name;
                    return (
                      <SelectItem
                        key={rId}
                        value={String(rId)}
                      >
                        {rName}
                      </SelectItem>
                    );
                  })}
              </SelectContent>
            </Select>
          )}
        />
        {errors.role_id && (
          <p className="text-xs text-red-500 mt-1">
            {t(errors.role_id.message || "")}
          </p>
        )}
      </div>
    </>
  );
}
