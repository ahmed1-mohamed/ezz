"use client";

import { useMutation, useQueryClient } from "@tanstack/react-query";
import { useSession } from "next-auth/react";
import { toast } from "sonner";
import { editLocation } from "@/data/api-client";
import { useLanguage } from "@/contexts/LanguageContext";

interface EditLocationData {
  location_name_en: string;
  location_name_ar: string;
  area_id: number;
  city_id: number;
  google_map_link: string;
  north_side: string;
  south_side: string;
  east_side: string;
  west_side: string;
  landmark?: string;
  description: string;
  latitude?: number;
  longitude?: number;
}

export function useLocationActions() {
  const { data: session } = useSession();
  const queryClient = useQueryClient();
  const { t } = useLanguage();

  const updateMutation = useMutation({
    mutationFn: async ({ locationId, data }: { locationId: number; data: EditLocationData }) => {
      const token = session?.user?.accessToken;
      if (!token) throw new Error("Not authenticated");
      return editLocation(locationId, data, token);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["locations"] });
      toast.success(t("locations.messages.updateSuccess"));
    },
    onError: (error: any) => {
      if (error?.response?.data?.errors && Array.isArray(error.response.data.errors)) {
        error.response.data.errors.forEach((errObj: any) => {
          Object.values(errObj).forEach((msg: any) => toast.error(msg));
        });
      } else {
        const errorMessage = error?.response?.data?.message ||
          error?.message ||
          t("locations.messages.updateFailed");
        toast.error(errorMessage);
      }
    },
  });

  return {
    updateLocation: updateMutation.mutateAsync,
    isUpdating: updateMutation.isPending,
  };
}