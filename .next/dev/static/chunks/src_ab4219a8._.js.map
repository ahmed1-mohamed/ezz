import React from "react";
import { SafeImage } from "@/components/ui/safe-image";
import { Button } from "@/components/ui/button";
import { useLanguage } from "@/contexts/LanguageContext";
import { Edit, Star, Plus } from "lucide-react";
import { DeveloperData } from "@/hooks/use-developer-details";

interface DeveloperHeaderProps {
  developer: DeveloperData;
  onEdit?: () => void;
  onCreateDeveloper?: () => void;
}

export function DeveloperHeader({ developer, onEdit, onCreateDeveloper }: DeveloperHeaderProps) {
  const { t } = useLanguage();

  return (
    <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
      <div className="flex items-center gap-3 sm:gap-4 min-w-0">
        {developer.logo ? (
          <SafeImage
            src={developer.logo}
            alt={developer.name}
            width={112}
            height={112}
            fallbackSrc="/images/default-logo.svg"
            className="w-20 h-20 sm:w-28 sm:h-28 rounded-xl object-contain p-1 border border-gray-200 bg-white shadow-sm flex-shrink-0"
          />
        ) : (
          <div className="w-20 h-20 sm:w-28 sm:h-28 rounded-xl bg-gray-100 border border-gray-200 flex items-center justify-center text-2xl sm:text-3xl font-bold text-gray-600 flex-shrink-0">
            {developer.name?.substring(0, 2).toUpperCase()}
          </div>
        )}
        <div className="min-w-0">
          <div className="flex items-center gap-2 flex-wrap">
            <h2 className="text-lg sm:text-xl font-bold text-gray-900 truncate">
              {developer.name}
            </h2>
            {developer.is_top === 1 && (
              <Star className="h-4 w-4 sm:h-5 sm:w-5 text-yellow-500 fill-yellow-500 flex-shrink-0" />
            )}
          </div>
          <div className="flex items-center gap-3 mt-1 sm:mt-2 text-sm text-gray-600 flex-wrap">
            <div className="flex items-center gap-1">
              <span
                className={`inline-flex h-2 w-2 rounded-full flex-shrink-0 ${developer.status === "active" ? "bg-green-500" : "bg-gray-400"
                  }`}
              />
              <span className="capitalize">{t(`common.${developer.status}`) || developer.status}</span>
            </div>
          </div>
        </div>
      </div>

      <div className="flex items-center gap-2 flex-wrap sm:flex-nowrap sm:flex-shrink-0">
        <Button
          className="bg-teal-600 hover:bg-teal-700 text-white gap-1.5 text-sm h-9 px-3"
          onClick={onCreateDeveloper}
        >
          <Plus className="h-4 w-4" />
          <span className="hidden xs:inline">{t("developers.addDeveloper") || "Add Developer"}</span>
        </Button>

        <Button
          className="bg-blue-600 hover:bg-blue-700 text-white gap-1.5 text-sm h-9 px-3"
          onClick={onEdit}
        >
          <Edit className="h-4 w-4" />
          <span className="hidden xs:inline">{t("common.update") || "Update"}</span>
        </Button>
      </div>
    </div>
  );
}
