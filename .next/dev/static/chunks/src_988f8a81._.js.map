"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import type { Map as LeafletMap, Marker as LeafletMarker } from "leaflet";
import { AlertCircle, Check, Copy, Crosshair, ExternalLink, Loader2, MapPin, Maximize2, Minimize2 } from "lucide-react";
import { cn } from "@/lib/utils";
import { useLanguage } from "@/contexts/LanguageContext";
import { buildGoogleMapsUrl, isValidLatLng, roundCoordinate } from "@/lib/maps/parse-map-url";
import { isAbortError, lookupAddress, type LocationDetails, type LocationSource } from "@/lib/maps/geocoding";
import { MapSearchBox } from "@/components/shared/maps/MapSearchBox";
import "leaflet/dist/leaflet.css";

export interface LocationSelectedData {
  lat: number;
  lng: number;
  googleMapLink: string;
  source: LocationSource;
  /** False on the first, immediate call; true once the address lookup finished (fields may still be empty). */
  detailsLoaded: boolean;
  city?: string;
  area?: string;
  landmark?: string;
  country?: string;
  countryCode?: string;
}

export interface InteractiveMapPickerProps {
  latitude?: number | null;
  longitude?: number | null;
  defaultCenter?: { lat: number; lng: number };
  onLocationSelect?: (data: LocationSelectedData) => void;
  height?: string;
  readOnly?: boolean;
  className?: string;
  defaultZoom?: number;
  showControls?: boolean;
  showBadges?: boolean;
  searchable?: boolean;
  markerLabel?: string;
}

const FALLBACK_CENTER = { lat: 25.2048, lng: 55.2708 };
const SELECTED_ZOOM = 16;
const NOTICE_MS = 5000;

const PIN_HTML = `
  <div class="map-pin">
    <svg width="34" height="42" viewBox="0 0 34 42" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M17 0C7.611 0 0 7.611 0 17c0 10.5 17 25 17 25s17-14.5 17-25C34 7.611 26.389 0 17 0Z" fill="#008081"/>
      <circle cx="17" cy="17" r="6.5" fill="white"/>
      <circle cx="17" cy="17" r="3" fill="#008081"/>
    </svg>
  </div>`;

function validPoint(lat?: number | null, lng?: number | null): { lat: number; lng: number } | null {
  return typeof lat === "number" && typeof lng === "number" && isValidLatLng(lat, lng) ? { lat, lng } : null;
}

function samePoint(a: { lat: number; lng: number } | null, b: { lat: number; lng: number } | null) {
  return !!a && !!b && Math.abs(a.lat - b.lat) < 1e-6 && Math.abs(a.lng - b.lng) < 1e-6;
}

/**
 * Animates short moves only. Leaflet's flyTo across a long distance (e.g. another city or country)
 * can leave the tile layer misaligned and the map blank, so far jumps are instant.
 */
function moveMap(map: LeafletMap | null, lat: number, lng: number, zoom: number) {
  if (!map) return;
  map.stop();
  const target: [number, number] = [lat, lng];
  const isNear = map.getBounds().pad(0.5).contains(target);
  if (isNear) map.flyTo(target, zoom, { duration: 0.6 });
  else map.setView(target, zoom, { animate: false });
}

export function InteractiveMapPicker({
  latitude,
  longitude,
  defaultCenter,
  onLocationSelect,
  height = "h-[320px] sm:h-[420px]",
  readOnly = false,
  className = "",
  defaultZoom = 12,
  showControls = true,
  showBadges = true,
  searchable = !readOnly,
  markerLabel,
}: InteractiveMapPickerProps) {
  const { t, language } = useLanguage();
  const isRtl = language === "ar";

  const wrapperRef = useRef<HTMLDivElement>(null);
  const containerRef = useRef<HTMLDivElement>(null);
  const mapRef = useRef<LeafletMap | null>(null);
  const markerRef = useRef<LeafletMarker | null>(null);
  const leafletRef = useRef<typeof import("leaflet") | null>(null);
  const lastEmittedRef = useRef<{ lat: number; lng: number } | null>(null);
  const lookupRef = useRef<AbortController | null>(null);
  const noticeTimerRef = useRef<number | null>(null);

  // Latest values for Leaflet event handlers, which are registered once.
  const latest = useRef({ onLocationSelect, language, readOnly, markerLabel });
  latest.current = { onLocationSelect, language, readOnly, markerLabel };

  const point = validPoint(latitude, longitude);
  const center = defaultCenter && isValidLatLng(defaultCenter.lat, defaultCenter.lng) ? defaultCenter : null;
  const initial = useRef({ point, center, defaultZoom });
  initial.current = { point, center, defaultZoom };

  const [mapReady, setMapReady] = useState(false);
  const [coords, setCoords] = useState(point);
  const [address, setAddress] = useState("");
  const [isGeocoding, setIsGeocoding] = useState(false);
  const [isLocating, setIsLocating] = useState(false);
  const [expanded, setExpanded] = useState(false);
  const [copied, setCopied] = useState(false);
  const [notice, setNotice] = useState<string | null>(null);

  const showNotice = useCallback((message: string) => {
    setNotice(message);
    if (noticeTimerRef.current) window.clearTimeout(noticeTimerRef.current);
    noticeTimerRef.current = window.setTimeout(() => setNotice(null), NOTICE_MS);
  }, []);

  const placeMarker = useCallback((lat: number, lng: number) => {
    const L = leafletRef.current;
    const map = mapRef.current;
    if (!L || !map) return;
    if (markerRef.current) {
      markerRef.current.setLatLng([lat, lng]);
      return;
    }
    const marker = L.marker([lat, lng], {
      icon: L.divIcon({ className: "map-pin-icon", html: PIN_HTML, iconSize: [34, 42], iconAnchor: [17, 42] }),
      draggable: !latest.current.readOnly,
      keyboard: true,
      autoPan: true,
    }).addTo(map);
    marker.on("dragend", () => {
      const pos = marker.getLatLng();
      selectRef.current(pos.lat, pos.lng, "map");
    });
    if (latest.current.markerLabel) {
      marker.bindTooltip(latest.current.markerLabel, { direction: "top", offset: [0, -40] });
    }
    markerRef.current = marker;
  }, []);

  const emit = (data: LocationSelectedData) => latest.current.onLocationSelect?.(data);

  /** Moves the pin, reports the coordinates right away, then reports the address once known. */
  const select = useCallback(
    async (rawLat: number, rawLng: number, source: LocationSource, preset?: LocationDetails) => {
      const lat = roundCoordinate(rawLat);
      const lng = roundCoordinate(rawLng);
      if (!isValidLatLng(lat, lng)) return;
      const base = { lat, lng, googleMapLink: buildGoogleMapsUrl(lat, lng), source };

      lastEmittedRef.current = { lat, lng };
      setCoords({ lat, lng });
      placeMarker(lat, lng);
      lookupRef.current?.abort();

      if (preset) {
        setAddress(preset.address);
        emit({ ...base, detailsLoaded: true, ...preset, landmark: preset.address });
        return;
      }

      emit({ ...base, detailsLoaded: false });
      const controller = new AbortController();
      lookupRef.current = controller;
      setIsGeocoding(true);
      try {
        const details = await lookupAddress(lat, lng, { language: latest.current.language, signal: controller.signal });
        setAddress(details.address);
        if (!details.address && !details.city) showNotice(t("locations.mapPicker.addressNotFound"));
        emit({ ...base, detailsLoaded: true, ...details, landmark: details.address });
      } catch (error) {
        if (!isAbortError(error)) emit({ ...base, detailsLoaded: true });
      } finally {
        if (lookupRef.current === controller) {
          lookupRef.current = null;
          setIsGeocoding(false);
        }
      }
    },
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [placeMarker, showNotice, t]
  );
  const selectRef = useRef(select);
  selectRef.current = select;

  // Create the map only once it is (about to be) visible: hidden tabs and modals don't pay for it.
  useEffect(() => {
    const wrapper = wrapperRef.current;
    if (!wrapper) return;
    let cancelled = false;
    let resizeObserver: ResizeObserver | null = null;

    const init = async () => {
      const L = (await import("leaflet")).default;
      if (cancelled || !containerRef.current || mapRef.current) return;
      leafletRef.current = L;
      const { point: startPoint, center: startCenter, defaultZoom: zoom } = initial.current;
      const start = startPoint ?? startCenter ?? FALLBACK_CENTER;

      const map = L.map(containerRef.current, {
        center: [start.lat, start.lng],
        zoom: startPoint ? SELECTED_ZOOM : zoom,
        zoomControl: false,
        scrollWheelZoom: false,
        attributionControl: true,
      });
      mapRef.current = map;
      map.attributionControl.setPrefix(false);
      L.control.zoom({ position: isRtl ? "bottomleft" : "bottomright" }).addTo(map);
      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
      }).addTo(map);

      // Scrolling the page shouldn't zoom the map until the user interacts with it.
      map.on("focus click", () => map.scrollWheelZoom.enable());
      map.on("blur mouseout", () => map.scrollWheelZoom.disable());
      map.on("click", (e) => {
        if (!latest.current.readOnly) selectRef.current(e.latlng.lat, e.latlng.lng, "map");
      });

      if (startPoint) placeMarker(startPoint.lat, startPoint.lng);

      resizeObserver = new ResizeObserver(() => map.invalidateSize());
      resizeObserver.observe(containerRef.current);
      setMapReady(true);
    };

    let visibility: IntersectionObserver | null = null;
    if (typeof IntersectionObserver === "undefined") {
      init();
    } else {
      visibility = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            visibility?.disconnect();
            init();
          }
        },
        { rootMargin: "200px" }
      );
      visibility.observe(wrapper);
    }

    return () => {
      cancelled = true;
      visibility?.disconnect();
      resizeObserver?.disconnect();
      lookupRef.current?.abort();
      mapRef.current?.remove();
      mapRef.current = null;
      markerRef.current = null;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  // Follow coordinates set from outside (typed, pasted link, loaded record) without echoing our own picks.
  useEffect(() => {
    const map = mapRef.current;
    if (!mapReady || !map) return;
    if (point) {
      setCoords(point);
      placeMarker(point.lat, point.lng);
      if (!samePoint(point, lastEmittedRef.current)) {
        lastEmittedRef.current = point;
        setAddress("");
        moveMap(map, point.lat, point.lng, Math.max(map.getZoom(), SELECTED_ZOOM));
      }
    } else {
      markerRef.current?.remove();
      markerRef.current = null;
      lastEmittedRef.current = null;
      setCoords(null);
      setAddress("");
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [mapReady, point?.lat, point?.lng]);

  // Without a pin, show the region the user chose (country / city).
  useEffect(() => {
    const map = mapRef.current;
    if (!mapReady || !map || point || !center) return;
    moveMap(map, center.lat, center.lng, defaultZoom);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [mapReady, center?.lat, center?.lng]);

  useEffect(() => {
    if (!mapReady) return;
    const timer = window.setTimeout(() => mapRef.current?.invalidateSize(), 50);
    if (!expanded) return () => window.clearTimeout(timer);
    const onKey = (e: KeyboardEvent) => e.key === "Escape" && setExpanded(false);
    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    window.addEventListener("keydown", onKey);
    return () => {
      window.clearTimeout(timer);
      document.body.style.overflow = previousOverflow;
      window.removeEventListener("keydown", onKey);
    };
  }, [expanded, mapReady]);

  useEffect(() => () => {
    if (noticeTimerRef.current) window.clearTimeout(noticeTimerRef.current);
  }, []);

  const handleLocateMe = () => {
    if (!("geolocation" in navigator) || !window.isSecureContext) {
      showNotice(t("locations.mapPicker.geolocationUnsupported"));
      return;
    }
    setIsLocating(true);
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        setIsLocating(false);
        moveMap(mapRef.current, pos.coords.latitude, pos.coords.longitude, SELECTED_ZOOM);
        select(pos.coords.latitude, pos.coords.longitude, "geolocation");
      },
      (err) => {
        setIsLocating(false);
        const key =
          err.code === err.PERMISSION_DENIED
            ? "geolocationDenied"
            : err.code === err.TIMEOUT
              ? "geolocationTimeout"
              : "geolocationUnavailable";
        showNotice(t(`locations.mapPicker.${key}`));
      },
      { timeout: 10000, enableHighAccuracy: true, maximumAge: 60000 }
    );
  };

  const copyCoordinates = async () => {
    if (!coords) return;
    try {
      await navigator.clipboard.writeText(`${coords.lat}, ${coords.lng}`);
      setCopied(true);
      window.setTimeout(() => setCopied(false), 1500);
    } catch {
      showNotice(t("locations.mapPicker.copyFailed"));
    }
  };

  const controlButton =
    "flex h-8 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-gray-700 transition-colors hover:bg-gray-100 disabled:opacity-60 dark:text-gray-200 dark:hover:bg-neutral-800";

  return (
    <div
      ref={wrapperRef}
      className={cn(
        "map-picker relative w-full overflow-hidden border border-gray-200 bg-gray-100 dark:border-neutral-800 dark:bg-neutral-900",
        expanded ? "fixed inset-0 z-[70] h-dvh rounded-none" : cn("rounded-xl shadow-sm", height),
        className
      )}
    >
      <div ref={containerRef} className="absolute inset-0 z-0" />

      {!mapReady && (
        <div className="absolute inset-0 z-[5] flex items-center justify-center">
          <Loader2 className="h-6 w-6 animate-spin text-[#008081]" />
        </div>
      )}

      {(searchable || showControls) && mapReady && (
        <div className="pointer-events-none absolute inset-x-2.5 top-2.5 z-[1000] flex items-start gap-2">
          {searchable && !readOnly && (
            <MapSearchBox
              className="pointer-events-auto min-w-0 flex-1 sm:max-w-sm"
              getBias={() => {
                const c = mapRef.current?.getCenter();
                return c ? { lat: c.lat, lng: c.lng } : null;
              }}
              onSelect={(s) => {
                moveMap(mapRef.current, s.lat, s.lng, SELECTED_ZOOM);
                select(s.lat, s.lng, "search", s.details);
              }}
              onCoordinates={(c) => {
                moveMap(mapRef.current, c.lat, c.lng, SELECTED_ZOOM);
                select(c.lat, c.lng, "coordinates");
              }}
            />
          )}
          {showControls && (
            <div className="pointer-events-auto ms-auto flex items-center gap-0.5 rounded-lg border border-gray-200 bg-white/95 p-0.5 shadow-md backdrop-blur-md dark:border-neutral-700 dark:bg-neutral-900/95">
              {!readOnly && (
                <button
                  type="button"
                  onClick={handleLocateMe}
                  disabled={isLocating}
                  title={t("locations.mapPicker.locateMeTitle")}
                  aria-label={t("locations.mapPicker.locateMeTitle")}
                  className={controlButton}
                >
                  {isLocating ? (
                    <Loader2 className="h-3.5 w-3.5 animate-spin text-[#008081]" />
                  ) : (
                    <Crosshair className="h-3.5 w-3.5 text-[#008081]" />
                  )}
                  <span className="hidden md:inline">{t("locations.mapPicker.myLocation")}</span>
                </button>
              )}
              {coords && (
                <a
                  href={buildGoogleMapsUrl(coords.lat, coords.lng)}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={t("locations.mapPicker.openInGoogleMaps")}
                  aria-label={t("locations.mapPicker.openInGoogleMaps")}
                  className={controlButton}
                >
                  <ExternalLink className="h-3.5 w-3.5 text-gray-500" />
                </a>
              )}
              <button
                type="button"
                onClick={() => setExpanded((v) => !v)}
                title={t(expanded ? "locations.mapPicker.exitFullscreen" : "locations.mapPicker.fullscreen")}
                aria-label={t(expanded ? "locations.mapPicker.exitFullscreen" : "locations.mapPicker.fullscreen")}
                className={controlButton}
              >
                {expanded ? <Minimize2 className="h-3.5 w-3.5" /> : <Maximize2 className="h-3.5 w-3.5" />}
              </button>
            </div>
          )}
        </div>
      )}

      {notice && (
        <div
          role="status"
          className="absolute inset-x-2.5 top-14 z-[1000] mx-auto flex max-w-sm items-start gap-2 rounded-lg border border-amber-200 bg-amber-50/95 px-3 py-2 text-xs text-amber-800 shadow-md dark:border-amber-900 dark:bg-amber-950/90 dark:text-amber-200"
        >
          <AlertCircle className="mt-0.5 h-3.5 w-3.5 shrink-0" />
          <span>{notice}</span>
        </div>
      )}

      {showBadges && mapReady && (
        <div className="pointer-events-none absolute bottom-2 start-2 z-[1000] max-w-[calc(100%-4.5rem)]">
          <div className="pointer-events-auto flex min-w-0 items-center gap-1.5 rounded-lg border border-gray-200 bg-white/95 px-2.5 py-1.5 text-[11px] text-gray-700 shadow-md backdrop-blur-md dark:border-neutral-700 dark:bg-neutral-900/95 dark:text-gray-300">
            <MapPin className="h-3.5 w-3.5 shrink-0 text-[#008081]" />
            {coords ? (
              <div className="min-w-0">
                <div className="flex items-center gap-1">
                  <span className="font-mono" dir="ltr">
                    {coords.lat.toFixed(6)}, {coords.lng.toFixed(6)}
                  </span>
                  <button
                    type="button"
                    onClick={copyCoordinates}
                    title={t("locations.mapPicker.copyCoordinates")}
                    aria-label={t("locations.mapPicker.copyCoordinates")}
                    className="rounded p-0.5 text-gray-400 hover:text-gray-700 dark:hover:text-gray-200"
                  >
                    {copied ? <Check className="h-3 w-3 text-emerald-500" /> : <Copy className="h-3 w-3" />}
                  </button>
                </div>
                {isGeocoding ? (
                  <span className="flex items-center gap-1 text-[10px] text-[#008081]">
                    <Loader2 className="h-2.5 w-2.5 animate-spin" />
                    {t("locations.mapPicker.detectingAddress")}
                  </span>
                ) : address ? (
                  <span className="block truncate text-[10px] text-gray-500 dark:text-gray-400">{address}</span>
                ) : null}
              </div>
            ) : (
              <span>{t(readOnly ? "locations.mapPicker.noLocation" : "locations.mapPicker.clickToPinpoint")}</span>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
