"use client";

import { useLanguage } from "@/contexts/LanguageContext";
import { useSession } from "next-auth/react";
import { Button } from "@/components/ui/button";
import { Modal } from "@/components/ui/modal";
import { AddProjectMediaModalProps } from "./types";
import { useAddProjectMediaLogic } from "./hooks";
import { MediaForm } from "./MediaForm";

export function AddProjectMediaModal({
  isOpen,
  onClose,
  projectId,
}: AddProjectMediaModalProps) {
  const { data: session } = useSession();
  const token = session?.user?.accessToken;
  const { t } = useLanguage();

  const {
    mediaItems,
    isProcessing,
    videoLink,
    setVideoLink,
    selectedMediaType,
    setSelectedMediaType,
    mutation,
    handleFileSelect,
    handleAddVideoLink,
    updateMediaItem,
    removeMediaItem,
    handleSubmit
  } = useAddProjectMediaLogic(projectId, token, isOpen, onClose, t);

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title="Add Project Media"
      size="xl"
      showCloseButton={false}
      footer={
        <div className="flex w-full justify-end gap-3">
          <Button variant="outline" onClick={onClose} disabled={mutation.isPending}>
            Cancel
          </Button>
          <Button
            className="bg-teal-600 text-white hover:bg-teal-700"
            onClick={handleSubmit}
            disabled={mutation.isPending || mediaItems.length === 0}
          >
            {mutation.isPending ? "Uploading..." : "Upload Media"}
          </Button>
        </div>
      }
    >
      <form onSubmit={handleSubmit}>
        <MediaForm
          selectedMediaType={selectedMediaType}
          setSelectedMediaType={setSelectedMediaType}
          videoLink={videoLink}
          setVideoLink={setVideoLink}
          isProcessing={isProcessing}
          mediaItems={mediaItems}
          handleFileSelect={handleFileSelect}
          handleAddVideoLink={handleAddVideoLink}
          updateMediaItem={updateMediaItem}
          removeMediaItem={removeMediaItem}
        />
      </form>
    </Modal>
  );
}
