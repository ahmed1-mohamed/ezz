import React from "react";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Clock, Image as ImageIcon, Loader2, Upload, X } from "lucide-react";
import { toast } from "sonner";

interface Stage2SalesOfferProps {
  stage: any;
  salesOfferFile: File | null;
  setSalesOfferFile: (file: File | null) => void;
  isReuploadingSalesOffer: boolean;
  setIsReuploadingSalesOffer: (val: boolean) => void;
  salesOfferImagePreview: string | null;
  adminComment: string;
  setAdminComment: (val: string) => void;
  handleSalesOfferUpload: () => void;
  uploadSalesOfferMutation: any;
  t: (key: string) => string;
  isAr: boolean;
}

export function Stage2SalesOffer({
  stage,
  salesOfferFile,
  setSalesOfferFile,
  isReuploadingSalesOffer,
  setIsReuploadingSalesOffer,
  salesOfferImagePreview,
  adminComment,
  setAdminComment,
  handleSalesOfferUpload,
  uploadSalesOfferMutation,
  t,
  isAr,
}: Stage2SalesOfferProps) {
  const hasDoc = stage.documents && stage.documents.length > 0;
  const isUploadRequest = stage.currentStatusType === "sales_offer_request";
  const isWaitingApproval =
    stage.currentStatusType === "sales_offer" ||
    stage.currentStatusType === "sales_offer_approval" ||
    (hasDoc && !isUploadRequest);
  const shouldShowUpload =
    isUploadRequest || (!hasDoc && !isWaitingApproval) || isReuploadingSalesOffer || Boolean(salesOfferFile);

  if (shouldShowUpload) {
    return (
      <div className="mt-3 p-4 bg-teal-50/40 rounded-xl border border-teal-200 space-y-3">
        <div className="flex items-center justify-between">
          <div>
            <span className="text-xs font-bold uppercase tracking-wider text-teal-800 flex items-center gap-1.5">
              <ImageIcon className="h-4 w-4 text-teal-600" />
              {isAr ? "رفع صورة عرض المبيعات" : "Upload Sales Offer Image"}
            </span>
            <p className="text-xs text-gray-600 mt-0.5">
              {isAr
                ? "ارفع صورة عرض المبيعات (صورة واحدة فقط: PNG, JPG, WEBP). بعد الرفع، سينتظر النظام موافقة العميل."
                : "Upload the sales offer image (one image only: PNG, JPG, WEBP). Once uploaded, the system will wait for client approval."}
            </p>
          </div>
          {isReuploadingSalesOffer && (
            <Button
              type="button"
              variant="ghost"
              size="sm"
              className="text-xs text-gray-500 hover:text-gray-700 h-8 px-2 cursor-pointer"
              onClick={() => {
                setIsReuploadingSalesOffer(false);
                setSalesOfferFile(null);
              }}
            >
              {isAr ? "إلغاء" : "Cancel"}
            </Button>
          )}
        </div>

        <input
          type="file"
          id="salesOfferUpload"
          className="hidden"
          accept="image/png,image/jpeg,image/jpg,image/webp"
          multiple={false}
          onChange={(e) => {
            const file = e.target.files?.[0];
            if (file) {
              if (!file.type.startsWith("image/")) {
                toast.error(
                  isAr
                    ? "يرجى اختيار صورة فقط بصيغة PNG أو JPG أو WEBP"
                    : "Please select an image file only (PNG, JPG, WEBP)"
                );
                e.target.value = "";
                return;
              }
              if (file.size > 5 * 1024 * 1024) {
                toast.error(
                  isAr
                    ? "حجم الصورة كبير جداً، الحد الأقصى 5 ميجابايت"
                    : "Image size is too large (max 5MB)"
                );
                e.target.value = "";
                return;
              }
              setSalesOfferFile(file);
              setIsReuploadingSalesOffer(true);
            }
            e.target.value = "";
          }}
        />
        <label
          htmlFor="salesOfferUpload"
          className="flex items-center justify-center gap-2 p-4 border-2 border-dashed border-teal-300 bg-white rounded-lg cursor-pointer hover:border-teal-500 hover:bg-teal-50/50 transition-colors"
        >
          {salesOfferImagePreview ? (
            <div className="relative flex flex-col items-center justify-center w-full py-2">
              <div className="relative group max-w-sm">
                <img
                  src={salesOfferImagePreview}
                  alt="Sales Offer Preview"
                  className="max-h-52 max-w-full rounded-lg object-contain border border-teal-200 shadow-sm"
                />
                <button
                  type="button"
                  onClick={(e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    setSalesOfferFile(null);
                  }}
                  className="absolute -top-2 -right-2 p-1.5 bg-red-600 hover:bg-red-700 text-white rounded-full shadow-md cursor-pointer"
                  title={isAr ? "حذف" : "Remove"}
                >
                  <X className="h-3.5 w-3.5" />
                </button>
              </div>
              <div className="flex items-center gap-2 mt-2 text-xs text-teal-900 font-medium">
                <span>{salesOfferFile?.name}</span>
                <span className="text-gray-400">
                  ({(salesOfferFile?.size ? salesOfferFile.size / 1024 : 0).toFixed(1)} KB)
                </span>
              </div>
            </div>
          ) : (
            <div className="text-center py-2">
              <ImageIcon className="h-8 w-8 text-teal-600 mx-auto mb-1.5" />
              <span className="text-sm font-semibold text-gray-800 block">
                {isAr ? "اضغط لاختيار صورة عرض المبيعات" : "Click to select sales offer image"}
              </span>
              <span className="text-xs text-gray-500 mt-1 block">
                {isAr
                  ? "صورة واحدة فقط (PNG, JPG, WEBP) بحد أقصى 5 ميجابايت"
                  : "Single image only (PNG, JPG, WEBP) — max 5 MB"}
              </span>
            </div>
          )}
        </label>

        <div className="space-y-1">
          <label className="text-xs font-medium text-gray-700 block">
            {t("reservations.approveDialog.commentsLabel")}
          </label>
          <textarea
            className="w-full min-h-[60px] p-2.5 text-xs bg-white border border-gray-200 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent outline-none resize-y"
            placeholder={t("reservations.uploadOfferDialog.commentsPlaceholder")}
            value={adminComment}
            onChange={(e) => setAdminComment(e.target.value)}
          />
        </div>

        <Button
          className="w-full bg-teal-600 hover:bg-teal-700 text-white font-medium shadow-xs cursor-pointer"
          onClick={() => {
            handleSalesOfferUpload();
            setIsReuploadingSalesOffer(false);
          }}
          disabled={!salesOfferFile || uploadSalesOfferMutation.isPending}
        >
          {uploadSalesOfferMutation.isPending ? (
            <>
              <Loader2 className="h-4 w-4 mr-2 animate-spin" />
              {t("reservations.actions.uploading")}
            </>
          ) : (
            <>
              <Upload className="h-4 w-4 mr-2" />
              {isAr ? "رفع صورة عرض المبيعات" : "Upload Sales Offer Image"}
            </>
          )}
        </Button>
      </div>
    );
  }

  return (
    <div className="mt-3 space-y-3">
      {/* Waiting / Locked banner */}
      <div
        className={`p-4 rounded-xl border flex flex-col gap-2 ${
          stage.currentStatusType === "sales_offer_approval"
            ? "bg-blue-50/70 border-blue-200/80"
            : "bg-amber-50/70 border-amber-200/80"
        }`}
      >
        <div className="flex items-start gap-3">
          <div
            className={`w-9 h-9 rounded-full flex items-center justify-center shrink-0 mt-0.5 border ${
              stage.currentStatusType === "sales_offer_approval"
                ? "bg-blue-100 border-blue-300"
                : "bg-amber-100 border-amber-300"
            }`}
          >
            <Clock
              className={`h-4 w-4 animate-pulse ${
                stage.currentStatusType === "sales_offer_approval" ? "text-blue-600" : "text-amber-700"
              }`}
            />
          </div>
          <div className="flex-1">
            <div className="flex items-center gap-2 flex-wrap">
              <p
                className={`text-xs font-bold uppercase tracking-wider ${
                  stage.currentStatusType === "sales_offer_approval" ? "text-blue-900" : "text-amber-900"
                }`}
              >
                {stage.currentStatusType === "sales_offer_approval"
                  ? isAr
                    ? "في انتظار قبول العميل للعرض"
                    : "Waiting for Client to Accept the Offer"
                  : isAr
                  ? "في انتظار موافقة العميل"
                  : "Waiting for Client Approval"}
              </p>
              <Badge
                className={`text-[10px] px-2 py-0.5 font-semibold ${
                  stage.currentStatusType === "sales_offer_approval"
                    ? "bg-blue-100 text-blue-800 border-blue-300"
                    : "bg-amber-100 text-amber-800 border-amber-300"
                }`}
              >
                {stage.currentStatusType === "sales_offer_approval"
                  ? isAr
                    ? "بانتظار القبول"
                    : "Awaiting Acceptance"
                  : isAr
                  ? "قيد الانتظار"
                  : "Pending Approval"}
              </Badge>
              {stage.currentStatusType === "sales_offer_approval" && (
                <Badge className="bg-gray-100 text-gray-600 border-gray-300 text-[10px] px-2 py-0.5 font-semibold">
                  🔒 {isAr ? "مقفل" : "Locked"}
                </Badge>
              )}
            </div>
            <p
              className={`text-xs mt-1 leading-relaxed ${
                stage.currentStatusType === "sales_offer_approval" ? "text-blue-800" : "text-amber-800"
              }`}
            >
              {stage.currentStatusType === "sales_offer_approval"
                ? isAr
                  ? "تم رفع العرض وإرساله للعميل. لا يمكن تعديل الصورة الآن. في انتظار قبول العميل للمتابعة إلى مرحلة الدفعة الأولى."
                  : "The offer has been uploaded and sent to the client. No changes allowed at this stage. Waiting for the client to accept and proceed to down payment."
                : isAr
                ? "تم رفع صورة عرض المبيعات بنجاح. في انتظار موافقة العميل على العرض للانتقال إلى مرحلة الدفعة الأولى."
                : "Sales offer image uploaded successfully. Waiting for the client to approve the offer before moving to down payment."}
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}
