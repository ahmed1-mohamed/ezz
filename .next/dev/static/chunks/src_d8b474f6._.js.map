"use client";

import React from "react";
import { SearchInput } from "@/components/shared/SearchInput";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { useRolesSelect } from "@/hooks/use-roles-select";
import { useLanguage } from "@/contexts/LanguageContext";

interface UsersFiltersProps {
  searchQuery: string;
  onSearchChange: (value: string) => void;
  statusFilter: string;
  onStatusChange: (value: string) => void;
  roleFilter: string;
  onRoleChange: (value: string) => void;
}

export const UsersFilters = React.memo(function UsersFilters({
  searchQuery,
  onSearchChange,
  statusFilter,
  onStatusChange,
  roleFilter,
  onRoleChange,
}: UsersFiltersProps) {
  const { roles } = useRolesSelect();
  const { t } = useLanguage();

  return (
    <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 w-full">
      {/* Search Input */}
      <div className="flex-1 min-w-[240px] max-w-xl">
        <SearchInput
          value={searchQuery}
          onChange={onSearchChange}
          placeholder={t("users.filters.search") || "Search for users"}
          className="w-full"
        />
      </div>

      {/* Role and Status Selects */}
      <div className="grid grid-cols-2 sm:flex sm:items-center gap-2 w-full sm:w-auto">
        <Select value={roleFilter} onValueChange={onRoleChange}>
          <SelectTrigger className="w-full sm:w-[150px] lg:w-[170px] h-9 text-xs bg-white dark:bg-neutral-900 border-gray-200 dark:border-neutral-800 text-gray-700 dark:text-gray-200">
            <SelectValue placeholder={t("users.columns.role") || "User Role"} />
          </SelectTrigger>
          <SelectContent className="bg-white dark:bg-neutral-900 border-gray-200 dark:border-neutral-800">
            <SelectItem value="all" className="cursor-pointer dark:text-gray-200 dark:hover:bg-neutral-800">
              {t("users.filters.allRoles") || "All Roles"}
            </SelectItem>
            {Array.isArray(roles) &&
              roles.map((role: any) => {
                const rId = role.role_id ?? role.id;
                const rName = role.role_name ?? role.name;
                return (
                  <SelectItem
                    key={rId}
                    value={String(rId)}
                    className="cursor-pointer dark:text-gray-200 dark:hover:bg-neutral-800"
                  >
                    {rName}
                  </SelectItem>
                );
              })}
          </SelectContent>
        </Select>

        <Select value={statusFilter} onValueChange={onStatusChange}>
          <SelectTrigger className="w-full sm:w-[150px] lg:w-[170px] h-9 text-xs bg-white dark:bg-neutral-900 border-gray-200 dark:border-neutral-800 text-gray-700 dark:text-gray-200">
            <SelectValue placeholder={t("users.columns.status") || "Status"} />
          </SelectTrigger>
          <SelectContent className="bg-white dark:bg-neutral-900 border-gray-200 dark:border-neutral-800">
            <SelectItem value="all" className="cursor-pointer dark:text-gray-200 dark:hover:bg-neutral-800">
              {t("users.filters.allStatus") || "All Status"}
            </SelectItem>
            <SelectItem value="Active" className="cursor-pointer dark:text-gray-200 dark:hover:bg-neutral-800">
              {t("users.filters.active") || "Active"}
            </SelectItem>
            <SelectItem value="Inactive" className="cursor-pointer dark:text-gray-200 dark:hover:bg-neutral-800">
              {t("users.filters.inactive") || "Inactive"}
            </SelectItem>
            <SelectItem value="Suspended" className="cursor-pointer dark:text-gray-200 dark:hover:bg-neutral-800">
              {t("users.filters.suspended") || "Suspended"}
            </SelectItem>
          </SelectContent>
        </Select>
      </div>
    </div>
  );
});
