"use client";

import { useEffect, useState, useCallback, useMemo } from "react";
import { useForm, Controller } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { useQuery, useQueryClient } from "@tanstack/react-query";
import { useSession } from "next-auth/react";
import { Modal } from "@/components/ui/modal";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { toast } from "sonner";
import { AdminUsersService } from "@/features/users/services/AdminUsersService";
import { editNewUserSchema, type EditNewUserInput } from "@/validators/edit-new-user.schema";
import { useLanguage } from "@/contexts/LanguageContext";
import { handleServerValidationError, getErrorMessage } from "@/lib/form-utils";
import { FormProvider } from "react-hook-form";
import { useCountriesSelect } from "@/hooks/use-countries-select";
import { useDevelopersSelect } from "@/hooks/use-developers-select";
import { DeveloperFields } from "./components/DeveloperFields";

interface EditUserModalProps {
  isOpen: boolean;
  onClose: () => void;
  userId: number;
  onSuccess?: () => void;
}

export function EditUserModal({
  isOpen,
  onClose,
  userId,
  onSuccess,
}: EditUserModalProps) {
  const { data: session } = useSession();
  const token = session?.user?.accessToken;
  const queryClient = useQueryClient();
  const { t } = useLanguage();
  const [isSubmitting, setIsSubmitting] = useState(false);

  const [selectedCountryId, setSelectedCountryId] = useState<number | undefined>();
  const { countries, isLoading: countriesLoading } = useCountriesSelect();
  const { developers, isLoading: developersLoading } = useDevelopersSelect(selectedCountryId);

  const methods = useForm<EditNewUserInput>({
    resolver: zodResolver(editNewUserSchema),
    defaultValues: {
      first_name: "",
      last_name: "",
      email: "",
      phone_number: "+",
      status: "active",
      role_name: "Admin",
      user_type: "expert",
      developer_id: undefined,
      developer_role: "",
    },
  });

  const {
    register,
    handleSubmit,
    reset,
    control,
    setValue,
    setError,
    watch,
    formState: { errors },
  } = methods;

  const { data: userData, isLoading: userLoading } = useQuery({
    queryKey: ["user-detail", userId],
    queryFn: () => AdminUsersService.getUser(userId),
    enabled: !!token && userId != null && isOpen,
  });
  const { data: rolesData = [] } = useQuery({
    queryKey: ["roles"],
    queryFn: () => AdminUsersService.getRoles(),
    enabled: !!token && isOpen,
  });
  const roles = Array.isArray(rolesData)
    ? rolesData
    : (rolesData as { data?: unknown[] }).data ?? [];

  useEffect(() => {
    if (!userData) return;
    const responsePayload = (userData as unknown as { data?: any })?.data;
    const user = responsePayload?.data ? responsePayload.data : responsePayload;
    if (!user) return;
    const u = user as Record<string, unknown>;

    const currentUserType = String(
      (u.user_type as string) ||
      ""
    ).toLowerCase();

    let exactRoleName = "";
    if (u.role && (u.role as any).role_name) {
      exactRoleName = (u.role as any).role_name;
    } else if (u.role_name) {
      exactRoleName = u.role_name as string;
    } else {
      // Fallback if missing
      if (currentUserType === "expert") exactRoleName = "Expert";
      else if (currentUserType === "developer") exactRoleName = "Developer";
      else exactRoleName = "Admin";
    }

    reset({
      first_name: (u.first_name as string) ?? "",
      last_name: (u.last_name as string) ?? "",
      email: (u.email as string) ?? "",
      phone_number: (u.phone_number as string)
        ? ((u.phone_number as string).startsWith("+")
          ? (u.phone_number as string)
          : "+" + (u.phone_number as string))
        : "+",
      status: (u.status as "active" | "inactive" | "banned") ?? "active",
      role_name: exactRoleName,
      user_type: currentUserType || "expert",
      developer_id: u.developer_id ? Number(u.developer_id) : undefined,
      developer_role: (u.developer_role as string) ?? "",
    });
  }, [userData, reset]);

  const handleClose = useCallback(() => {
    reset();
    onClose();
  }, [reset, onClose]);

  const onSubmit = async (formValues: EditNewUserInput) => {
    if (!userId) return;
    setIsSubmitting(true);
    try {
      const payload: Record<string, unknown> = {
        first_name: formValues.first_name,
        last_name: formValues.last_name,
        email: formValues.email,
        phone_number: formValues.phone_number,
        status: formValues.status,
        user_type: formValues.user_type || "expert",
        role_name: formValues.role_name || "Expert",
      };

      if (payload.user_type === "developer") {
        payload.developer_id = formValues.developer_id;
        payload.developer_role = formValues.developer_role;
      }

      const rolesList = Array.isArray(roles) ? roles : [];
      const selectedRoleName = (formValues.role_name || "Expert").toLowerCase();
      const matchedRole = rolesList.find((r: any) =>
        (r.role_name ?? r.name)?.toLowerCase() === selectedRoleName
      );

      if (matchedRole) {
        payload.role_id = matchedRole.role_id ?? matchedRole.id;
        payload.role_name = matchedRole.role_name ?? matchedRole.name;
        payload.role_type = matchedRole.role_type ?? matchedRole.type;
      }

      await AdminUsersService.updateUser(userId, payload);
      toast.success(t("users.messages.updateSuccess") || "User updated successfully");
      await queryClient.invalidateQueries({ queryKey: ["users"] });
      await queryClient.refetchQueries({ queryKey: ["users"] });
      await queryClient.invalidateQueries({ queryKey: ["user-detail", userId] });
      await queryClient.invalidateQueries({ queryKey: ["userDetails", userId] });
      handleClose();
      onSuccess?.();
    } catch (error) {
      handleServerValidationError(error, setError);
      const errorMessage = getErrorMessage(error);
      toast.error(errorMessage);
    } finally {
      setIsSubmitting(false);
    }
  };
  const onInvalidForm = () => {
    toast.error(t("validation.fillRequiredFields") || "Please fill in all required fields correctly.");
  };
  return (
    <Modal
      isOpen={isOpen}
      onClose={handleClose}
      title={t("users.editUser") || "Edit User"}
      size="md"
      showCloseButton={false}
      footer={
        <div className="flex gap-3 justify-end w-full">
          <Button variant="outline" onClick={handleClose} disabled={isSubmitting}>
            {t("users.cancel") || "Cancel"}
          </Button>
          <Button
            className="bg-teal-600 hover:bg-teal-700 text-white"
            onClick={handleSubmit(onSubmit, onInvalidForm)}
            disabled={isSubmitting || userLoading}
          >
            {isSubmitting
              ? t("users.addModal.updating") || "Updating..."
              : t("users.editUser") || "Update User"}
          </Button>
        </div>
      }
    >
      {userLoading ? (
        <div className="flex items-center justify-center py-12">
          <div className="text-center">
            <div className="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-teal-600 border-r-transparent" />
            <p className="mt-4 text-sm text-gray-600">{t("users.loading") || "Loading user data..."}</p>
          </div>
        </div>
      ) : (
        <FormProvider {...methods}>
          <form onSubmit={handleSubmit(onSubmit, onInvalidForm)} className="space-y-5">
            <div className="grid grid-cols-2 gap-4">
              <div>
                <Label htmlFor="edit-first-name">
                  {t("users.addModal.firstName") || "First name"} <span className="text-red-500">*</span>
                </Label>
                <Input
                  id="edit-first-name"
                  placeholder={t("users.addModal.firstNamePlaceholder") || "e.g. Bonnie"}
                  {...register("first_name")}
                  className="mt-1"
                  error={!!errors.first_name}
                />
                {errors.first_name && (
                  <p className="text-xs text-red-500 mt-1">{t(errors.first_name.message || "")}</p>
                )}
              </div>
              <div>
                <Label htmlFor="edit-last-name">
                  {t("users.addModal.lastName") || "Last name"} <span className="text-red-500">*</span>
                </Label>
                <Input
                  id="edit-last-name"
                  placeholder={t("users.addModal.lastNamePlaceholder") || "e.g. Green"}
                  {...register("last_name")}
                  className="mt-1"
                  error={!!errors.last_name}
                />
                {errors.last_name && (
                  <p className="text-xs text-red-500 mt-1">{t(errors.last_name.message || "")}</p>
                )}
              </div>
            </div>

            <div>
              <Label htmlFor="edit-user-email">
                {t("users.addModal.email") || "Email address"} <span className="text-red-500">*</span>
              </Label>
              <Input
                id="edit-user-email"
                type="email"
                placeholder={t("users.addModal.emailPlaceholder") || "e.g. name@company.com"}
                {...register("email")}
                className="mt-1"
                error={!!errors.email}
              />
              {errors.email && (
                <p className="text-xs text-red-500 mt-1">{t(errors.email.message || "")}</p>
              )}
            </div>

            <div>
              <Label htmlFor="edit-user-phone">{t("users.addModal.phoneNumber") || "Phone number"}</Label>
              <Input
                id="edit-user-phone"
                type="tel"
                placeholder={t("users.addModal.phoneNumberPlaceholder") || "+1 234 567 890"}
                {...register("phone_number", {
                  onChange: (e) => {
                    let val = e.target.value;
                    if (!val.startsWith("+")) {
                      val = "+" + val.replace(/\+/g, "");
                    } else {
                      val = "+" + val.slice(1).replace(/\+/g, "");
                    }
                    setValue("phone_number", val);
                  }
                })}
                className="mt-1"
                error={!!errors.phone_number}
              />
              {errors.phone_number && (
                <p className="text-xs text-red-500 mt-1">{t(errors.phone_number.message || "")}</p>
              )}
            </div>

            <div className="grid grid-cols-2 gap-4">
              <div>
                <Label htmlFor="edit-user-type">{t("users.addModal.userType") || "User Type"}</Label>
                <Controller
                  name="user_type"
                  control={control}
                  render={({ field }) => (
                    <Select
                      key={`type-${field.value || "empty"}`}
                      value={field.value || ""}
                      onValueChange={(val) => field.onChange(val)}
                    >
                      <SelectTrigger className="mt-1" error={!!errors.user_type}>
                        <SelectValue placeholder={t("users.addModal.selectUserType") || "Select User Type"} />
                      </SelectTrigger>
                      <SelectContent>
                        <SelectItem value="admin">Admin</SelectItem>
                        <SelectItem value="developer">Developer</SelectItem>
                        <SelectItem value="expert">Expert</SelectItem>
                      </SelectContent>
                    </Select>
                  )}
                />
                {errors.user_type && (
                  <p className="text-xs text-red-500 mt-1">{t(errors.user_type.message || "")}</p>
                )}
              </div>
              <div>
                <Label htmlFor="edit-user-role">{t("users.addModal.role") || "Role"}</Label>
                <Controller
                  name="role_name"
                  control={control}
                  render={({ field }) => (
                    <Select
                      key={`role-${field.value || "empty"}`}
                      value={field.value || ""}
                      onValueChange={(val) => field.onChange(val)}
                    >
                      <SelectTrigger className="mt-1" error={!!errors.role_name}>
                        <SelectValue placeholder={t("users.addModal.selectRole") || "Select Role"} />
                      </SelectTrigger>
                      <SelectContent>
                        {(() => {
                          const filteredRoles = roles.filter((role: any) => {
                            const name = String(role.role_name ?? role.name ?? "").toLowerCase();
                            const type = String(role.role_type ?? role.type ?? "").toLowerCase();
                            return (
                              name.includes("admin") ||
                              name.includes("developer") ||
                              name.includes("expert") ||
                              type.includes("admin") ||
                              type.includes("developer") ||
                              type.includes("expert")
                            );
                          });

                          const hasExpertName = filteredRoles.some((role: any) => {
                            const name = String(role.role_name ?? role.name ?? "").toLowerCase();
                            return name.includes("expert");
                          });

                          const roleItems = filteredRoles.map((role: any) => {
                            const rName = role.role_name ?? role.name;
                            return (
                              <SelectItem key={rName} value={rName}>
                                {rName}
                              </SelectItem>
                            );
                          });

                          if (!hasExpertName) {
                            roleItems.push(
                              <SelectItem key="fallback-expert" value="Expert">
                                Expert
                              </SelectItem>
                            );
                          }

                          return roleItems;
                        })()}
                      </SelectContent>
                    </Select>
                  )}
                />
                {errors.role_name && (
                  <p className="text-xs text-red-500 mt-1">{t(errors.role_name.message || "")}</p>
                )}
              </div>
            </div>

            <div>
              <Label htmlFor="edit-user-status">{t("users.columns.status") || "Status"}</Label>
              <Controller
                name="status"
                control={control}
                render={({ field }) => (
                  <Select key={`status-${field.value || "empty"}`} value={field.value} onValueChange={field.onChange}>
                    <SelectTrigger className="mt-1">
                      <SelectValue placeholder={t("users.addModal.selectStatus") || "Select Status"} />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="active">{t("common.active") || "Active"}</SelectItem>
                      <SelectItem value="inactive">{t("common.inactive") || "Inactive"}</SelectItem>
                      <SelectItem value="banned">{t("users.filters.suspended") || "Banned"}</SelectItem>
                    </SelectContent>
                  </Select>
                )}
              />
            </div>

            {errors.root && (
              <p className="text-xs text-red-500 mt-1">{t(errors.root.message || "")}</p>
            )}

            {watch("user_type") === "developer" && (
              <DeveloperFields
                countries={countries}
                countriesLoading={countriesLoading}
                selectedCountryId={selectedCountryId}
                setSelectedCountryId={setSelectedCountryId}
                developers={developers}
                developersLoading={developersLoading}
                developerRoleOptions={[
                  { label: t("users.addModal.developerRoleAdmin") || "Admin", value: "developer_admin" },
                  { label: t("users.addModal.developerRoleAgent") || "Agent", value: "developer_agent" },
                ]}
              />
            )}

          </form>
        </FormProvider>
      )}
    </Modal>
  );
}