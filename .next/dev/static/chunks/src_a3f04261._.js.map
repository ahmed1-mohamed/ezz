"use client";

import type { FieldErrors } from "react-hook-form";
import { FieldError } from "@/components/ui/form-message";
import { useLanguage } from "@/contexts/LanguageContext";
import type { FormValues } from "@/validators/developerSchema";

const SEO_FIELDS = [
  { name: "slug", label: "common.seo.slug" },
  { name: "meta_title", label: "common.seo.metaTitle" },
  { name: "meta_description", label: "common.seo.metaDescription" },
] as const;

/**
 * Validation messages for the SEO fields. The shared SeoFieldsSection doesn't render field
 * errors, so the developer modals show them below it, prefixed with the field's label.
 */
export function DeveloperSeoErrors({ errors }: { errors: FieldErrors<FormValues> }) {
  const { t } = useLanguage();
  const items = SEO_FIELDS.filter(({ name }) => !!errors[name]?.message);
  if (items.length === 0) return null;
  return (
    <div className="-mt-3 space-y-1">
      {items.map(({ name, label }) => (
        <FieldError key={name} message={`${t(label)}: ${errors[name]?.message}`} />
      ))}
    </div>
  );
}
