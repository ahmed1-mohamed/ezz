"use client";

import {
  useQuery,
  useMutation,
  useQueryClient,
  keepPreviousData,
} from "@tanstack/react-query";
import { useSession } from "next-auth/react";
import { toast } from "sonner";
import { AdminBookingsService } from "@/data/api-client";
import { getErrorMessage } from "@/lib/apiClient";
import { unpackReservationsResponse, mapReservation } from "@/features/reservations/utils/map-reservation";
import { useMemo } from "react";
import { useLanguage } from "@/contexts/LanguageContext";

interface BookingFilters {
  page?: number;
  perPage?: number;
  search?: string;
  country?: string;
  status?: string;
  type?: string;
  expiryDate?: string;
}

interface ApiError {
  response?: {
    data?: {
      message?: string;
    };
  };
  message?: string;
}

export default function useDashboardAdminBookingsData(
  filters: BookingFilters = {},
) {
  const { data: session } = useSession();
  const token = session?.user?.accessToken;
  const queryClient = useQueryClient();
  const { t } = useLanguage();

  const {
    page = 1,
    perPage = 10,
    search,
    country,
    status,
    type,
    expiryDate,
  } = filters;

  const bookingsData = useQuery({
    queryKey: [
      "bookings",
      page,
      perPage,
      search,
      country,
      status,
      type,
      expiryDate,
    ],
    queryFn: () =>
      AdminBookingsService.getBookings(page, perPage, {
        country,
        status,
        type,
        expiryDate,
        search,
      }),
    retry: false,
    enabled: !!token,
    staleTime: 5 * 60 * 1000,
    placeholderData: keepPreviousData,
  });

  const confirmMutation = useMutation({
    mutationFn: async (bookingId: number) => {
      await AdminBookingsService.confirmBooking(bookingId);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["bookings"] });
      toast.success(t("reservations.messages.approveSuccess"));
    },
    onError: (error: any) => {
      console.error("Confirm booking error:", error?.response?.data || error);
      toast.error(getErrorMessage(error, t("reservations.messages.approveFailed")));
    },
  });

  const declineMutation = useMutation({
    mutationFn: async (bookingId: number) => {
      await AdminBookingsService.declineBooking(bookingId);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["bookings"] });
      toast.success(t("reservations.messages.declineSuccess"));
    },
    onError: (error: any) => {
      console.error("Decline booking error:", error?.response?.data || error);
      toast.error(getErrorMessage(error, t("reservations.messages.declineFailed")));
    },
  });

  const { itemsArray, totalItems, currentPage, lastPage, perPage: responsePerPage } = useMemo(() => {
    return unpackReservationsResponse(bookingsData.data);
  }, [bookingsData.data]);

  const paginatedBookings = useMemo(() => itemsArray.map(mapReservation), [itemsArray]);

  return {
    bookingsData,
    bookings: paginatedBookings,
    totalBookings: totalItems,
    currentPage,
    lastPage,
    perPage: responsePerPage,
    handleConfirm: confirmMutation.mutate,
    handleDecline: declineMutation.mutate,
    isConfirming: confirmMutation.isPending,
    isDeclining: declineMutation.isPending,
  };
}
