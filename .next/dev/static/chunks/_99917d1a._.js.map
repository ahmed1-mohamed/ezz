"use client";

import React, { createContext, useContext, useEffect, useCallback, useTransition } from "react";
import { useLocale, useTranslations, useMessages } from "next-intl";
import { setUserLocale } from "@/i18n/locale";
import enMessages from "../../messages/en.json";
import arMessages from "../../messages/ar.json";

type Language = "en" | "ar";

const staticMessages: Record<Language, any> = {
  en: enMessages,
  ar: arMessages,
};

interface LanguageContextType {
  language: Language;
  toggleLanguage: () => void;
  t: (key: string, values?: Record<string, string | number>) => string;
}

const LanguageContext = createContext<LanguageContextType | undefined>(undefined);

function getNestedValue(obj: any, path: string): string | undefined {
  if (!obj || typeof obj !== "object") return undefined;
  const parts = path.split(".");
  let curr = obj;
  for (const part of parts) {
    if (curr && typeof curr === "object" && part in curr) {
      curr = curr[part];
    } else {
      return undefined;
    }
  }
  return typeof curr === "string" ? curr : undefined;
}

function interpolate(text: string, values?: Record<string, string | number>): string {
  if (!values) return text;
  return Object.entries(values).reduce(
    (acc, [k, v]) => acc.replace(new RegExp(`\\{${k}\\}`, "g"), String(v)),
    text
  );
}

export function LanguageProvider({ children }: { children: React.ReactNode }) {
  const currentLocale = (useLocale() as Language) || "en";
  const tNextIntl = useTranslations();
  const contextMessages = useMessages();
  const [, startTransition] = useTransition();

  const language = currentLocale;

  useEffect(() => {
    document.documentElement.dir = language === "ar" ? "rtl" : "ltr";
    document.documentElement.lang = language;
    localStorage.setItem("app_lang", language);
  }, [language]);

  const toggleLanguage = useCallback(() => {
    const nextLang: Language = language === "en" ? "ar" : "en";
    document.documentElement.dir = nextLang === "ar" ? "rtl" : "ltr";
    document.documentElement.lang = nextLang;
    localStorage.setItem("app_lang", nextLang);

    startTransition(() => {
      setUserLocale(nextLang);
    });
  }, [language]);

  const t = useCallback(
    (key: string, values?: Record<string, string | number>): string => {
      if (!key) return "";

      // 1. Try resolving nested key from next-intl context messages
      const fromContext = getNestedValue(contextMessages, key);
      if (typeof fromContext === "string") {
        return interpolate(fromContext, values);
      }

      // 2. Try resolving from static locale messages
      const activeStatic = staticMessages[language] || staticMessages.en;
      const fromStatic = getNestedValue(activeStatic, key);
      if (typeof fromStatic === "string") {
        return interpolate(fromStatic, values);
      }

      // 3. Fallback to next-intl t()
      try {
        const res = tNextIntl(key as any, values as any);
        if (typeof res === "string" && res !== key) {
          return res;
        }
      } catch {}

      // 4. Fallback to English static messages
      const fromEnStatic = getNestedValue(staticMessages.en, key);
      if (typeof fromEnStatic === "string") {
        return interpolate(fromEnStatic, values);
      }

      return key;
    },
    [language, contextMessages, tNextIntl]
  );

  return (
    <LanguageContext.Provider value={{ language, toggleLanguage, t }}>
      {children}
    </LanguageContext.Provider>
  );
}

export function useLanguage() {
  const context = useContext(LanguageContext);
  if (context === undefined) {
    throw new Error("useLanguage must be used within a LanguageProvider");
  }
  return context;
}