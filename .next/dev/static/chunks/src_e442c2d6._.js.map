import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  DropdownMenu,
  DropdownMenuCheckboxItem,
  DropdownMenuContent,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";
import { Button } from "@/components/ui/button";
import {
  ChevronDown,
  Calendar,
  Layers,
  Clock,
  Sparkles,
  AlertCircle,
} from "lucide-react";
import { useFormContext, useWatch } from "react-hook-form";
import { useLanguage } from "@/contexts/LanguageContext";

const LOCATIONS = [
  { value: "home", key: "ads.createStepOne.locHome", defaultLabel: "Home Page (home)" },
  { value: "home_top", key: "ads.createStepOne.locHomeTop", defaultLabel: "Home Top (home_top)" },
  { value: "home_bottom", key: "ads.createStepOne.locHomeBottom", defaultLabel: "Home Bottom (home_bottom)" },
  { value: "featured_cards", key: "ads.createStepOne.locFeaturedCards", defaultLabel: "Featured Cards (featured_cards)" },
  { value: "project_listing", key: "ads.createStepOne.locProjectListing", defaultLabel: "Project Listing (project_listing)" },
  { value: "unit_listing", key: "ads.createStepOne.locUnitListing", defaultLabel: "Unit Listing (unit_listing)" },
  { value: "developer_listing", key: "ads.createStepOne.locDeveloperListing", defaultLabel: "Developer Listing (developer_listing)" },
  { value: "expert_listing", key: "ads.createStepOne.locExpertListing", defaultLabel: "Expert Listing (expert_listing)" },
  { value: "podcast_listing", key: "ads.createStepOne.locPodcastListing", defaultLabel: "Podcast Listing (podcast_listing)" },
];

interface StepOneProps {
  dateErrors: {
    startDate?: string;
    endDate?: string;
    general?: string;
  };
  validateDateTimeRange: (start: string, end: string) => void;
}

export function CreateAdStepOne({ dateErrors, validateDateTimeRange }: StepOneProps) {
  const { t, language } = useLanguage();
  const isAr = language === "ar";
  const { register, setValue, clearErrors, control, formState: { errors } } = useFormContext();

  const type = useWatch({ control, name: "type" }) || "banner";
  const platform = useWatch({ control, name: "platform" }) || "web";
  const width = useWatch({ control, name: "width" }) || "medium";
  const position = useWatch({ control, name: "position" }) || "bottom_right";
  const selectedLocations = (useWatch({ control, name: "location" }) || []) as string[];
  const country = useWatch({ control, name: "country" });
  const status = useWatch({ control, name: "status" }) || "draft";
  const billing_unit = useWatch({ control, name: "billing_unit" }) || "impression";
  const startDate = useWatch({ control, name: "startDate" });
  const endDate = useWatch({ control, name: "endDate" });

  const toggleLocation = (loc: string) => {
    const current = Array.isArray(selectedLocations) ? selectedLocations : [];
    const updated = current.includes(loc)
      ? current.filter((l) => l !== loc)
      : [...current, loc];
    setValue("location", updated, { shouldDirty: true, shouldTouch: true, shouldValidate: true });
    if (updated.length > 0) {
      clearErrors("location");
    }
  };

  const getLocationLabel = (locValue: string) => {
    const norm = locValue?.toLowerCase().replace(/\s+/g, "_");
    const found = LOCATIONS.find(
      (l) => l.value.toLowerCase() === norm || l.defaultLabel.toLowerCase() === locValue.toLowerCase()
    );
    if (found) {
      const translated = t(found.key);
      return translated && translated !== found.key ? translated : found.defaultLabel;
    }
    return locValue;
  };

  return (
    <div className="space-y-4">
      {/* Section 1: Campaign Overview */}
      <div className="bg-neutral-50/60 dark:bg-neutral-900/40 rounded-xl p-4 sm:p-5 border border-neutral-200/80 dark:border-neutral-800 space-y-4">
        <div className="flex items-center gap-2 pb-2 border-b border-neutral-200/60 dark:border-neutral-800">
          <Sparkles className="h-4 w-4 text-teal-600 dark:text-teal-400" />
          <h3 className="text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200">
            {t("ads.createStepOne.campaignOverview") || (isAr ? "نظرة عامة على الحملة" : "Campaign Overview")}
          </h3>
        </div>

        <div>
          <Label className="flex items-center justify-between text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5">
            <span>
              {t("ads.createStepOne.adTitle") || (isAr ? "عنوان الإعلان" : "Ad Title")} <span className="text-red-500">*</span>
            </span>
            <span className="text-[11px] text-neutral-400 font-normal">
              {t("ads.createStepOne.adTitleHint") || (isAr ? "المعرف الداخلي والعام" : "Internal & public identifier")}
            </span>
          </Label>
          <Input
            placeholder={t("ads.createStepOne.adTitlePlaceholder") || (isAr ? "مثال: فلل فاخرة على شاطئ البحر" : "e.g., Luxury Beachfront Villas")}
            {...register("title", {
              required: t("ads.createStepOne.adTitleRequired") || (isAr ? "عنوان الإعلان مطلوب" : "Ad Title is required"),
              minLength: { value: 2, message: t("ads.createStepOne.adTitleMinLength") || (isAr ? "يجب ألا يقل العنوان عن حرفين" : "Title must be at least 2 characters") },
            })}
            className={`bg-white dark:bg-neutral-900 h-9 text-xs sm:text-sm ${errors.title
              ? "border-red-500 focus-visible:ring-red-500"
              : "border-neutral-200 dark:border-neutral-700 focus:border-teal-500/80 focus:ring-1 focus:ring-teal-500/30"
              }`}
          />
          {errors.title && (
            <p className="text-xs text-red-500 mt-1 flex items-center gap-1 font-medium">
              <AlertCircle className="h-3 w-3" />
              {String(errors.title.message || (isAr ? "عنوان الإعلان مطلوب" : "Ad Title is required"))}
            </p>
          )}
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1">
          <div>
            <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block">
              {t("ads.createStepOne.initialStatus") || (isAr ? "الحالة الأولية" : "Initial Status")} <span className="text-red-500">*</span>
            </Label>
            <Select
              value={status}
              onValueChange={(val) => setValue("status", val, { shouldDirty: true, shouldTouch: true, shouldValidate: true })}
            >
              <SelectTrigger className="bg-white dark:bg-neutral-900 border-neutral-200 dark:border-neutral-700 h-9 text-xs">
                <SelectValue placeholder={t("ads.createStepOne.selectStatus") || (isAr ? "اختر الحالة" : "Select Status")} />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="active">{t("ads.createStepOne.statusActive") || (isAr ? "نشط" : "Active")}</SelectItem>
                <SelectItem value="draft">{t("ads.createStepOne.statusDraft") || (isAr ? "مسودة" : "Draft")}</SelectItem>
                <SelectItem value="paused">{t("ads.createStepOne.statusPaused") || (isAr ? "موقوف مؤقتاً" : "Paused")}</SelectItem>
                <SelectItem value="ended">{t("ads.createStepOne.statusEnded") || (isAr ? "منتهي" : "Ended")}</SelectItem>
              </SelectContent>
            </Select>
          </div>

          <div>
            <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block">
              {t("ads.createStepOne.priorityLevel") || (isAr ? "مستوى الأولوية (1 - 10)" : "Priority Level (1 - 10)")} <span className="text-red-500">*</span>
            </Label>
            <Input
              type="number"
              min="1"
              max="10"
              placeholder="1"
              {...register("priority", {
                required: t("ads.createStepOne.priorityRequired") || (isAr ? "الأولوية مطلوبة" : "Priority is required"),
                min: { value: 1, message: t("ads.createStepOne.priorityMin") || (isAr ? "الحد الأدنى للأولوية هو 1" : "Min priority is 1") },
                max: { value: 10, message: t("ads.createStepOne.priorityMax") || (isAr ? "الحد الأقصى للأولوية هو 10" : "Max priority is 10") },
              })}
              className={`bg-white dark:bg-neutral-900 h-9 text-xs ${errors.priority
                ? "border-red-500 focus-visible:ring-red-500"
                : "border-neutral-200 dark:border-neutral-700"
                }`}
            />
            {errors.priority && (
              <p className="text-xs text-red-500 mt-1 font-medium">
                {String(errors.priority.message || (isAr ? "يجب أن تكون الأولوية بين 1 و 10" : "Priority must be 1-10"))}
              </p>
            )}
          </div>

          <div>
            <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block">
              {t("ads.createStepOne.billingUnit") || (isAr ? "وحدة الفوترة" : "Billing Unit")} <span className="text-red-500">*</span>
            </Label>
            <Select
              value={billing_unit}
              onValueChange={(val) => setValue("billing_unit", val, { shouldDirty: true, shouldTouch: true, shouldValidate: true })}
            >
              <SelectTrigger className="bg-white dark:bg-neutral-900 border-neutral-200 dark:border-neutral-700 h-9 text-xs">
                <SelectValue placeholder={t("ads.createStepOne.selectBilling") || (isAr ? "اختر الفوترة" : "Select Billing")} />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="impression">{t("ads.createStepOne.billingImpression") || (isAr ? "الظهور (CPM)" : "Impression (CPM)")}</SelectItem>
                <SelectItem value="click">{t("ads.createStepOne.billingClick") || (isAr ? "النقرة (CPC)" : "Click (CPC)")}</SelectItem>
                <SelectItem value="view">{t("ads.createStepOne.billingView") || (isAr ? "المشاهدة (CPV)" : "View (CPV)")}</SelectItem>
                <SelectItem value="month">{t("ads.createStepOne.billingMonth") || (isAr ? "شهري ثابت" : "Monthly Flat")}</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>
      </div>

      {/* Section 2: Placement & Audience */}
      <div className="bg-neutral-50/60 dark:bg-neutral-900/40 rounded-xl p-4 sm:p-5 border border-neutral-200/80 dark:border-neutral-800 space-y-4">
        <div className="flex items-center gap-2 pb-2 border-b border-neutral-200/60 dark:border-neutral-800">
          <Layers className="h-4 w-4 text-teal-600 dark:text-teal-400" />
          <h3 className="text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200">
            {t("ads.createStepOne.placementAudience") || (isAr ? "الموضع والجمهور المستهدف" : "Placement & Audience")}
          </h3>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block">
              {t("ads.createStepOne.adFormat") || (isAr ? "تنسيق / نوع الإعلان" : "Ad Format / Type")} <span className="text-red-500">*</span>
            </Label>
            <Select
              value={type}
              onValueChange={(val) => setValue("type", val, { shouldDirty: true, shouldTouch: true, shouldValidate: true })}
            >
              <SelectTrigger className="bg-white dark:bg-neutral-900 border-neutral-200 dark:border-neutral-700 h-9 text-xs sm:text-sm">
                <SelectValue placeholder={t("ads.createStepOne.selectFormat") || (isAr ? "اختر التنسيق" : "Select Format")} />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="banner">{t("ads.createStepOne.formatBanner") || (isAr ? "بنر" : "Banner")}</SelectItem>
                <SelectItem value="card">{t("ads.createStepOne.formatCard") || (isAr ? "بطاقة" : "Card")}</SelectItem>
                <SelectItem value="pop_up">{t("ads.createStepOne.formatPopUp") || (isAr ? "نافذة منبثقة" : "Pop-up")}</SelectItem>
                <SelectItem value="full_page">{t("ads.createStepOne.formatFullPage") || (isAr ? "صفحة كاملة" : "Full Page")}</SelectItem>
              </SelectContent>
            </Select>
          </div>

          <div>
            <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block">
              {t("ads.createStepOne.targetPlatform") || (isAr ? "المنصة المستهدفة" : "Target Platform")} <span className="text-red-500">*</span>
            </Label>
            <Select
              value={platform}
              onValueChange={(val) => setValue("platform", val, { shouldDirty: true, shouldTouch: true, shouldValidate: true })}
            >
              <SelectTrigger className="bg-white dark:bg-neutral-900 border-neutral-200 dark:border-neutral-700 h-9 text-xs sm:text-sm">
                <SelectValue placeholder={t("ads.createStepOne.selectPlatform") || (isAr ? "اختر المنصة" : "Select Platform")} />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="web">{t("ads.createStepOne.platformWeb") || (isAr ? "الويب" : "Web")}</SelectItem>
                <SelectItem value="mobile">{t("ads.createStepOne.platformMobile") || (isAr ? "تطبيق الجوال" : "Mobile App")}</SelectItem>
                <SelectItem value="android">{t("ads.createStepOne.platformAndroid") || (isAr ? "تطبيق أندرويد" : "Android App")}</SelectItem>
                <SelectItem value="ios">{t("ads.createStepOne.platformIos") || (isAr ? "تطبيق آي أو إس" : "iOS App")}</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>

        {type === "pop_up" && (
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 p-3 bg-neutral-100/60 dark:bg-neutral-800/40 border border-neutral-200 dark:border-neutral-700 rounded-lg">
            <div>
              <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block">
                {t("ads.createStepOne.popUpDimensions") || (isAr ? "أبعاد النافذة المنبثقة" : "Pop-up Dimensions")}
              </Label>
              <Select
                value={width}
                onValueChange={(val) => setValue("width", val, { shouldDirty: true, shouldTouch: true, shouldValidate: true })}
              >
                <SelectTrigger className="bg-white dark:bg-neutral-900 border-neutral-200 dark:border-neutral-700 h-8 text-xs">
                  <SelectValue placeholder={t("ads.createStepOne.selectWidth") || (isAr ? "اختر العرض" : "Select Width")} />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="full_screen">{t("ads.createStepOne.dimensionFullScreen") || (isAr ? "ملء الشاشة" : "Full Screen")}</SelectItem>
                  <SelectItem value="large">{t("ads.createStepOne.dimensionLarge") || (isAr ? "كبير (600 بكسل)" : "Large (600px)")}</SelectItem>
                  <SelectItem value="medium">{t("ads.createStepOne.dimensionMedium") || (isAr ? "متوسط (450 بكسل)" : "Medium (450px)")}</SelectItem>
                  <SelectItem value="small">{t("ads.createStepOne.dimensionSmall") || (isAr ? "صغير (320 بكسل)" : "Small (320px)")}</SelectItem>
                  <SelectItem value="custom">{t("ads.createStepOne.dimensionCustom") || (isAr ? "مخصص" : "Custom")}</SelectItem>
                </SelectContent>
              </Select>
            </div>
            <div>
              <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block">
                {t("ads.createStepOne.screenPosition") || (isAr ? "موقع الظهور في الشاشة" : "Screen Position")}
              </Label>
              <Select
                value={position}
                onValueChange={(val) => setValue("position", val, { shouldDirty: true, shouldTouch: true, shouldValidate: true })}
              >
                <SelectTrigger className="bg-white dark:bg-neutral-900 border-neutral-200 dark:border-neutral-700 h-8 text-xs">
                  <SelectValue placeholder={t("ads.createStepOne.selectPosition") || (isAr ? "اختر الموضع" : "Select Position")} />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="top_center">{t("ads.createStepOne.posTopCenter") || (isAr ? "أعلى الوسط" : "Top Center")}</SelectItem>
                  <SelectItem value="middle_center">{t("ads.createStepOne.posMiddleCenter") || (isAr ? "الوسط (افتراضي)" : "Center (Default)")}</SelectItem>
                  <SelectItem value="bottom_center">{t("ads.createStepOne.posBottomCenter") || (isAr ? "أسفل الوسط" : "Bottom Banner")}</SelectItem>
                  <SelectItem value="bottom_right">{t("ads.createStepOne.posBottomRight") || (isAr ? "أسفل اليمين" : "Bottom Right")}</SelectItem>
                  <SelectItem value="bottom_left">{t("ads.createStepOne.posBottomLeft") || (isAr ? "أسفل اليسار" : "Bottom Left")}</SelectItem>
                  <SelectItem value="top_right">{t("ads.createStepOne.posTopRight") || (isAr ? "أعلى اليمين" : "Top Right")}</SelectItem>
                  <SelectItem value="top_left">{t("ads.createStepOne.posTopLeft") || (isAr ? "أعلى اليسار" : "Top Left")}</SelectItem>
                </SelectContent>
              </Select>
            </div>
          </div>
        )}

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block">
              {t("ads.createStepOne.placementLocations") || (isAr ? "أماكن ومواضع الظهور" : "Placement Locations")} <span className="text-red-500">*</span>
            </Label>
            <DropdownMenu>
              <DropdownMenuTrigger asChild>
                <Button
                  variant="outline"
                  className={`w-full justify-between bg-white dark:bg-neutral-900 font-normal hover:bg-white dark:hover:bg-neutral-900 text-start h-9 text-xs sm:text-sm ${errors.location
                    ? "border-red-500 text-red-500"
                    : "border-neutral-200 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200"
                    }`}
                >
                  <span className="truncate">
                    {selectedLocations.length > 0
                      ? `${selectedLocations.length} ${t("ads.createStepOne.locationsCount") || (isAr ? "مواضع" : "locations")} (${selectedLocations.map(getLocationLabel).join(", ")})`
                      : (t("ads.createStepOne.selectPages") || (isAr ? "اختر الصفحات..." : "Select Pages..."))}
                  </span>
                  <ChevronDown className="h-4 w-4 opacity-50 flex-shrink-0" />
                </Button>
              </DropdownMenuTrigger>
              <DropdownMenuContent className="w-60" align="start">
                {LOCATIONS.map((loc) => (
                  <DropdownMenuCheckboxItem
                    key={loc.value}
                    checked={selectedLocations.some((s: string) => (s || "").toLowerCase().replace(/\s+/g, "_") === loc.value)}
                    onCheckedChange={() => toggleLocation(loc.value)}
                    className="text-xs"
                  >
                    {getLocationLabel(loc.value)}
                  </DropdownMenuCheckboxItem>
                ))}
              </DropdownMenuContent>
            </DropdownMenu>
            {errors.location && (
              <p className="text-xs text-red-500 mt-1 flex items-center gap-1 font-medium">
                <AlertCircle className="h-3 w-3" />
                {String(errors.location.message || (t("ads.createStepOne.locationRequired") || (isAr ? "يرجى اختيار موضع ظهور واحد على الأقل" : "Please select at least one location")))}
              </p>
            )}
          </div>

          <div>
            <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block">
              {t("ads.createStepOne.country") || (isAr ? "الدولة" : "Country")} <span className="text-red-500">*</span>
            </Label>
            <Select
              value={country || undefined}
              onValueChange={(val) => {
                setValue("country", val, { shouldDirty: true, shouldTouch: true, shouldValidate: true });
                setValue("developerId", "", { shouldDirty: true });
                setValue("projectId", "", { shouldDirty: true });
                clearErrors("country");
                clearErrors("developerId");
                clearErrors("projectId");
              }}
            >
              <SelectTrigger className={`bg-white dark:bg-neutral-900 h-9 text-xs sm:text-sm ${errors.country ? "border-red-500" : "border-neutral-200 dark:border-neutral-700"}`}>
                <SelectValue placeholder={t("ads.createStepOne.selectCountry") || (isAr ? "اختر الدولة" : "Select Country")} />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="Egypt">{t("ads.createStepOne.countryEgypt") || (isAr ? "مصر" : "Egypt")}</SelectItem>
                <SelectItem value="UAE">{t("ads.createStepOne.countryUAE") || (isAr ? "الإمارات العربية المتحدة" : "United Arab Emirates")}</SelectItem>
                <SelectItem value="Oman">{t("ads.createStepOne.countryOman") || (isAr ? "عُمان" : "Oman")}</SelectItem>
              </SelectContent>
            </Select>
            {errors.country && (
              <p className="text-xs text-red-500 mt-1 flex items-center gap-1 font-medium">
                <AlertCircle className="h-3 w-3" />
                {String(errors.country.message || (t("ads.createStepOne.countryRequired") || (isAr ? "يرجى اختيار دولة" : "Please select a country")))}
              </p>
            )}
          </div>
        </div>
      </div>

      {/* Section 3: Schedule & Duration */}
      <div className="bg-neutral-50/60 dark:bg-neutral-900/40 rounded-xl p-4 sm:p-5 border border-neutral-200/80 dark:border-neutral-800 space-y-4">
        <div className="flex items-center gap-2 pb-2 border-b border-neutral-200/60 dark:border-neutral-800">
          <Clock className="h-4 w-4 text-teal-600 dark:text-teal-400" />
          <h3 className="text-xs font-semibold uppercase tracking-wider text-neutral-800 dark:text-neutral-200">
            {t("ads.createStepOne.campaignSchedule") || (isAr ? "جدول الحملة الإعلانية" : "Campaign Schedule")}
          </h3>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 block" htmlFor="startDate">
              {t("ads.createStepOne.startDate") || (isAr ? "تاريخ البدء" : "Start Date")} <span className="text-red-500">*</span>
            </Label>
            <div className="relative">
              <Input
                id="startDate"
                type="date"
                {...register("startDate", { required: t("ads.createStepOne.startDateRequired") || (isAr ? "تاريخ البدء مطلوب" : "Start date is required") })}
                className={`bg-white dark:bg-neutral-900 pl-10 h-9 text-xs sm:text-sm ${dateErrors.startDate || errors.startDate
                  ? "border-red-500 focus-visible:ring-red-500"
                  : "border-neutral-200 dark:border-neutral-700"
                  }`}
                onChange={(e) => {
                  register("startDate").onChange(e);
                  clearErrors("startDate");
                  validateDateTimeRange(e.target.value, endDate || "");
                }}
              />
              <Calendar className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-neutral-400 pointer-events-none" />
            </div>
            {(dateErrors.startDate || errors.startDate) && (
              <p className="text-xs text-red-500 mt-1 flex items-center gap-1 font-medium">
                <AlertCircle className="h-3 w-3" />
                {dateErrors.startDate || String(errors.startDate?.message || (t("ads.createStepOne.startDateRequired") || (isAr ? "تاريخ البدء مطلوب" : "Start date is required")))}
              </p>
            )}
          </div>

          <div>
            <Label className="text-xs font-medium text-neutral-700 dark:text-neutral-300 mb-1.5 flex items-center justify-between" htmlFor="endDate">
              <span>{t("ads.createStepOne.endDate") || (isAr ? "تاريخ الانتهاء (اختياري)" : "End Date (Optional)")}</span>
              <span className="text-[11px] text-neutral-400 font-normal">
                {t("ads.createStepOne.endDateHint") || (isAr ? "مستمر في حال تركه فارغاً" : "Continuous if empty")}
              </span>
            </Label>
            <div className="relative">
              <Input
                id="endDate"
                type="date"
                {...register("endDate")}
                className={`bg-white dark:bg-neutral-900 pl-10 h-9 text-xs sm:text-sm ${dateErrors.endDate
                  ? "border-red-500 focus-visible:ring-red-500"
                  : "border-neutral-200 dark:border-neutral-700"
                  }`}
                min={startDate || undefined}
                onChange={(e) => {
                  register("endDate").onChange(e);
                  validateDateTimeRange(startDate || "", e.target.value);
                }}
              />
              <Calendar className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-neutral-400 pointer-events-none" />
            </div>
            {dateErrors.endDate && (
              <p className="text-xs text-red-500 mt-1 flex items-center gap-1 font-medium">
                <AlertCircle className="h-3 w-3" />
                {dateErrors.endDate}
              </p>
            )}
          </div>
        </div>

        {dateErrors.general && (
          <div
            className="p-2.5 rounded-lg bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-800 flex items-center gap-2 text-xs text-red-600 dark:text-red-400"
            role="alert"
          >
            <AlertCircle className="h-4 w-4 flex-shrink-0" />
            <span>{dateErrors.general}</span>
          </div>
        )}
      </div>
    </div>
  );
}
