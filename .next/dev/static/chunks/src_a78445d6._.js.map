"use client";

import { useState } from "react";
import { useRouter, usePathname } from "next/navigation";
import { useQueryClient } from "@tanstack/react-query";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { Button } from "@/components/ui/button";
import { toast } from "sonner";
import {
  Building2,
  CircleDollarSign,
  Layers,
  MapPin,
  Sparkles,
  CreditCard,
  ShieldCheck,
  ChevronLeft,
  ChevronRight,
  CheckCircle2,
  AlertCircle,
} from "lucide-react";
import {
  propertiesSchema,
  PropertiesInput,
} from "@/validators/propertiesSchema";
import {
  usePropertyTypes,
  usePropertySubtypes,
  useProjectsForSelect,
} from "@/hooks/use-property-data";
import useCreateProperty from "@/hooks/use-create-property";
import { AdminPropertiesService } from "@/features/properties/services/AdminPropertiesService";
import { useLanguage } from "@/contexts/LanguageContext";

import PropertyPageHeader from "@/features/properties/components/create/PropertyPageHeader";
import BasicInfoTab from "@/features/properties/components/create/tabs/BasicInfoTab";
import PricingMediaTab from "@/features/properties/components/create/tabs/PricingMediaTab";
import UnitDetailsTab from "@/features/properties/components/create/tabs/UnitDetailsTab";
import LocationTab from "@/features/properties/components/create/tabs/LocationTab";
import AmenitiesTab, {
  SelectedPropertyFeature,
} from "@/features/properties/components/create/tabs/AmenitiesTab";
import PaymentPlansTab from "@/features/properties/components/create/tabs/PaymentPlansTab";
import LicensesTab from "@/features/properties/components/create/tabs/LicensesTab";

type TabId =
  | "basic_info"
  | "pricing_media"
  | "unit_details"
  | "location"
  | "amenities"
  | "payment_plans"
  | "licenses";

interface TabConfig {
  id: TabId;
  labelAr: string;
  labelEn: string;
  translationKey: string;
  fields: (keyof PropertiesInput)[];
}

const TABS: TabConfig[] = [
  {
    id: "basic_info",
    labelAr: "المعلومات الأساسية",
    labelEn: "Basic Info",
    translationKey: "properties.create.tabs.basicInfo",
    fields: [
      "property_name",
      "property_no",
      "project_id",
      "property_type_id",
      "property_subtype_id",
      "availability_status",
      "construction_status",
      "status",
      "building_name",
      "description",
    ],
  },
  {
    id: "pricing_media",
    labelAr: "التسعير والصور",
    labelEn: "Pricing & Media",
    translationKey: "properties.create.tabs.pricingMedia",
    fields: ["price", "currency", "price_per_m2", "price_description"],
  },
  {
    id: "unit_details",
    labelAr: "تفاصيل الوحدة",
    labelEn: "Unit Details",
    translationKey: "properties.create.tabs.unitDetails",
    fields: [
      "size",
      "bedrooms",
      "bathrooms",
      "floor",
      "view",
      "finishing_status",
      "furnish_status",
      "ownership_type",
      "plot_size",
      "bua_size",
      "maid_room",
    ],
  },
  {
    id: "location",
    labelAr: "الموقع",
    labelEn: "Location",
    translationKey: "properties.create.tabs.location",
    fields: ["zone_name"],
  },
  {
    id: "amenities",
    labelAr: "المرافق",
    labelEn: "Amenities",
    translationKey: "properties.create.tabs.amenities",
    fields: [],
  },
  {
    id: "payment_plans",
    labelAr: "خطط السداد",
    labelEn: "Payment Plans",
    translationKey: "properties.create.tabs.paymentPlans",
    fields: [],
  },
  {
    id: "licenses",
    labelAr: "التراخيص",
    labelEn: "Licenses",
    translationKey: "properties.create.tabs.licenses",
    fields: [
      "broker_license",
      "agent_license",
      "dld_permit_number",
      "dld_barcode",
      "reference_listed",
      "parking_spaces",
    ],
  },
];

export default function CreatePropertyPage() {
  const router = useRouter();
  const pathname = usePathname();
  const routePrefix = pathname.startsWith("/developer") ? "/developer" : "/admin";
  const { t, language } = useLanguage();
  const isAr = language === "ar";

  const [activeTab, setActiveTab] = useState<TabId>("basic_info");
  const [images, setImages] = useState<File[]>([]);
  const [imagePreviews, setImagePreviews] = useState<string[]>([]);
  const [floorPlan, setFloorPlan] = useState<File | null>(null);
  const [floorPlanPreview, setFloorPlanPreview] = useState<string | null>(null);
  const [selectedFeatures, setSelectedFeatures] = useState<SelectedPropertyFeature[]>([]);

  const {
    register,
    handleSubmit,
    control,
    trigger,
    setValue,
    watch,
    formState: { errors },
  } = useForm<PropertiesInput>({
    resolver: zodResolver(propertiesSchema),
    defaultValues: {
      maid_room: false,
      currency: "aed",
    },
  });

  const { data: propertiesType = [] } = usePropertyTypes();
  const { data: propertiesSubtype = [] } = usePropertySubtypes();
  const { data: projects = [] } = useProjectsForSelect();

  const queryClient = useQueryClient();
  const { createProperty, isCreating } = useCreateProperty();

  const currentTabIndex = TABS.findIndex((tab) => tab.id === activeTab);

  const handleFormSubmit = async (formData: PropertiesInput) => {
    const data: PropertiesInput = {
      ...formData,
      parking_spaces: formData.parking_spaces
        ? Number(formData.parking_spaces)
        : undefined,
      bua_size: formData.bua_size ? Number(formData.bua_size) : undefined,
      plot_size: formData.plot_size ? Number(formData.plot_size) : undefined,
    };
    try {
      const created = await createProperty(data);
      const newPropertyId =
        (created as any)?.data?.property_id ??
        (created as any)?.property_id ??
        (created as any)?.data?.id ??
        (created as any)?.id;

      if (newPropertyId && selectedFeatures.length > 0) {
        try {
          await AdminPropertiesService.savePropertyFeatures(
            Number(newPropertyId),
            selectedFeatures.map((sf) => ({
              feature_id: sf.feature_id,
              value: sf.value || sf.feature_name || "",
            }))
          );
        } catch (featErr) {
          console.error("Failed to save property features:", featErr);
        }
      }

      if (floorPlan && newPropertyId) {
        try {
          await AdminPropertiesService.addPropertyFloorPlan(newPropertyId, floorPlan);
        } catch (fpErr) {
          console.error("Failed to upload floor plan:", fpErr);
        }
      }

      if (images && images.length > 0 && newPropertyId) {
        try {
          await Promise.all(
            images.map((img, idx) =>
              AdminPropertiesService.addPropertyMedia(Number(newPropertyId), img, idx === 0)
            )
          );
        } catch (imgErr) {
          console.error("Failed to upload images:", imgErr);
        }
      }

      await queryClient.invalidateQueries({ queryKey: ["properties"] });
      queryClient.removeQueries({ queryKey: ["properties"] });
      router.push(`${routePrefix}/properties`);
      router.refresh();
    } catch { }
  };

  const handleInvalid = (errs: any) => {
    const errorKeys = Object.keys(errs) as (keyof PropertiesInput)[];
    if (errorKeys.length > 0) {
      const firstErrorKey = errorKeys[0];
      const targetTab = TABS.find((tab) => tab.fields.includes(firstErrorKey));
      if (targetTab && targetTab.id !== activeTab) {
        setActiveTab(targetTab.id);
      }

      const errorObj = errs[firstErrorKey];
      if (errorObj?.message) {
        toast.error(t(errorObj.message) || errorObj.message);
      }

      setTimeout(() => {
        const errorElement =
          document.getElementById(firstErrorKey) ||
          document.getElementsByName(firstErrorKey)[0];
        if (errorElement) {
          errorElement.focus();
          errorElement.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      }, 100);
    }
  };

  const handleNextTab = async () => {
    const currentTabFields = TABS[currentTabIndex]?.fields || [];
    if (currentTabFields.length > 0) {
      const isValid = await trigger(currentTabFields);
      if (!isValid) {
        toast.error(t("validation.fillRequiredFields") || "Please fill in required fields in this tab before continuing.");
        return;
      }
    }
    if (currentTabIndex < TABS.length - 1) {
      setActiveTab(TABS[currentTabIndex + 1].id);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  };

  const handlePrevTab = () => {
    if (currentTabIndex > 0) {
      setActiveTab(TABS[currentTabIndex - 1].id);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  };

  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = Array.from(e.target.files || []);
    setImages((prev) => [...prev, ...files]);
    files.forEach((file) => {
      const reader = new FileReader();
      reader.onloadend = () => {
        setImagePreviews((prev) => [...prev, reader.result as string]);
      };
      reader.readAsDataURL(file);
    });
  };

  const handleRemoveImage = (index: number) => {
    setImages((prev) => prev.filter((_, i) => i !== index));
    setImagePreviews((prev) => prev.filter((_, i) => i !== index));
  };

  const handleFloorPlanUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setFloorPlan(file);
    const reader = new FileReader();
    reader.onloadend = () => {
      setFloorPlanPreview(reader.result as string);
    };
    reader.readAsDataURL(file);
  };

  const handleRemoveFloorPlan = () => {
    setFloorPlan(null);
    setFloorPlanPreview(null);
  };

  const tabHasError = (tab: TabConfig) => {
    return tab.fields.some((field) => !!errors[field]);
  };

  return (
    <div className="w-full space-y-3 pb-8">
      <PropertyPageHeader onCancel={() => router.push(`${routePrefix}/properties`)} />

      <form onSubmit={handleSubmit(handleFormSubmit, handleInvalid)} className="space-y-3.5">
        <div className="border-b border-gray-200 dark:border-neutral-800 mb-3">
          <div className="flex items-center gap-4 sm:gap-5 lg:gap-7 no-scrollbar overflow-x-auto">
            {TABS.map((tab) => {
              const isActive = activeTab === tab.id;
              const hasError = tabHasError(tab);
              const label = isAr ? tab.labelAr : tab.labelEn;

              return (
                <button
                  key={tab.id}
                  type="button"
                  onClick={() => setActiveTab(tab.id)}
                  className={`pb-1.5 text-xs font-medium whitespace-nowrap transition-colors border-b-2 select-none shrink-0 cursor-pointer ${isActive
                    ? "border-[#008081] text-[#008081] dark:border-teal-400 dark:text-teal-400 font-bold -mb-px"
                    : hasError
                      ? "border-red-500 text-red-600 dark:text-red-400 font-medium -mb-px"
                      : "border-transparent text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white font-medium -mb-px"
                    }`}
                >
                  <span>{label}</span>
                  {hasError && (
                    <span className="inline-block w-1.5 h-1.5 rounded-full bg-red-500 ms-1.5 align-middle" />
                  )}
                </button>
              );
            })}
          </div>
        </div>

        {/* ── Active Tab Content ─────────────────────────────────────────── */}
        <div className="transition-all duration-200">
          {activeTab === "basic_info" && (
            <BasicInfoTab
              register={register}
              control={control}
              errors={errors}
              propertiesType={propertiesType}
              propertiesSubtype={propertiesSubtype}
              projects={projects}
              setValue={setValue}
              watch={watch}
            />
          )}

          {activeTab === "pricing_media" && (
            <PricingMediaTab
              register={register}
              control={control}
              errors={errors}
              imagePreviews={imagePreviews}
              onImageUpload={handleImageUpload}
              onRemoveImage={handleRemoveImage}
              floorPlanPreview={floorPlanPreview}
              onFloorPlanUpload={handleFloorPlanUpload}
              onRemoveFloorPlan={handleRemoveFloorPlan}
              setValue={setValue}
              watch={watch}
            />
          )}

          {activeTab === "unit_details" && (
            <UnitDetailsTab
              register={register}
              control={control}
              errors={errors}
              setValue={setValue}
              watch={watch}
            />
          )}

          {activeTab === "location" && (
            <LocationTab
              register={register}
              setValue={setValue}
              watch={watch}
              projects={projects}
            />
          )}

          {activeTab === "amenities" && (
            <AmenitiesTab
              register={register}
              setValue={setValue}
              watch={watch}
              selectedFeatures={selectedFeatures}
              onChangeFeatures={setSelectedFeatures}
            />
          )}

          {activeTab === "payment_plans" && (
            <PaymentPlansTab
              register={register}
              setValue={setValue}
              watch={watch}
            />
          )}

          {activeTab === "licenses" && (
            <LicensesTab
              register={register}
              setValue={setValue}
              watch={watch}
            />
          )}
        </div>

        {/* ── Actions Footer ─────────────────────────────────── */}
        <div className="flex items-center justify-between pt-2 pb-6">
          <div className="flex items-center gap-3">
            <Button
              type="submit"
              className="bg-[#008081] hover:bg-[#006666] text-white text-xs font-semibold px-5 h-9 rounded-md gap-1.5 shadow-2xs cursor-pointer"
              disabled={isCreating}
            >
              <CheckCircle2 className="h-4 w-4" />
              <span>
                {isCreating
                  ? (t("properties.create.creating") || (isAr ? "جاري الحفظ..." : "Saving..."))
                  : (t("properties.create.saveProperty") || (isAr ? "حفظ العقار" : "Save Property"))}
              </span>
            </Button>

            <Button
              type="button"
              variant="outline"
              onClick={() => router.push(`${routePrefix}/properties`)}
              className="border-gray-200 dark:border-neutral-700 bg-white dark:bg-neutral-900 text-gray-700 dark:text-gray-300 text-xs font-medium px-4 h-9 rounded-md hover:bg-gray-50 dark:hover:bg-neutral-800 shadow-2xs cursor-pointer"
            >
              {isAr ? "إلغاء" : (t("properties.create.cancel") || "Cancel")}
            </Button>
          </div>

          <div className="flex items-center gap-2">
            {currentTabIndex > 0 && (
              <Button
                type="button"
                variant="outline"
                onClick={handlePrevTab}
                className="h-8 text-xs px-3 border-gray-200 dark:border-neutral-700 text-gray-700 dark:text-gray-300 bg-white dark:bg-neutral-900 hover:bg-gray-50 dark:hover:bg-neutral-800 gap-1 shadow-2xs cursor-pointer"
              >
                <ChevronLeft className="h-3.5 w-3.5 rtl:rotate-180" />
                <span>{isAr ? "السابق" : (t("common.previous") || "Previous")}</span>
              </Button>
            )}

            {currentTabIndex < TABS.length - 1 && (
              <Button
                type="button"
                variant="outline"
                onClick={handleNextTab}
                className="h-8 text-xs px-3 border-gray-200 dark:border-neutral-700 text-gray-700 dark:text-gray-300 bg-white dark:bg-neutral-900 hover:bg-gray-50 dark:hover:bg-neutral-800 gap-1 shadow-2xs cursor-pointer"
              >
                <span>{isAr ? "التالي" : (t("common.next") || "Next")}</span>
                <ChevronRight className="h-3.5 w-3.5 rtl:rotate-180" />
              </Button>
            )}
          </div>
        </div>
      </form>
    </div>
  );
}
