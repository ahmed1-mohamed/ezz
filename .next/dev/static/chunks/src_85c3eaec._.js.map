"use client";

import { Controller } from "react-hook-form";
import { Modal } from "@/components/ui/modal";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { MapPin, Navigation, Landmark, FileText, Loader2, Search } from "lucide-react";
import { useAddLocationForm } from "./hooks";
import { useLanguage } from "@/contexts/LanguageContext";

interface AddLocationModalProps {
  isOpen: boolean;
  onClose: () => void;
}

export function AddLocationModal({ isOpen, onClose }: AddLocationModalProps) {
  const { t } = useLanguage();
  const {
    methods,
    cities,
    areas,
    isLoadingCities,
    isLoadingAreas,
    isProcessing,
    isAddingLocation,
    handleExtractLocation,
    onSubmit,
    handleClose,
  } = useAddLocationForm(isOpen, onClose);

  const { register, control, formState: { errors }, handleSubmit, watch } = methods;
  const googleMapLinkValue = watch("googleMapLink");

  return (
    <Modal
      isOpen={isOpen}
      onClose={handleClose}
      title={t("locations.addNewLocation")}
      size="lg"
      showCloseButton={false}
      footer={
        <div className="flex gap-3 justify-end w-full">
          <Button variant="outline" onClick={handleClose}>
            {t("common.close")}
          </Button>
          <Button
            className="bg-teal-600 hover:bg-teal-700 text-white"
            onClick={handleSubmit(onSubmit)}
            disabled={isAddingLocation || isProcessing}
          >
            {isAddingLocation ? (
              <>
                <Loader2 className="h-4 w-4 me-2 animate-spin" />
                {t("locations.form.adding")}
              </>
            ) : (
              t("locations.addNewLocation")
            )}
          </Button>
        </div>
      }
    >
      <div className="space-y-6 max-h-[70vh] overflow-y-auto pe-2">
        <div>
          <Label htmlFor="location-name">
            {t("locations.form.locationName")} <span className="text-red-500">*</span>
          </Label>
          <Input
            id="location-name"
            placeholder={t("locations.form.locationNamePlaceholder")}
            {...register("locationName")}
            className={`mt-1 ${errors.locationName ? "border-red-500 focus-visible:ring-red-500" : ""}`}
          />
          {errors.locationName && (
            <p className="text-xs text-red-500 mt-1">{errors.locationName.message}</p>
          )}
        </div>

        <div>
          <Label htmlFor="google-map-link">
            {t("locations.form.googleMapLink")} <span className="text-red-500">*</span>
          </Label>
          <div className="flex gap-2 mt-1">
            <div className="relative flex-1">
              <MapPin className="absolute start-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
              <Input
                id="google-map-link"
                placeholder={t("locations.form.googleMapLinkPlaceholder")}
                {...register("googleMapLink")}
                className={`ps-10 ${errors.googleMapLink ? "border-red-500 focus-visible:ring-red-500" : ""}`}
              />
            </div>
            <Button
              type="button"
              onClick={handleExtractLocation}
              disabled={!googleMapLinkValue?.trim() || isProcessing}
              className="bg-blue-600 hover:bg-blue-700 text-white whitespace-nowrap"
            >
              {isProcessing ? (
                <Loader2 className="h-4 w-4 animate-spin" />
              ) : (
                <>
                  <Search className="h-4 w-4 me-2" />
                  {t("locations.form.extract")}
                </>
              )}
            </Button>
          </div>
          {errors.googleMapLink && (
            <p className="text-xs text-red-500 mt-1">{errors.googleMapLink.message}</p>
          )}
        </div>

        <div className="grid grid-cols-2 gap-4">
          <div>
            <Label htmlFor="city">
              {t("locations.form.city")} <span className="text-red-500">*</span>
            </Label>
            <Controller
              name="cityId"
              control={control}
              render={({ field }) => (
                <Select onValueChange={field.onChange} value={field.value || ""}>
                  <SelectTrigger className={`mt-1 ${errors.cityId ? "border-red-500 focus:ring-red-500" : ""}`}>
                    <SelectValue placeholder={isLoadingCities ? t("locations.form.loadingCities") : t("locations.form.selectCity")} />
                  </SelectTrigger>
                  <SelectContent>
                    {cities.map((city) => (
                      <SelectItem key={city.value} value={city.value}>{city.label}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              )}
            />
            {errors.cityId && <p className="text-xs text-red-500 mt-1">{errors.cityId.message}</p>}
          </div>

          <div>
            <Label htmlFor="area">
              {t("locations.form.area")} <span className="text-red-500">*</span>
            </Label>
            <Controller
              name="areaId"
              control={control}
              render={({ field }) => (
                <Select onValueChange={field.onChange} value={field.value || ""} disabled={!watch("cityId")}>
                  <SelectTrigger className={`mt-1 ${errors.areaId ? "border-red-500 focus:ring-red-500" : ""}`}>
                    <SelectValue placeholder={isLoadingAreas ? t("locations.form.loadingAreas") : watch("cityId") ? t("locations.form.selectArea") : t("locations.form.selectCityFirst")} />
                  </SelectTrigger>
                  <SelectContent>
                    {areas.map((area) => (
                      <SelectItem key={area.value} value={area.value}>{area.label}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              )}
            />
            {errors.areaId && <p className="text-xs text-red-500 mt-1">{errors.areaId.message}</p>}
          </div>
        </div>

        <div className="grid grid-cols-2 gap-4 bg-gray-50 p-4 rounded-lg border border-gray-100">
          <div>
            <Label htmlFor="latitude">{t("locations.form.latitude")}</Label>
            <div className="relative mt-1">
              <Navigation className="absolute start-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
              <Input id="latitude" placeholder={t("locations.form.latitudePlaceholder")} {...register("latitude")} className="ps-10" />
            </div>
            {errors.latitude && <p className="text-xs text-red-500 mt-1">{errors.latitude.message}</p>}
          </div>
          <div>
            <Label htmlFor="longitude">{t("locations.form.longitude")}</Label>
            <div className="relative mt-1">
              <Navigation className="absolute start-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
              <Input id="longitude" placeholder={t("locations.form.longitudePlaceholder")} {...register("longitude")} className="ps-10" />
            </div>
            {errors.longitude && <p className="text-xs text-red-500 mt-1">{errors.longitude.message}</p>}
          </div>
        </div>

        <div>
          <h4 className="text-sm font-medium text-gray-900 mb-3 flex items-center gap-2">
            <Navigation className="h-4 w-4" /> {t("locations.form.locationBoundaries")}
          </h4>
          <div className="grid grid-cols-2 gap-4">
            <div>
              <Label htmlFor="northSide">{t("locations.form.northSide")}</Label>
              <Input id="northSide" placeholder={t("locations.form.northSidePlaceholder")} {...register("northSide")} className="mt-1" />
            </div>
            <div>
              <Label htmlFor="southSide">{t("locations.form.southSide")}</Label>
              <Input id="southSide" placeholder={t("locations.form.southSidePlaceholder")} {...register("southSide")} className="mt-1" />
            </div>
            <div>
              <Label htmlFor="eastSide">{t("locations.form.eastSide")}</Label>
              <Input id="eastSide" placeholder={t("locations.form.eastSidePlaceholder")} {...register("eastSide")} className="mt-1" />
            </div>
            <div>
              <Label htmlFor="westSide">{t("locations.form.westSide")}</Label>
              <Input id="westSide" placeholder={t("locations.form.westSidePlaceholder")} {...register("westSide")} className="mt-1" />
            </div>
          </div>
        </div>

        <div>
          <Label htmlFor="landmark">
            {t("locations.form.nearestLandmark")} <span className="text-gray-400 font-normal">{t("locations.form.optional")}</span>
          </Label>
          <div className="relative mt-1">
            <Landmark className="absolute start-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
            <Input id="landmark" placeholder={t("locations.form.landmarkPlaceholder")} {...register("landmark")} className="ps-10" />
          </div>
        </div>

        <div>
          <Label htmlFor="description">
            {t("locations.form.locationDescription")} <span className="text-gray-400 font-normal">{t("locations.form.optional")}</span>
          </Label>
          <div className="relative mt-1">
            <FileText className="absolute start-3 top-3 h-4 w-4 text-gray-400" />
            <Textarea
              id="description"
              placeholder={t("locations.form.descriptionPlaceholder")}
              {...register("description")}
              className="ps-10 min-h-[100px]"
            />
          </div>
        </div>
      </div>
    </Modal>
  );
}