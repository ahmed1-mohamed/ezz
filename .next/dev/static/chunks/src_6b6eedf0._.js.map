"use client";

import { useState } from "react";
import { useForm } from "react-hook-form";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { Modal } from "@/components/ui/modal";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Loader2 } from "lucide-react";
import { toast } from "sonner";
import { AdminSubscriptionsService } from "@/data/api-client";
import { useLanguage } from "@/contexts/LanguageContext";
import { handleServerValidationError, getErrorMessage } from "@/lib/form-utils";

interface AddCustomerPlanModalProps {
  open: boolean;
  onClose: () => void;
  onSuccess?: () => void;
}

export default function AddCustomerPlanModal({
  open,
  onClose,
  onSuccess,
}: AddCustomerPlanModalProps) {
  const queryClient = useQueryClient();
  const { t } = useLanguage();
  const [selectedFeatures, setSelectedFeatures] = useState<{ feature_id: number; feature_code: string; limit: number | null }[]>([]);
  const {
    register,
    handleSubmit,
    reset,
    setError,
    formState: { errors },
  } = useForm({
    defaultValues: {
      code: "",
      name: "",
      description: "",
      price: 0,
      interval: "month",
      currency: "USD",
      is_active: "true",
      sort_order: 1,
    },
  });
  const { data: featuresQuery, isLoading: loadingFeatures } = useQuery({
    queryKey: ["dashboard", "subscriptionFeatures"],
    queryFn: () => AdminSubscriptionsService.getSubscriptionFeatures(),
    enabled: open,
  });
  const featuresResponse = featuresQuery;
  let availableFeatures: any[] = [];
  if (featuresResponse) {
    const body = (featuresResponse as any).data !== undefined ? (featuresResponse as any).data : featuresResponse;
    if (Array.isArray(body)) {
      availableFeatures = body;
    } else if (body && typeof body === "object") {
      if (Array.isArray(body.data)) {
        availableFeatures = body.data;
      } else if (body.data && Array.isArray(body.data.data)) {
        availableFeatures = body.data.data;
      } else {
        const topLevelArrays = Object.values(body).filter(Array.isArray);
        if (topLevelArrays.length > 0) {
          availableFeatures = topLevelArrays[0] as any[];
        }
      }
    }
  }
  const mutation = useMutation({
    mutationFn: (data: any) => AdminSubscriptionsService.createCustomerPlan(data),
    onSuccess: () => {
      toast.success(t("subscriptions.customerPlans.addSuccess") || "Customer plan created successfully!");
      queryClient.invalidateQueries({ queryKey: ["subscriptions", "customerPlans"] });
      if (onSuccess) {
        onSuccess();
      }
      handleClose();
    },
    onError: (error: any) => {
      console.error("FULL API ERROR:", error?.response?.data || error);
      toast.error(getErrorMessage(error));
    },
  });
  const handleClose = () => {
    reset();
    setSelectedFeatures([]);
    onClose();
  };
  const toggleFeature = (featureId: number, featureCode: string, isChecked: boolean) => {
    if (isChecked) {
      setSelectedFeatures([...selectedFeatures, { feature_id: featureId, feature_code: featureCode, limit: null }]);
    } else {
      setSelectedFeatures(selectedFeatures.filter((f) => f.feature_code !== featureCode));
    }
  };
  const updateFeatureLimit = (featureCode: string, limitVal: string) => {
    setSelectedFeatures(
      selectedFeatures.map((f) =>
        f.feature_code === featureCode ? { ...f, limit: limitVal ? Number(limitVal) : null } : f
      )
    );
  };
  const onSubmit = async (formData: any) => {
    const featuresObj: Record<string, any> = {};
    selectedFeatures.forEach((f) => {
      featuresObj[f.feature_code] = f.limit !== null ? f.limit : -1;
    });
    const apiData = {
      code: formData.code,
      name: formData.name,
      description: formData.description || "",
      price: Number(formData.price),
      currency: formData.currency || "USD",
      interval: formData.interval,
      is_active: formData.is_active === "true" ? 1 : 0,
      sort_order: Number(formData.sort_order) || 1,
      features: featuresObj,
    };
    try {
      await mutation.mutateAsync(apiData);
    } catch (error) {
      handleServerValidationError(error, setError);
    }
  };
  return (
    <Modal
      isOpen={open}
      onClose={handleClose}
      title={t("subscriptions.addCustomerPlanModal.title") || "Create New Customer Plan"}
      size="lg"
    >
      <form onSubmit={handleSubmit(onSubmit)} className="space-y-4 max-h-[75vh] overflow-y-auto px-1 pb-2">
        <div className="grid grid-cols-2 gap-4">
          <div className="space-y-1.5">
            <Label>{t("subscriptions.addCustomerPlanModal.planCode") || "Plan Code"} <span className="text-red-500">*</span></Label>
            <Input
              placeholder={t("subscriptions.addCustomerPlanModal.planCodePlaceholder") || "e.g. premium_monthly"}
              error={!!errors.code}
              {...register("code", { required: "validation.required" })}
            />
            {errors.code && (
              <p className="text-xs text-red-500 mt-1">{t(errors.code.message || "")}</p>
            )}
          </div>
          <div className="space-y-1.5">
            <Label>{t("subscriptions.addCustomerPlanModal.planName") || "Plan Name"} <span className="text-red-500">*</span></Label>
            <Input
              placeholder={t("subscriptions.addCustomerPlanModal.planNamePlaceholder") || "e.g. Premium Monthly"}
              error={!!errors.name}
              {...register("name", { required: "validation.required" })}
            />
            {errors.name && (
              <p className="text-xs text-red-500 mt-1">{t(errors.name.message || "")}</p>
            )}
          </div>
        </div>
        <div className="space-y-1.5">
          <Label>{t("subscriptions.addCustomerPlanModal.description") || "Description"}</Label>
          <Input
            placeholder={t("subscriptions.addCustomerPlanModal.descriptionPlaceholder") || "Plan description"}
            error={!!errors.description}
            {...register("description")}
          />
          {errors.description && (
            <p className="text-xs text-red-500 mt-1">{t(errors.description.message || "")}</p>
          )}
        </div>
        <div className="grid grid-cols-2 gap-4">
          <div className="space-y-1.5">
            <Label>{t("subscriptions.addCustomerPlanModal.price") || "Price"} <span className="text-red-500">*</span></Label>
            <Input
              type="number"
              step="0.01"
              error={!!errors.price}
              {...register("price", { required: "validation.required" })}
            />
            {errors.price && (
              <p className="text-xs text-red-500 mt-1">{t(errors.price.message || "")}</p>
            )}
          </div>
          <div className="space-y-1.5">
            <Label>{t("subscriptions.addCustomerPlanModal.currency") || "Currency"} <span className="text-red-500">*</span></Label>
            <Input
              placeholder={t("subscriptions.addCustomerPlanModal.currencyPlaceholder") || "USD"}
              error={!!errors.currency}
              {...register("currency", { required: "validation.required" })}
            />
            {errors.currency && (
              <p className="text-xs text-red-500 mt-1">{t(errors.currency.message || "")}</p>
            )}
          </div>
        </div>
        <div className="grid grid-cols-2 gap-4">
          <div className="space-y-1.5">
            <Label>{t("subscriptions.addCustomerPlanModal.interval") || "Interval"}</Label>
            <select
              {...register("interval")}
              className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            >
              <option value="month">{t("subscriptions.addCustomerPlanModal.month") || "Month"}</option>
              <option value="year">{t("subscriptions.addCustomerPlanModal.year") || "Year"}</option>
            </select>
          </div>
          <div className="space-y-1.5">
            <Label>{t("subscriptions.addCustomerPlanModal.activeStatus") || "Active Status"}</Label>
            <select
              {...register("is_active")}
              className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            >
              <option value="true">{t("subscriptions.addCustomerPlanModal.active") || "Active"}</option>
              <option value="false">{t("subscriptions.addCustomerPlanModal.inactive") || "Inactive"}</option>
            </select>
          </div>
        </div>
        <div className="grid grid-cols-2 gap-4">
          <div className="space-y-1.5">
            <Label>{t("subscriptions.addCustomerPlanModal.sortOrder") || "Sort Order"}</Label>
            <Input
              type="number"
              error={!!errors.sort_order}
              {...register("sort_order")}
            />
            {errors.sort_order && (
              <p className="text-xs text-red-500 mt-1">{t(errors.sort_order.message || "")}</p>
            )}
          </div>
        </div>
        {errors.root && (
          <p className="text-xs text-red-500 mt-1">{t(errors.root.message || "")}</p>
        )}
        <div className="space-y-3 mt-6 border-t pt-4">
          <Label className="text-base font-semibold">{t("subscriptions.addCustomerPlanModal.includedFeatures") || "Included Features"}</Label>
          {loadingFeatures ? (
            <div className="flex items-center gap-2 text-sm text-gray-500">
              <Loader2 className="h-4 w-4 animate-spin" /> {t("subscriptions.addCustomerPlanModal.loadingFeatures") || "Loading features..."}
            </div>
          ) : availableFeatures.length === 0 ? (
            <p className="text-sm text-gray-500 italic">{t("subscriptions.addCustomerPlanModal.noFeatures") || "No features found in the system."}</p>
          ) : (
            <div className="space-y-3 bg-gray-50 p-4 rounded-xl border border-gray-100 max-h-60 overflow-y-auto">
              {availableFeatures.map((feature: any) => {
                const fId = feature.feature_id || feature.badge_id || feature.id;
                const fName = feature.feature_name || feature.name || feature.code;
                const fCode = feature.code || feature.badge_code || feature.feature_name || feature.name || fId.toString();
                const isSelected = selectedFeatures.some((f) => f.feature_code === fCode);
                const selectedData = selectedFeatures.find((f) => f.feature_code === fCode);
                return (
                  <div key={fId} className={`flex flex-col gap-2 p-3 rounded-lg border ${isSelected ? "border-teal-200 bg-teal-50/30" : "border-gray-200 bg-white"}`}>
                    <label className="flex items-start gap-3 cursor-pointer">
                      <div className="flex h-5 items-center">
                        <input
                          type="checkbox"
                          className="h-4 w-4 rounded border-gray-300 text-teal-600 focus:ring-teal-600 cursor-pointer"
                          checked={isSelected}
                          onChange={(e) => toggleFeature(fId, fCode, e.target.checked)}
                        />
                      </div>
                      <div className="flex flex-col">
                        <span className="text-sm font-medium text-black">{fName}</span>
                        <span className="text-xs text-black">{feature.description || feature.applies_to}</span>
                      </div>
                    </label>
                    {isSelected && (
                      <div className="ml-7 pl-1">
                        <div className="flex items-center gap-2">
                          <Label className="text-xs">{t("subscriptions.addCustomerPlanModal.limit") || "Limit (optional):"}</Label>
                          <Input
                            type="number"
                            className="h-7 w-24 text-xs font-semibold text-black bg-white"
                            placeholder={t("subscriptions.addCustomerPlanModal.limitPlaceholder") || "Unlimited"}
                            value={selectedData?.limit || ""}
                            onChange={(e) => updateFeatureLimit(fCode, e.target.value)}
                          />
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          )}
        </div>
        <div className="flex gap-2 justify-end pt-4 sticky bottom-0 bg-white border-t mt-4 py-2">
          <Button type="button" variant="outline" onClick={handleClose} disabled={mutation.isPending}>
            {t("subscriptions.addCustomerPlanModal.cancel") || "Cancel"}
          </Button>
          <Button type="submit" disabled={mutation.isPending} className="bg-teal-600 hover:bg-teal-700 text-white">
            {mutation.isPending && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}
            {mutation.isPending ? t("subscriptions.addCustomerPlanModal.creating") || "Creating..." : t("subscriptions.addCustomerPlanModal.createPlan") || "Create Plan"}
          </Button>
        </div>
      </form>
    </Modal>
  );
}