"use client";

// TEMPORARY visual check — delete after review.
import { useState } from "react";
import { LocationsTable } from "@/features/locations/components/LocationsTable";
import { useTableSettings } from "@/hooks/use-table-settings";

const now = Date.now();
const rows = [
  { location_id: 12, location_landmark: "Dubai Marina Walk, near Marina Mall", city_name: "Dubai", area_name: "Dubai Marina", country_name: "United Arab Emirates", created_at: new Date(now - 2 * 86400000).toISOString(), projects_count: 4 },
  { location_id: 9, location_landmark: "Mivida Compound Gate 3", city_name: "New Cairo", area_name: "Fifth Settlement", country_name: "Egypt", created_at: new Date(now - 40 * 86400000).toISOString(), projects_count: 1 },
  { location_id: 7, location_landmark: "N/A", city_name: "Muscat", area_name: "N/A", country_name: "N/A", created_at: "N/A", projects_count: 0 },
];

export default function Preview() {
  const settings = useTableSettings("locations-preview", ["landmark", "details", "projects", "created", "country", "actions"].map((id) => ({ id, label: id, visible: true })));
  const [selected, setSelected] = useState<number[]>([9]);
  return (
    <div className="min-h-screen bg-[#F4F6FA] p-6">
      <LocationsTable
        settings={settings}
        locations={rows}
        selectedLocations={selected}
        onSelectAll={(c) => setSelected(c ? rows.map((r) => r.location_id) : [])}
        onSelectLocation={(id, c) => setSelected((s) => (c ? [...s, id] : s.filter((x) => x !== id)))}
        onView={() => {}}
        onEdit={() => {}}
        onDelete={() => {}}
      />
    </div>
  );
}
