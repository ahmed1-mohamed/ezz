"use client";

import { useState, useEffect } from "react";
import { Modal } from "@/components/ui/modal";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Percent } from "lucide-react";
import { useLanguage } from "@/contexts/LanguageContext";
import { PropertyPaymentPlan } from "./payment-plans.types";

interface AddPropertyPaymentPlanModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSave: (plan: PropertyPaymentPlan) => void;
  initialData?: PropertyPaymentPlan | null;
}

export function AddPropertyPaymentPlanModal({
  isOpen,
  onClose,
  onSave,
  initialData,
}: AddPropertyPaymentPlanModalProps) {
  const { t } = useLanguage();

  const [name, setName] = useState("");
  const [description, setDescription] = useState("");
  const [downPayment, setDownPayment] = useState<number>(20);
  const [installmentsCount, setInstallmentsCount] = useState<number>(4);
  const [period, setPeriod] = useState<string>("Quarterly");
  const [handoverPercentage, setHandoverPercentage] = useState<number>(40);

  useEffect(() => {
    if (initialData) {
      setName(initialData.name || "");
      setDescription(initialData.description || "");
      setDownPayment(initialData.down_payment_percentage ?? 20);
      setInstallmentsCount(initialData.installments_count ?? 4);
      setPeriod(initialData.period || "Quarterly");
      setHandoverPercentage(initialData.handover_percentage ?? 40);
    } else {
      setName("");
      setDescription("");
      setDownPayment(20);
      setInstallmentsCount(4);
      setPeriod("Quarterly");
      setHandoverPercentage(40);
    }
  }, [initialData, isOpen]);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!name.trim()) return;

    onSave({
      id: initialData?.id || `plan_${Date.now()}`,
      name: name.trim(),
      description: description.trim() || undefined,
      down_payment_percentage: Number(downPayment) || 0,
      installments_count: Number(installmentsCount) || 1,
      period: period || "Monthly",
      handover_percentage: Number(handoverPercentage) || 0,
    });
    onClose();
  };

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title={
        initialData
          ? t("properties.create.paymentPlans.editPlanTitle") || "Edit Payment Plan"
          : t("properties.create.paymentPlans.addPlanTitle") || "Add Payment Plan"
      }
      description={
        t("properties.create.paymentPlans.modalDescription") ||
        "Configure payment plan details, down payment, and installment terms."
      }
      size="lg"
    >
      <form onSubmit={handleSubmit} className="space-y-3 pt-1">
        <div>
          <Label htmlFor="plan_name" className="text-[11px] font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300">
            {t("properties.create.paymentPlans.planName") || "Plan Name"} *
          </Label>
          <Input
            id="plan_name"
            value={name}
            onChange={(e) => setName(e.target.value)}
            placeholder="e.g. 60/40 Construction Plan"
            required
            className="mt-1 text-xs h-8"
          />
        </div>

        <div>
          <Label htmlFor="plan_desc" className="text-[11px] font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300">
            {t("properties.create.paymentPlans.description") || "Description"}
          </Label>
          <Textarea
            id="plan_desc"
            value={description}
            onChange={(e) => setDescription(e.target.value)}
            placeholder="Short details about this payment plan"
            rows={2}
            className="mt-1 text-xs min-h-[60px]"
          />
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <Label htmlFor="down_payment" className="text-[11px] font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300">
              {t("properties.create.paymentPlans.downPayment") || "Down Payment"} (%) *
            </Label>
            <div className="relative mt-1">
              <Input
                id="down_payment"
                type="number"
                min="0"
                max="100"
                value={downPayment}
                onChange={(e) => setDownPayment(Number(e.target.value))}
                required
                className="pr-7 text-xs h-8"
              />
              <Percent className="absolute right-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-gray-400 dark:text-gray-500" />
            </div>
          </div>

          <div>
            <Label htmlFor="handover_perc" className="text-[11px] font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300">
              {t("properties.create.paymentPlans.onHandover") || "On Handover"} (%)
            </Label>
            <div className="relative mt-1">
              <Input
                id="handover_perc"
                type="number"
                min="0"
                max="100"
                value={handoverPercentage}
                onChange={(e) => setHandoverPercentage(Number(e.target.value))}
                className="pr-7 text-xs h-8"
              />
              <Percent className="absolute right-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-gray-400 dark:text-gray-500" />
            </div>
          </div>

          <div>
            <Label htmlFor="installments_count" className="text-[11px] font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300">
              {t("properties.create.paymentPlans.installmentsCount") || "Number of Installments"} *
            </Label>
            <Input
              id="installments_count"
              type="number"
              min="1"
              max="120"
              value={installmentsCount}
              onChange={(e) => setInstallmentsCount(Number(e.target.value))}
              required
              className="mt-1 text-xs h-8"
            />
          </div>

          <div>
            <Label htmlFor="period_select" className="text-[11px] font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300">
              {t("properties.create.paymentPlans.period") || "Payment Period / Frequency"} *
            </Label>
            <Select value={period} onValueChange={setPeriod}>
              <SelectTrigger id="period_select" className="mt-1 text-xs h-8">
                <SelectValue placeholder="Select period" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="Monthly" className="text-xs">Monthly</SelectItem>
                <SelectItem value="Quarterly" className="text-xs">Quarterly</SelectItem>
                <SelectItem value="Semi-Annually" className="text-xs">Semi-Annually</SelectItem>
                <SelectItem value="Yearly" className="text-xs">Yearly</SelectItem>
                <SelectItem value="During Construction" className="text-xs">During Construction</SelectItem>
                <SelectItem value="Post Handover (2 Years)" className="text-xs">Post Handover (2 Years)</SelectItem>
                <SelectItem value="Post Handover (3 Years)" className="text-xs">Post Handover (3 Years)</SelectItem>
                <SelectItem value="Immediate" className="text-xs">Immediate</SelectItem>
              </SelectContent>
            </Select>
          </div>
        </div>

        <div className="flex justify-end gap-2 pt-3 border-t border-gray-100 dark:border-neutral-800">
          <Button type="button" variant="outline" size="sm" onClick={onClose} className="text-xs h-8">
            {t("common.cancel") || "Cancel"}
          </Button>
          <Button type="submit" size="sm" className="bg-teal-600 hover:bg-teal-700 text-white text-xs h-8">
            {initialData
              ? t("common.saveChanges") || "Save Changes"
              : t("properties.create.paymentPlans.addPlanBtn") || "Add Plan"}
          </Button>
        </div>
      </form>
    </Modal>
  );
}
