"use client";

import { useEffect, useId, useRef, useState } from "react";
import { Loader2, MapPin, Search, X } from "lucide-react";
import { cn } from "@/lib/utils";
import { useLanguage } from "@/contexts/LanguageContext";
import { isAbortError, searchPlaces, type PlaceSuggestion } from "@/lib/maps/geocoding";
import { extractCoordinates } from "@/lib/maps/parse-map-url";

const DEBOUNCE_MS = 350;
const MIN_CHARS = 3;

interface MapSearchBoxProps {
  onSelect: (suggestion: PlaceSuggestion) => void;
  onCoordinates: (coords: { lat: number; lng: number }) => void;
  getBias: () => { lat: number; lng: number } | null;
  className?: string;
}

type Status = "idle" | "loading" | "done" | "error";

/** Address / place search for the map. Typing "lat, lng" jumps straight to those coordinates. */
export function MapSearchBox({ onSelect, onCoordinates, getBias, className }: MapSearchBoxProps) {
  const { t, language } = useLanguage();
  const listId = useId();
  const [query, setQuery] = useState("");
  const [results, setResults] = useState<PlaceSuggestion[]>([]);
  const [status, setStatus] = useState<Status>("idle");
  const [open, setOpen] = useState(false);
  const [active, setActive] = useState(-1);
  const rootRef = useRef<HTMLDivElement>(null);
  const getBiasRef = useRef(getBias);
  getBiasRef.current = getBias;

  const coordinateMatch = extractCoordinates(query);

  useEffect(() => {
    const q = query.trim();
    if (q.length < MIN_CHARS || extractCoordinates(q)) {
      setResults([]);
      setStatus("idle");
      return;
    }
    const controller = new AbortController();
    const timer = window.setTimeout(async () => {
      setStatus("loading");
      try {
        const found = await searchPlaces(q, { language, near: getBiasRef.current(), signal: controller.signal });
        setResults(found);
        setActive(found.length ? 0 : -1);
        setStatus("done");
      } catch (error) {
        if (!isAbortError(error)) setStatus("error");
      }
    }, DEBOUNCE_MS);
    return () => {
      window.clearTimeout(timer);
      controller.abort();
    };
  }, [query, language]);

  useEffect(() => {
    if (!open) return;
    const onPointerDown = (e: PointerEvent) => {
      if (!rootRef.current?.contains(e.target as Node)) setOpen(false);
    };
    document.addEventListener("pointerdown", onPointerDown);
    return () => document.removeEventListener("pointerdown", onPointerDown);
  }, [open]);

  const choose = (suggestion: PlaceSuggestion) => {
    onSelect(suggestion);
    setQuery(suggestion.name);
    setOpen(false);
  };

  const goToCoordinates = () => {
    if (!coordinateMatch) return;
    onCoordinates(coordinateMatch);
    setOpen(false);
  };

  const onKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === "Enter") {
      e.preventDefault();
      if (coordinateMatch) goToCoordinates();
      else if (results[active]) choose(results[active]);
      return;
    }
    if (e.key === "Escape") {
      setOpen(false);
      return;
    }
    if (!results.length) return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setOpen(true);
      setActive((i) => (i + 1) % results.length);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive((i) => (i - 1 + results.length) % results.length);
    }
  };

  const showPanel = open && query.trim().length >= MIN_CHARS;

  return (
    <div ref={rootRef} className={cn("relative", className)} onClick={(e) => e.stopPropagation()}>
      <div className="flex h-9 items-center gap-2 rounded-lg border border-gray-200 bg-white/95 px-2.5 shadow-md backdrop-blur-md focus-within:border-[#008081] focus-within:ring-2 focus-within:ring-[#008081]/20 dark:border-neutral-700 dark:bg-neutral-900/95">
        {status === "loading" ? (
          <Loader2 className="h-4 w-4 shrink-0 animate-spin text-[#008081]" />
        ) : (
          <Search className="h-4 w-4 shrink-0 text-gray-400" />
        )}
        <input
          type="text"
          value={query}
          onChange={(e) => {
            setQuery(e.target.value);
            setOpen(true);
          }}
          onFocus={() => setOpen(true)}
          onKeyDown={onKeyDown}
          placeholder={t("locations.mapPicker.searchPlaceholder")}
          aria-label={t("locations.mapPicker.searchPlaceholder")}
          role="combobox"
          aria-expanded={showPanel}
          aria-controls={listId}
          aria-autocomplete="list"
          className="min-w-0 flex-1 bg-transparent text-xs text-gray-900 outline-none placeholder:text-gray-400 dark:text-gray-100"
        />
        {query && (
          <button
            type="button"
            onClick={() => {
              setQuery("");
              setResults([]);
            }}
            aria-label={t("locations.mapPicker.clearSearch")}
            className="rounded p-0.5 text-gray-400 hover:text-gray-700 dark:hover:text-gray-200"
          >
            <X className="h-3.5 w-3.5" />
          </button>
        )}
      </div>

      {showPanel && (
        <div
          id={listId}
          role="listbox"
          className="absolute inset-x-0 top-full z-[1100] mt-1 max-h-72 overflow-y-auto rounded-lg border border-gray-200 bg-white py-1 shadow-xl dark:border-neutral-700 dark:bg-neutral-900"
        >
          {coordinateMatch ? (
            <button
              type="button"
              onClick={goToCoordinates}
              className="flex w-full items-center gap-2 px-3 py-2 text-start text-xs hover:bg-gray-50 dark:hover:bg-neutral-800"
            >
              <MapPin className="h-3.5 w-3.5 shrink-0 text-[#008081]" />
              <span className="font-mono text-gray-800 dark:text-gray-200">
                {coordinateMatch.lat.toFixed(6)}, {coordinateMatch.lng.toFixed(6)}
              </span>
            </button>
          ) : status === "error" ? (
            <p className="px-3 py-2 text-xs text-red-500">{t("locations.mapPicker.searchFailed")}</p>
          ) : status === "done" && results.length === 0 ? (
            <p className="px-3 py-2 text-xs text-gray-500 dark:text-gray-400">{t("locations.mapPicker.noResults")}</p>
          ) : (
            results.map((r, i) => (
              <button
                key={r.id}
                type="button"
                role="option"
                aria-selected={i === active}
                onMouseEnter={() => setActive(i)}
                onClick={() => choose(r)}
                className={cn(
                  "flex w-full items-start gap-2 px-3 py-2 text-start",
                  i === active ? "bg-teal-50 dark:bg-teal-950/40" : "hover:bg-gray-50 dark:hover:bg-neutral-800"
                )}
              >
                <MapPin className="mt-0.5 h-3.5 w-3.5 shrink-0 text-[#008081]" />
                <span className="min-w-0">
                  <span className="block truncate text-xs font-medium text-gray-900 dark:text-gray-100">{r.name}</span>
                  {r.subtitle && (
                    <span className="block truncate text-[11px] text-gray-500 dark:text-gray-400">{r.subtitle}</span>
                  )}
                </span>
              </button>
            ))
          )}
        </div>
      )}
    </div>
  );
}
