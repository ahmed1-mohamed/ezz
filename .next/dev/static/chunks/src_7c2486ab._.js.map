import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { useLanguage } from "@/contexts/LanguageContext";
import { useFormContext, Controller } from "react-hook-form";

interface LocationBasicInfoProps {
  cities: { label: string; value: string }[];
  areas: { label: string; value: string }[];
  loading: boolean;
}

export function LocationBasicInfo({
  cities,
  areas,
  loading,
}: LocationBasicInfoProps) {
  const { t } = useLanguage();
  const { register, control, formState: { errors } } = useFormContext();

  return (
    <div className="space-y-6">
      <div>
        <Label htmlFor="location-name">
          {t("locations.form.locationName")} <span className="text-red-500">*</span>
        </Label>
        <Input
          id="location-name"
          placeholder={t("locations.form.locationNamePlaceholder")}
          {...register("locationName")}
          className={`mt-1 ${errors.locationName ? "border-red-500 focus-visible:ring-red-500" : ""}`}
        />
        {errors.locationName && (
          <p className="text-xs text-red-500 mt-1">{errors.locationName.message as string}</p>
        )}
      </div>

      <div className="grid grid-cols-2 gap-4">
        <div>
          <Label htmlFor="city">{t("locations.form.city")} <span className="text-red-500">*</span></Label>
          <Controller
            name="cityId"
            control={control}
            render={({ field }) => (
              <Select onValueChange={field.onChange} value={field.value || ""}>
                <SelectTrigger className={`mt-1 ${errors.cityId ? "border-red-500 focus:ring-red-500" : ""}`}>
                  <SelectValue
                    placeholder={
                      loading ? t("locations.form.loadingCities") : t("locations.form.selectCity")
                    }
                  />
                </SelectTrigger>
                <SelectContent>
                  {cities.map((city) => (
                    <SelectItem key={city.value} value={city.value}>
                      {city.label}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            )}
          />
          {errors.cityId && (
            <p className="text-xs text-red-500 mt-1">{errors.cityId.message as string}</p>
          )}
        </div>
        <div>
          <Label htmlFor="area">{t("locations.form.area")} <span className="text-red-500">*</span></Label>
          <Controller
            name="areaId"
            control={control}
            render={({ field }) => (
              <Select onValueChange={field.onChange} value={field.value || ""}>
                <SelectTrigger className={`mt-1 ${errors.areaId ? "border-red-500 focus:ring-red-500" : ""}`}>
                  <SelectValue
                    placeholder={
                      loading ? t("locations.form.loadingAreas") : t("locations.form.selectArea")
                    }
                  />
                </SelectTrigger>
                <SelectContent>
                  {areas.map((area) => (
                    <SelectItem key={area.value} value={area.value}>
                      {area.label}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            )}
          />
          {errors.areaId && (
            <p className="text-xs text-red-500 mt-1">{errors.areaId.message as string}</p>
          )}
        </div>
      </div>
    </div>
  );
}