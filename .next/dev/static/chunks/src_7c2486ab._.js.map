import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { useLanguage } from "@/contexts/LanguageContext";
import { useFormContext } from "react-hook-form";

export function LocationCoordinates() {
  const { t } = useLanguage();
  const { register, formState: { errors } } = useFormContext();

  return (
    <div className="grid grid-cols-2 gap-4">
      <div>
        <Label htmlFor="latitude">{t("locations.form.latitude")}</Label>
        <Input
          id="latitude"
          placeholder={t("locations.form.latitudePlaceholder")}
          {...register("latitude")}
          className={`mt-1 ${errors.latitude ? "border-red-500 focus-visible:ring-red-500" : ""}`}
        />
        {errors.latitude && (
          <p className="text-xs text-red-500 mt-1">{errors.latitude.message as string}</p>
        )}
      </div>
      <div>
        <Label htmlFor="longitude">{t("locations.form.longitude")}</Label>
        <Input
          id="longitude"
          placeholder={t("locations.form.longitudePlaceholder")}
          {...register("longitude")}
          className={`mt-1 ${errors.longitude ? "border-red-500 focus-visible:ring-red-500" : ""}`}
        />
        {errors.longitude && (
          <p className="text-xs text-red-500 mt-1">{errors.longitude.message as string}</p>
        )}
      </div>
    </div>
  );
}
